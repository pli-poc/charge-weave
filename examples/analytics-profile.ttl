ex:analytics-metric-availability a cd:MetricDefinition ;
    cd:canonicalId "analytics-metric-availability"^^xsd:string ;
    cd:createdAt "2026-09-25T12:00:00+00:00"^^xsd:dateTime ;
    cd:expressionLanguage "ChargeWeave analytical profile v1"^^xsd:string ;
    cd:metricExpression "100 × sum(available point-seconds) / sum(eligible point-seconds). Includes planned downtime; never an average of site percentages."^^xsd:string ;
    cd:metricName "Availability"^^xsd:string ;
    cd:metricVersion "1"^^xsd:string ;
    cd:revision "1"^^xsd:positiveInteger ;
    cd:scopeClass cd:ChargingSite ;
    cd:tenant ex:Tenant ;
    cd:unitIri <http://qudt.org/vocab/unit/PERCENT> .

