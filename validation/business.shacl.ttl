@prefix cd: <https://example.org/charge-domain#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

cd:B001 a sh:NodeShape ;
    sh:sparql [ sh:message "B001: Tenant-owned object references must remain within the same tenant." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:tenant ?t; ?p ?other. ?p cd:sameTenant true. ?other cd:tenant ?u. FILTER(?t != ?u) }""" ] ;
    sh:targetClass cd:Record .

cd:B002 a sh:NodeShape ;
    sh:sparql [ sh:message "B002: Canonical IDs are unique across all records within a tenant." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:tenant ?t; cd:canonicalId ?id. ?other cd:tenant ?t; cd:canonicalId ?id. FILTER(?other != $this) }""" ] ;
    sh:targetClass cd:Record .

cd:B003 a sh:NodeShape ;
    sh:sparql [ sh:message "B003: Record cannot instantiate explicitly disjoint domain classes." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this a ?a, ?b. ?set owl:members ?members; a owl:AllDisjointClasses. ?members rdf:rest*/rdf:first ?a, ?b. FILTER(?a != ?b) }""" ] ;
    sh:targetClass cd:Record .

cd:B004 a sh:NodeShape ;
    sh:sparql [ sh:message "B004: Unknown predicates in the controlled namespace are rejected." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this ?p ?v. FILTER(STRSTARTS(STR(?p),"https://example.org/charge-domain#")) FILTER NOT EXISTS {?p a owl:ObjectProperty} FILTER NOT EXISTS {?p a owl:DatatypeProperty} }""" ] ;
    sh:targetClass cd:Record .

cd:B005 a sh:NodeShape ;
    sh:sparql [ sh:message "B005: Extension value datatype must match its declared definition." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:valueDatatype ?a; cd:fieldDefinition/cd:fieldDatatype ?b. FILTER(?a != ?b) }""" ] ;
    sh:targetClass cd:CustomFieldValue .

cd:B006 a sh:NodeShape ;
    sh:sparql [ sh:message "B006: Operator service hierarchy must be acyclic." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:parentService+ $this. }""" ] ;
    sh:targetClass cd:OperatorService .

cd:B007 a sh:NodeShape ;
    sh:sparql [ sh:message "B007: Gateway station chains must be acyclic." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:gatewayStation+ $this. }""" ] ;
    sh:targetClass cd:ChargingStation .

cd:B008 a sh:NodeShape ;
    sh:sparql [ sh:message "B008: Direct communication requires a protocol endpoint." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:communicationMode cd:communicationMode_Direct. FILTER NOT EXISTS {$this cd:protocolEndpoint ?e} }""" ] ;
    sh:targetClass cd:ChargingStation .

cd:B009 a sh:NodeShape ;
    sh:sparql [ sh:message "B009: Gateway communication requires a gateway station." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:communicationMode cd:communicationMode_Gateway. FILTER NOT EXISTS {$this cd:gatewayStation ?e} }""" ] ;
    sh:targetClass cd:ChargingStation .

cd:B010 a sh:NodeShape ;
    sh:sparql [ sh:message "B010: Commercial stations require a physical site." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:stationUse ?s. FILTER(?s IN (cd:stationUse_Public,cd:stationUse_Private)) FILTER NOT EXISTS {$this cd:site ?e} }""" ] ;
    sh:targetClass cd:ChargingStation .

cd:B011 a sh:NodeShape ;
    sh:sparql [ sh:message "B011: Personal stations require an owner account." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:stationUse cd:stationUse_Personal. FILTER NOT EXISTS {$this cd:ownerAccount ?o} }""" ] ;
    sh:targetClass cd:ChargingStation .

cd:B012 a sh:NodeShape ;
    sh:sparql [ sh:message "B012: Charging area and station site must agree." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:site ?a; cd:area/cd:site ?b. FILTER(?a != ?b) }""" ] ;
    sh:targetClass cd:ChargingStation .

cd:B013 a sh:NodeShape ;
    sh:sparql [ sh:message "B013: Parking area and bay site must agree." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:site ?a; cd:area/cd:site ?b. FILTER(?a != ?b) }""" ] ;
    sh:targetClass cd:ParkingSpace .

cd:B014 a sh:NodeShape ;
    sh:sparql [ sh:message "B014: A payment terminal must serve exactly one station or area." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { {FILTER NOT EXISTS {$this cd:station ?s} FILTER NOT EXISTS {$this cd:area ?a}} UNION {$this cd:station ?s; cd:area ?a} }""" ] ;
    sh:targetClass cd:PaymentTerminal .

cd:B015 a sh:NodeShape ;
    sh:sparql [ sh:message "B015: Physical circuit hierarchy must be acyclic." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:parentCircuit+ $this. }""" ] ;
    sh:targetClass cd:ElectricalCircuit .

cd:B016 a sh:NodeShape ;
    sh:sparql [ sh:message "B016: Virtual control hierarchy must be acyclic." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:parentControlGroup+ $this. }""" ] ;
    sh:targetClass cd:LoadControlGroup .

cd:B017 a sh:NodeShape ;
    sh:sparql [ sh:message "B017: Nested physical circuits must remain on the same site." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:site ?a; cd:parentCircuit/cd:site ?b. FILTER(?a != ?b) }""" ] ;
    sh:targetClass cd:ElectricalCircuit .

cd:B018 a sh:NodeShape ;
    sh:sparql [ sh:message "B018: Nested control groups must remain on the same site." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:site ?a; cd:parentControlGroup/cd:site ?b. FILTER(?a != ?b) }""" ] ;
    sh:targetClass cd:LoadControlGroup .

cd:B019 a sh:NodeShape ;
    sh:sparql [ sh:message "B019: Minimum current cannot exceed maximum current." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:minimumCurrentA ?a; cd:maximumCurrentA ?b. FILTER(?a > ?b) }""" ] ;
    sh:targetClass cd:ChargingUnit .

cd:B020 a sh:NodeShape ;
    sh:sparql [ sh:message "B020: Unknown payment availability cannot assert payment-option values." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:paymentOptionsKnowledge cd:paymentOptionsKnowledge_Unknown; cd:paymentOptionCode ?o. }""" ] ;
    sh:targetClass cd:PublicListing .

cd:B021 a sh:NodeShape ;
    sh:sparql [ sh:message "B021: Non-free authorization requires a credential or customer reference." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:authorizationMethod ?m. FILTER(?m != cd:authorizationMethod_LocalFree) FILTER NOT EXISTS {$this cd:credential ?c} FILTER NOT EXISTS {$this cd:customer ?u} }""" ] ;
    sh:targetClass cd:AuthorizationRequest .

cd:B022 a sh:NodeShape ;
    sh:sparql [ sh:message "B022: Authorization decision cannot predate its request." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:decidedAt ?d; cd:authorizationRequest/cd:requestedAt ?r. FILTER(?d < ?r) }""" ] ;
    sh:targetClass cd:AuthorizationDecision .

cd:B023 a sh:NodeShape ;
    sh:sparql [ sh:message "B023: Completed sessions require end time and end evidence." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:sessionState cd:sessionState_Completed. FILTER(!EXISTS {$this cd:endedAt ?e} || !EXISTS {$this cd:endEvidence ?f}) }""" ] ;
    sh:targetClass cd:ChargingSession .

cd:B024 a sh:NodeShape ;
    sh:sparql [ sh:message "B024: Session end cannot precede session start." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:startedAt ?a; cd:endedAt ?b. FILTER(?b < ?a) }""" ] ;
    sh:targetClass cd:ChargingSession .

cd:B025 a sh:NodeShape ;
    sh:sparql [ sh:message "B025: Finalization evidence must describe the same session." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:endEvidence/cd:session ?s. FILTER(?s != $this) }""" ] ;
    sh:targetClass cd:ChargingSession .

cd:B026 a sh:NodeShape ;
    sh:sparql [ sh:message "B026: Active charging requires accepted authorization." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:sessionState ?s; cd:authorizationDecision/cd:decision ?d. FILTER(?s IN (cd:sessionState_Active,cd:sessionState_Suspended,cd:sessionState_Completed) && ?d != cd:decision_Accepted) }""" ] ;
    sh:targetClass cd:ChargingSession .

cd:B027 a sh:NodeShape ;
    sh:sparql [ sh:message "B027: Selected tariff must be effective at session start." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:startedAt ?s; cd:selectedTariff ?t. ?t cd:validFrom ?a. OPTIONAL {?t cd:validUntil ?b} FILTER(?s < ?a || (BOUND(?b) && ?s >= ?b)) }""" ] ;
    sh:targetClass cd:ChargingSession .

cd:B028 a sh:NodeShape ;
    sh:sparql [ sh:message "B028: Authorization target must match the charged unit." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:chargingUnit ?a; cd:authorizationDecision/cd:authorizationRequest/cd:chargingUnit ?b. FILTER(?a != ?b) }""" ] ;
    sh:targetClass cd:ChargingSession .

cd:B029 a sh:NodeShape ;
    sh:sparql [ sh:message "B029: A source timestamp ahead of receipt time requires a documented clock assessment." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:occurredAt ?a; cd:receivedAt ?b. FILTER(?b < ?a) FILTER NOT EXISTS {$this cd:clockAssessment ?c} }""" ] ;
    sh:targetClass cd:SourceEvent .

cd:B030 a sh:NodeShape ;
    sh:sparql [ sh:message "B030: A verified signature must have a verification timestamp." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:signatureVerification cd:signatureVerification_Valid. FILTER NOT EXISTS {$this cd:verifiedAt ?d} }""" ] ;
    sh:targetClass cd:SignedMeterEvidence .

cd:B031 a sh:NodeShape ;
    sh:sparql [ sh:message "B031: Local CDRs require a completed canonical session." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:recordOrigin cd:recordOrigin_Local. FILTER NOT EXISTS {$this cd:session/cd:sessionState cd:sessionState_Completed} }""" ] ;
    sh:targetClass cd:ChargeDetailRecord .

cd:B032 a sh:NodeShape ;
    sh:sparql [ sh:message "B032: Original local CDR import and export energy must agree with the canonical session." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:recordOrigin cd:recordOrigin_Local; cd:session ?s; cd:importedEnergyKWh ?a; cd:exportedEnergyKWh ?b. FILTER NOT EXISTS {$this cd:correctionOf ?old} ?s cd:importedEnergyKWh ?c; cd:exportedEnergyKWh ?d. FILTER(?a != ?c || ?b != ?d) }""" ] ;
    sh:targetClass cd:ChargeDetailRecord .

cd:B033 a sh:NodeShape ;
    sh:sparql [ sh:message "B033: CDR correction lineage must be acyclic." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:correctionOf+ $this. }""" ] ;
    sh:targetClass cd:ChargeDetailRecord .

cd:B034 a sh:NodeShape ;
    sh:sparql [ sh:message "B034: Priced tariffs require at least one price component." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:tariffMode cd:tariffMode_Priced. FILTER NOT EXISTS {$this cd:priceComponent ?p} }""" ] ;
    sh:targetClass cd:TariffVersion .

cd:B035 a sh:NodeShape ;
    sh:sparql [ sh:message "B035: Discount tariffs require an explicit base or a declared deferred base-selection policy." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:tariffMode cd:tariffMode_DiscountBased. FILTER NOT EXISTS {$this cd:baseTariffVersion ?b} FILTER NOT EXISTS {$this cd:baseTariffSelection ?mode. FILTER(?mode IN (cd:baseTariffSelection_SetBase,cd:baseTariffSelection_RoamingWholesale))} }""" ] ;
    sh:targetClass cd:TariffVersion .

cd:B036 a sh:NodeShape ;
    sh:sparql [ sh:message "B036: Dynamic tariffs require a formula." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:tariffMode cd:tariffMode_Dynamic. FILTER NOT EXISTS {$this cd:dynamicPriceFormula ?f} }""" ] ;
    sh:targetClass cd:TariffVersion .

cd:B037 a sh:NodeShape ;
    sh:sparql [ sh:message "B037: Tariff derivation must be acyclic." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:baseTariffVersion+ $this. }""" ] ;
    sh:targetClass cd:TariffVersion .

cd:B038 a sh:NodeShape ;
    sh:sparql [ sh:message "B038: Tariff assignment priorities within a set must be unique." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:tariffAssignment ?a,?b. ?a cd:priority ?p. ?b cd:priority ?p. FILTER(?a != ?b) }""" ] ;
    sh:targetClass cd:TariffSet .

cd:B039 a sh:NodeShape ;
    sh:sparql [ sh:message "B039: Price intervals require exactly one explicit or recurring window." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { {FILTER NOT EXISTS {$this cd:interval ?a} FILTER NOT EXISTS {$this cd:recurringWindow ?b}} UNION {$this cd:interval ?a; cd:recurringWindow ?b} }""" ] ;
    sh:targetClass cd:ElectricityPriceInterval .

cd:B040 a sh:NodeShape ;
    sh:sparql [ sh:message "B040: Generation fractions must sum to one within decimal tolerance." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { {SELECT $this (SUM(?x) AS ?sum) WHERE {$this cd:sourceShare/cd:shareFraction ?x} GROUP BY $this} FILTER(ABS(?sum - 1) > 0.000001) }""" ] ;
    sh:targetClass cd:EnergyMix .

cd:B041 a sh:NodeShape ;
    sh:sparql [ sh:message "B041: Dynamic price lower bound cannot exceed upper bound." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:minimumUnitPrice ?a; cd:maximumUnitPrice ?b. FILTER(?a > ?b) }""" ] ;
    sh:targetClass cd:DynamicPriceFormula .

cd:B042 a sh:NodeShape ;
    sh:sparql [ sh:message "B042: Stored gross amount must equal rounded net plus rounded tax." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:netAmount ?n; cd:taxAmount ?t; cd:grossAmount ?g. FILTER(?g != ?n + ?t) }""" ] ;
    sh:targetClass cd:Record .

cd:B043 a sh:NodeShape ;
    sh:sparql [ sh:message "B043: Invoice totals must agree with the sum of its lines." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:netAmount ?net; cd:taxAmount ?tax; cd:grossAmount ?gross. {SELECT $this (SUM(?n) AS ?ns) (SUM(?t) AS ?ts) (SUM(?g) AS ?gs) WHERE {$this cd:invoiceLine ?l. ?l cd:netAmount ?n; cd:taxAmount ?t; cd:grossAmount ?g} GROUP BY $this} FILTER(?net != ?ns || ?tax != ?ts || ?gross != ?gs) }""" ] ;
    sh:targetClass cd:Invoice .

cd:B044 a sh:NodeShape ;
    sh:sparql [ sh:message "B044: Invoice line currencies must match the document." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:currency ?a; cd:invoiceLine/cd:currency ?b. FILTER(?a != ?b) }""" ] ;
    sh:targetClass cd:Invoice .

cd:B045 a sh:NodeShape ;
    sh:sparql [ sh:message "B045: Authorization currency must match its payment intent." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:currency ?a; cd:paymentIntent/cd:currency ?b. FILTER(?a != ?b) }""" ] ;
    sh:targetClass cd:PaymentAuthorization .

cd:B046 a sh:NodeShape ;
    sh:sparql [ sh:message "B046: Capture currency must match its payment intent." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:currency ?a; cd:paymentIntent/cd:currency ?b. FILTER(?a != ?b) }""" ] ;
    sh:targetClass cd:PaymentCapture .

cd:B047 a sh:NodeShape ;
    sh:sparql [ sh:message "B047: Refund currency must match the original capture." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:currency ?a; cd:paymentCapture/cd:currency ?b. FILTER(?a != ?b) }""" ] ;
    sh:targetClass cd:Refund .

cd:B048 a sh:NodeShape ;
    sh:sparql [ sh:message "B048: Confirmed refunds may not exceed the confirmed capture amount." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:capturedAmount ?cap. {SELECT $this (SUM(?amount) AS ?total) WHERE {?r cd:paymentCapture $this; a cd:Refund; cd:refundState cd:refundState_Confirmed; cd:refundAmount ?amount} GROUP BY $this} FILTER(?total > ?cap) }""" ] ;
    sh:targetClass cd:PaymentCapture .

cd:B049 a sh:NodeShape ;
    sh:sparql [ sh:message "B049: Confirmed captures may not exceed requested payment amount." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:requestedAmount ?limit. {SELECT $this (SUM(?amount) AS ?total) WHERE {?c cd:paymentIntent $this; a cd:PaymentCapture; cd:captureState cd:captureState_Confirmed; cd:capturedAmount ?amount} GROUP BY $this} FILTER(?total > ?limit) }""" ] ;
    sh:targetClass cd:PaymentIntent .

cd:B050 a sh:NodeShape ;
    sh:sparql [ sh:message "B050: Posted journal must balance independently per currency." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:journalState cd:journalState_Posted. {SELECT $this ?currency (SUM(?amount) AS ?total) WHERE {$this cd:journalLine ?l. ?l cd:signedAmount ?amount; cd:currency ?currency} GROUP BY $this ?currency} FILTER(?total != 0) }""" ] ;
    sh:targetClass cd:Journal .

cd:B051 a sh:NodeShape ;
    sh:sparql [ sh:message "B051: Journal line currency must match its ledger account." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:currency ?a; cd:ledgerAccount/cd:currency ?b. FILTER(?a != ?b) }""" ] ;
    sh:targetClass cd:JournalLine .

cd:B052 a sh:NodeShape ;
    sh:sparql [ sh:message "B052: Sponsor plus driver allocation must equal the total charge." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:totalAmount ?a; cd:sponsorAmount ?s; cd:driverAmount ?d. FILTER(?a != ?s + ?d) }""" ] ;
    sh:targetClass cd:CorporateCostAllocation .

cd:B053 a sh:NodeShape ;
    sh:sparql [ sh:message "B053: Policy-sourced reimbursement requires an explicit electricity schedule." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:reimbursementRateSource cd:reimbursementRateSource_Policy. FILTER NOT EXISTS {$this cd:electricitySchedule ?s} }""" ] ;
    sh:targetClass cd:ReimbursementPolicy .

cd:B054 a sh:NodeShape ;
    sh:sparql [ sh:message "B054: Station-sourced reimbursement must not embed a competing policy schedule." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:reimbursementRateSource cd:reimbursementRateSource_Station; cd:electricitySchedule ?s. }""" ] ;
    sh:targetClass cd:ReimbursementPolicy .

cd:B055 a sh:NodeShape ;
    sh:sparql [ sh:message "B055: A contract-scoped reimbursement policy must identify its partner." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:serviceAgreement ?a. FILTER NOT EXISTS {$this cd:partner ?p} }""" ] ;
    sh:targetClass cd:ReimbursementPolicy .

cd:B056 a sh:NodeShape ;
    sh:sparql [ sh:message "B056: Reimbursement evidence must be for a personal station." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:session/cd:chargingUnit/cd:station/cd:stationUse ?k. FILTER(?k != cd:stationUse_Personal) }""" ] ;
    sh:targetClass cd:ReimbursementRecord .

cd:B057 a sh:NodeShape ;
    sh:sparql [ sh:message "B057: Station-derived reimbursement requires the station electricity schedule." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:reimbursementPolicy/cd:reimbursementRateSource cd:reimbursementRateSource_Station. FILTER NOT EXISTS {$this cd:session/cd:chargingUnit/cd:station/cd:electricitySchedule ?s} }""" ] ;
    sh:targetClass cd:ReimbursementRecord .

cd:B058 a sh:NodeShape ;
    sh:sparql [ sh:message "B058: Relative coupon validity requires a duration; fixed validity requires both dates." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { {$this cd:validityMode cd:validityMode_DaysAfterRedemption. FILTER NOT EXISTS {$this cd:validityDays ?d}} UNION {$this cd:validityMode cd:validityMode_FixedWindow. FILTER(!EXISTS {$this cd:validFrom ?a} || !EXISTS {$this cd:validUntil ?b})} }""" ] ;
    sh:targetClass cd:EnergyCouponTemplate .

cd:B059 a sh:NodeShape ;
    sh:sparql [ sh:message "B059: Coupon consumption must not exceed its energy allowance; reversal records subtract." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:energyAllowanceKWh ?limit. {SELECT $this (SUM(?signed) AS ?total) WHERE {?c cd:energyCoupon $this; a cd:CouponConsumption; cd:consumedEnergyKWh ?e. BIND(IF(EXISTS {?c cd:reversalOf ?r},-?e,?e) AS ?signed)} GROUP BY $this} FILTER(?total > ?limit || ?total < 0) }""" ] ;
    sh:targetClass cd:EnergyCoupon .

cd:B060 a sh:NodeShape ;
    sh:sparql [ sh:message "B060: Coupon use must occur within its validity interval." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:consumedAt ?t; cd:energyCoupon ?c. ?c cd:validFrom ?a; cd:validUntil ?b. FILTER(?t < ?a || ?t >= ?b) }""" ] ;
    sh:targetClass cd:CouponConsumption .

cd:B061 a sh:NodeShape ;
    sh:sparql [ sh:message "B061: Reversal must reference a consumption of the same coupon." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:energyCoupon ?a; cd:reversalOf/cd:energyCoupon ?b. FILTER(?a != ?b) }""" ] ;
    sh:targetClass cd:CouponConsumption .

cd:B062 a sh:NodeShape ;
    sh:sparql [ sh:message "B062: Schedule periods must lie within schedule validity." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:validFrom ?a; cd:validUntil ?b; cd:schedulePeriod ?p. ?p cd:periodStart ?s; cd:periodEnd ?e. FILTER(?s < ?a || ?e > ?b) }""" ] ;
    sh:targetClass cd:ChargingSchedule .

cd:B063 a sh:NodeShape ;
    sh:sparql [ sh:message "B063: Schedule periods in one schedule must not overlap." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:schedulePeriod ?a,?b. ?a cd:periodStart ?s1; cd:periodEnd ?e1. ?b cd:periodStart ?s2; cd:periodEnd ?e2. FILTER(?a != ?b && ?s1 < ?e2 && ?s2 < ?e1) }""" ] ;
    sh:targetClass cd:ChargingSchedule .

cd:B064 a sh:NodeShape ;
    sh:sparql [ sh:message "B064: Forecast bounds must contain the predicted value." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:predictedValue ?v. OPTIONAL {$this cd:lowerBound ?a} OPTIONAL {$this cd:upperBound ?b} FILTER((BOUND(?a) && ?v < ?a) || (BOUND(?b) && ?v > ?b)) }""" ] ;
    sh:targetClass cd:ForecastPoint .

cd:B065 a sh:NodeShape ;
    sh:sparql [ sh:message "B065: Availability seconds must be positive and bounded." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:eligibleSeconds ?a; cd:unavailableSeconds ?b. FILTER(?a <= 0 || ?b > ?a) }""" ] ;
    sh:targetClass cd:AvailabilityResult .

cd:B066 a sh:NodeShape ;
    sh:sparql [ sh:message "B066: Availability fraction must agree with eligible and unavailable seconds." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:eligibleSeconds ?a; cd:unavailableSeconds ?b; cd:availabilityFraction ?f. FILTER(?a > 0 && ABS(?f-(1-?b/?a)) > 0.000001) }""" ] ;
    sh:targetClass cd:AvailabilityResult .

cd:B067 a sh:NodeShape ;
    sh:sparql [ sh:message "B067: Completed work orders require timestamp and completion evidence." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:workState cd:workState_Completed. FILTER(!EXISTS {$this cd:completedAt ?t} || !EXISTS {$this cd:completionEvidence ?e}) }""" ] ;
    sh:targetClass cd:WorkOrder .

cd:B068 a sh:NodeShape ;
    sh:sparql [ sh:message "B068: Completed installations require commissioning evidence." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:jobState cd:jobState_Completed. FILTER(!EXISTS {$this cd:completedAt ?t} || !EXISTS {$this cd:commissioningEvidence ?e}) }""" ] ;
    sh:targetClass cd:InstallationJob .

cd:B069 a sh:NodeShape ;
    sh:sparql [ sh:message "B069: Accepted fiscalization requires an authority reference and fiscal evidence." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:fiscalizationState cd:fiscalizationState_Accepted. FILTER(!EXISTS {$this cd:authorityReference ?r} || !EXISTS {$this cd:fiscalDocument ?e}) }""" ] ;
    sh:targetClass cd:FiscalizationAttempt .

cd:B070 a sh:NodeShape ;
    sh:sparql [ sh:message "B070: The default language must be one of the supported languages." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:defaultLanguage ?l. FILTER NOT EXISTS {$this cd:supportedLanguage ?l} }""" ] ;
    sh:targetClass cd:BrandProfile .

cd:B071 a sh:NodeShape ;
    sh:sparql [ sh:message "B071: Approved assistant actions must reference the exact proposed command." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:approvalDecision cd:approvalDecision_Approved; cd:recommendation ?r. FILTER NOT EXISTS {$this cd:approvedCommand ?c. ?r cd:proposedCommand ?c} }""" ] ;
    sh:targetClass cd:ActionApproval .

cd:B072 a sh:NodeShape ;
    sh:sparql [ sh:message "B072: Delivered events must not retain a retry timestamp." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:deliveryState cd:deliveryState_Delivered; cd:nextRetryAt ?r. }""" ] ;
    sh:targetClass cd:EventDelivery .

cd:B073 a sh:NodeShape ;
    sh:sparql [ sh:message "B073: Successful command state requires successful completion evidence, not acknowledgement alone." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:commandState cd:commandState_Succeeded. FILTER NOT EXISTS {?o a cd:CommandOutcome; cd:command $this; cd:outcomeKind cd:outcomeKind_Completion; cd:outcomeState cd:outcomeState_Succeeded} }""" ] ;
    sh:targetClass cd:RemoteCommand .

cd:B074 a sh:NodeShape ;
    sh:sparql [ sh:message "B074: Lifecycle transition must be permitted for the stated property and prior/next codes." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:stateProperty ?p; cd:previousState ?a; cd:nextState ?b. FILTER NOT EXISTS {?rule cd:transitionProperty ?p; cd:fromState ?a; cd:toState ?b} }""" ] ;
    sh:targetClass cd:StateTransition .

cd:B075 a sh:NodeShape ;
    sh:sparql [ sh:message "B075: Optional effective timestamps must define a positive half-open interval." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:validFrom ?a; cd:validUntil ?b. FILTER(?b <= ?a) }""" ] ;
    sh:targetClass cd:Record .

cd:B076 a sh:NodeShape ;
    sh:sparql [ sh:message "B076: Half-open interval must have positive duration." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:startsAt ?a; cd:endsAt ?b. FILTER(?b <= ?a) }""" ] ;
    sh:targetClass cd:TimeWindow .

cd:B077 a sh:NodeShape ;
    sh:sparql [ sh:message "B077: Schedule interval must have positive duration." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:periodStart ?a; cd:periodEnd ?b. FILTER(?b <= ?a) }""" ] ;
    sh:targetClass cd:SchedulePeriod .

cd:B078 a sh:NodeShape ;
    sh:sparql [ sh:message "B078: Command expiry must be after request time." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:requestedAt ?a; cd:expiresAt ?b. FILTER(?b <= ?a) }""" ] ;
    sh:targetClass cd:RemoteCommand .

cd:B079 a sh:NodeShape ;
    sh:sparql [ sh:message "B079: Inclusive reimbursement end date cannot precede the start date." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:validFromDate ?a; cd:validUntilDate ?b. FILTER(?b < ?a) }""" ] ;
    sh:targetClass cd:ReimbursementPolicy .

cd:B080 a sh:NodeShape ;
    sh:sparql [ sh:message "B080: Due date cannot precede invoice issuance." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:issuedAt ?a; cd:dueAt ?b. FILTER(?b < ?a) }""" ] ;
    sh:targetClass cd:Invoice .

cd:B081 a sh:NodeShape ;
    sh:sparql [ sh:message "B081: Reservation expiry must be after reservation time." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:reservedAt ?a; cd:expiresAt ?b. FILTER(?b <= ?a) }""" ] ;
    sh:targetClass cd:Reservation .

cd:B082 a sh:NodeShape ;
    sh:sparql [ sh:message "B082: Local time ordering must agree with the overnight flag." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:localStart ?a; cd:localEnd ?b; cd:spansMidnight ?s. FILTER((! ?s && ?b <= ?a) || (?s && ?b > ?a)) }""" ] ;
    sh:targetClass cd:RecurringWindow .

cd:B083 a sh:NodeShape ;
    sh:sparql [ sh:message "B083: Authorization expiry must be after authorization time." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:authorizedAt ?a; cd:expiresAt ?b. FILTER(?b <= ?a) }""" ] ;
    sh:targetClass cd:PaymentAuthorization .

cd:B084 a sh:NodeShape ;
    sh:sparql [ sh:message "B084: When a CDR has a tariff snapshot their currencies must agree." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:currency ?a; cd:selectedTariff/cd:currency ?b. FILTER(?a != ?b) }""" ] ;
    sh:targetClass cd:ChargeDetailRecord .

cd:B085 a sh:NodeShape ;
    sh:sparql [ sh:message "B085: Settlement items must have the batch currency and agreement." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:currency ?a; cd:serviceAgreement ?b; cd:settlementItem ?i. ?i cd:currency ?c; cd:serviceAgreement ?d. FILTER(?a != ?c || ?b != ?d) }""" ] ;
    sh:targetClass cd:SettlementBatch .

cd:B086 a sh:NodeShape ;
    sh:sparql [ sh:message "B086: Snapshot policy version must identify the referenced immutable policy version." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:policyVersion ?a; cd:corporateBillingPolicy/cd:policyVersion ?b. FILTER(?a != ?b) }""" ] ;
    sh:targetClass cd:CorporateBillingSnapshot .

cd:B087 a sh:NodeShape ;
    sh:sparql [ sh:message "B087: Voucher and wallet currencies must agree." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:voucher/cd:currency ?a; cd:wallet/cd:currency ?b. FILTER(?a != ?b) }""" ] ;
    sh:targetClass cd:VoucherRedemption .

cd:B088 a sh:NodeShape ;
    sh:sparql [ sh:message "B088: Firmware must list the station model as compatible." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:firmware ?f; cd:station/cd:equipmentModel ?m. FILTER NOT EXISTS {?f cd:compatibleModel ?m} }""" ] ;
    sh:targetClass cd:FirmwareDeployment .

cd:B089 a sh:NodeShape ;
    sh:sparql [ sh:message "B089: Station using personal reimbursement must be classified personal." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:reimbursementPolicy ?p; cd:stationUse ?s. FILTER(?s != cd:stationUse_Personal) }""" ] ;
    sh:targetClass cd:ChargingStation .

cd:B090 a sh:NodeShape ;
    sh:sparql [ sh:message "B090: Corporate pricing limits cannot be negative." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this ?p ?v. FILTER(?p IN (cd:costCapPerKWh,cd:maximumEnergyUnitPrice,cd:maximumIdleUnitPrice,cd:maximumFlatFee)) FILTER(?v < 0) }""" ] ;
    sh:targetClass cd:CorporateChargerRule .

cd:B091 a sh:NodeShape ;
    sh:sparql [ sh:message "B091: Percentage discounts are bounded between zero and one hundred." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:discountBasis cd:discountBasis_Percentage; cd:discountMagnitude ?v. FILTER(?v < 0 || ?v > 100) }""" ] ;
    sh:targetClass cd:DiscountRule .

cd:B092 a sh:NodeShape ;
    sh:sparql [ sh:message "B092: Component fee floor cannot exceed its ceiling." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:minimumCharge ?a; cd:maximumCharge ?b. FILTER(?a > ?b) }""" ] ;
    sh:targetClass cd:FeeBounds .

cd:B093 a sh:NodeShape ;
    sh:sparql [ sh:message "B093: Tier upper bound must exceed its inclusive lower bound." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:tierLowerBound ?a; cd:tierUpperBound ?b. FILTER(?b <= ?a) }""" ] ;
    sh:targetClass cd:PriceTier .

cd:B094 a sh:NodeShape ;
    sh:sparql [ sh:message "B094: Session charge floor cannot exceed its ceiling." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:minimumSessionCharge ?a; cd:maximumSessionCharge ?b. FILTER(?a > ?b) }""" ] ;
    sh:targetClass cd:SessionPricingPolicy .

cd:B095 a sh:NodeShape ;
    sh:sparql [ sh:message "B095: Confirmed payouts require confirmation time." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:payoutState cd:payoutState_Confirmed. FILTER NOT EXISTS {$this cd:confirmedAt ?t} }""" ] ;
    sh:targetClass cd:Payout .

cd:B096 a sh:NodeShape ;
    sh:sparql [ sh:message "B096: Payout batch currency and total must agree with included payouts." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { {$this cd:currency ?a; cd:payout/cd:currency ?b. FILTER(?a != ?b)} UNION {$this cd:batchTotal ?t. {SELECT $this (SUM(?v) AS ?s) WHERE {$this cd:payout/cd:payoutAmount ?v} GROUP BY $this} FILTER(?t != ?s)} }""" ] ;
    sh:targetClass cd:PayoutBatch .

cd:B097 a sh:NodeShape ;
    sh:sparql [ sh:message "B097: DC cabinet capacity must be positive and at least one module." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:totalCabinetPowerKW ?t; cd:moduleSizeKW ?m. FILTER(?m <= 0 || ?t < ?m) }""" ] ;
    sh:targetClass cd:PowerCabinet .

cd:B098 a sh:NodeShape ;
    sh:sparql [ sh:message "B098: Allocated power must agree with module count and not exceed cabinet capacity." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:allocatedModules ?n; cd:allocatedPowerKW ?p; cd:powerCabinet ?c. ?c cd:moduleSizeKW ?m; cd:totalCabinetPowerKW ?total. FILTER(?p != ?n * ?m || ?p > ?total) }""" ] ;
    sh:targetClass cd:PowerModuleAllocation .

cd:B099 a sh:NodeShape ;
    sh:sparql [ sh:message "B099: Recurring profiles require recurrence kind; transaction-specific profiles require a transaction." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { {$this cd:profileKind cd:profileKind_Recurring. FILTER NOT EXISTS {$this cd:recurrenceKind ?r}} UNION {$this cd:profilePurpose cd:profilePurpose_TransactionSpecific. FILTER NOT EXISTS {$this cd:protocolTransaction ?t}} }""" ] ;
    sh:targetClass cd:ChargingProfile .

cd:B100 a sh:NodeShape ;
    sh:sparql [ sh:message "B100: Access-token expiration must follow issuance." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:issuedAt ?a; cd:expiresAt ?b. FILTER(?b <= ?a) }""" ] ;
    sh:targetClass cd:AccessTokenLease .

cd:B101 a sh:NodeShape ;
    sh:sparql [ sh:message "B101: Revoked access tokens require a revocation timestamp." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:accessTokenState cd:accessTokenState_Revoked. FILTER NOT EXISTS {$this cd:revokedAt ?r} }""" ] ;
    sh:targetClass cd:AccessTokenLease .

cd:B102 a sh:NodeShape ;
    sh:sparql [ sh:message "B102: Pricing component tiers must not overlap." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:priceTier ?a,?b. ?a cd:tierLowerBound ?al. ?b cd:tierLowerBound ?bl. OPTIONAL {?a cd:tierUpperBound ?au} OPTIONAL {?b cd:tierUpperBound ?bu} FILTER(?a != ?b && (!BOUND(?au) || ?bl < ?au) && (!BOUND(?bu) || ?al < ?bu)) }""" ] ;
    sh:targetClass cd:PriceComponent .

cd:B103 a sh:NodeShape ;
    sh:sparql [ sh:message "B103: Hold amounts must be nonnegative." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this ?p ?v. FILTER(?p IN (cd:initialHoldAmount,cd:incrementalHoldAmount)) FILTER(?v < 0) }""" ] ;
    sh:targetClass cd:PreauthorizationPolicy .

cd:B104 a sh:NodeShape ;
    sh:sparql [ sh:message "B104: Allocation snapshot must refer to the allocated session." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:session ?a; cd:corporateSnapshot/cd:session ?b. FILTER(?a != ?b) }""" ] ;
    sh:targetClass cd:CorporateCostAllocation .

cd:B105 a sh:NodeShape ;
    sh:sparql [ sh:message "B105: Coupon reversal must not reverse a reversal or exceed its original amount." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:reversalOf ?r; cd:consumedEnergyKWh ?v. ?r cd:consumedEnergyKWh ?old. FILTER(EXISTS {?r cd:reversalOf ?r2} || ?v > ?old) }""" ] ;
    sh:targetClass cd:CouponConsumption .

cd:B106 a sh:NodeShape ;
    sh:sparql [ sh:message "B106: Confirmed captures require a provider confirmation reference." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:captureState cd:captureState_Confirmed. FILTER NOT EXISTS {$this cd:providerReference ?r} }""" ] ;
    sh:targetClass cd:PaymentCapture .

cd:B107 a sh:NodeShape ;
    sh:sparql [ sh:message "B107: A discount-based tariff requires explicit discount rules." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:tariffMode cd:tariffMode_DiscountBased. FILTER NOT EXISTS {$this cd:discountRule ?d} }""" ] ;
    sh:targetClass cd:TariffVersion .

cd:B108 a sh:NodeShape ;
    sh:sparql [ sh:message "B108: Allocated charging unit must be served by the cabinet." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:chargingUnit ?u; cd:powerCabinet ?c. FILTER NOT EXISTS {?c cd:servedUnit ?u} }""" ] ;
    sh:targetClass cd:PowerModuleAllocation .

cd:B109 a sh:NodeShape ;
    sh:sparql [ sh:message "B109: Rating a deferred-base discount requires the resolved immutable base tariff." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:selectedTariff/cd:baseTariffSelection ?mode. FILTER(?mode IN (cd:baseTariffSelection_SetBase,cd:baseTariffSelection_RoamingWholesale)) FILTER NOT EXISTS {$this cd:tariffResolution/cd:resolvedBaseTariff ?base} }""" ] ;
    sh:targetClass cd:RatingCalculation .

cd:B110 a sh:NodeShape ;
    sh:sparql [ sh:message "B110: An active agreement has evidence of acceptance and at least one allocated contractual obligation." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:agreementState cd:agreementState_Active. FILTER(!EXISTS {?e a cd:AgreementLifecycleEvent; cd:serviceAgreement $this; cd:agreementAction cd:agreementAction_Accept} || !EXISTS {?o a cd:ContractObligation; cd:serviceAgreement $this}) }""" ] ;
    sh:targetClass cd:ServiceAgreement .

cd:B111 a sh:NodeShape ;
    sh:sparql [ sh:message "B111: Fulfilled duties retain a satisfied assessment; waived duties retain a waiver assessment." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:obligationState ?s. FILTER(?s IN (cd:obligationState_Fulfilled,cd:obligationState_Waived)) BIND(IF(?s=cd:obligationState_Fulfilled,cd:assessmentOutcome_Satisfied,cd:assessmentOutcome_Waived) AS ?outcome) FILTER NOT EXISTS {?a a cd:ObligationAssessment; cd:contractObligation $this; cd:assessmentOutcome ?outcome} }""" ] ;
    sh:targetClass cd:ContractObligation .

cd:B112 a sh:NodeShape ;
    sh:sparql [ sh:message "B112: Amendment and renewal create a distinct successor version retaining the contract identity." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:agreementAction ?a; cd:serviceAgreement ?old. FILTER(?a IN (cd:agreementAction_Amend,cd:agreementAction_Renew)) FILTER NOT EXISTS {$this cd:successorAgreement ?new. ?old cd:agreementReference ?id; cd:agreementVersion ?v1. ?new cd:agreementReference ?id; cd:agreementVersion ?v2. FILTER(?new != ?old && ?v1 != ?v2)} }""" ] ;
    sh:targetClass cd:AgreementLifecycleEvent .

cd:B113 a sh:NodeShape ;
    sh:sparql [ sh:message "B113: Termination identifies who retains residual liability and the settlement cutoff." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:agreementAction cd:agreementAction_Terminate. FILTER(!EXISTS {$this cd:residualLiabilityOwner ?p} || !EXISTS {$this cd:settlementCutoff ?t}) }""" ] ;
    sh:targetClass cd:AgreementLifecycleEvent .

cd:B114 a sh:NodeShape ;
    sh:sparql [ sh:message "B114: An active entitlement is fully contained in its active backing agreement." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:entitlementState cd:entitlementState_Active; cd:serviceAgreement ?a; cd:validFrom ?t. OPTIONAL {$this cd:validUntil ?until} FILTER NOT EXISTS {?a cd:agreementState cd:agreementState_Active; cd:validFrom ?s. OPTIONAL {?a cd:validUntil ?e} FILTER(?t>=?s && (!BOUND(?e) || (?t<?e && BOUND(?until) && ?until<=?e)))} }""" ] ;
    sh:targetClass cd:ServiceEntitlement .

cd:B115 a sh:NodeShape ;
    sh:sparql [ sh:message "B115: Completed closure revokes active access and preserves ownership of any nonzero liability." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:closureState cd:closureState_Completed; cd:activeGrantCount ?g; cd:openLiabilityAmount ?a. FILTER(?g!=0 || !EXISTS {$this cd:completedAt ?t} || !EXISTS {$this cd:closureEvidence ?e} || (?a!=0 && !EXISTS {$this cd:residualLiabilityOwner ?p})) }""" ] ;
    sh:targetClass cd:AccountClosure .

cd:B116 a sh:NodeShape ;
    sh:sparql [ sh:message "B116: An operating station has an accepted operational handover for that same asset." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:assetLifecycle cd:assetLifecycle_Operating. FILTER NOT EXISTS {$this cd:operationalAcceptance ?a. ?a cd:station $this; cd:acceptanceState cd:acceptanceState_Accepted} }""" ] ;
    sh:targetClass cd:ChargingStation .

cd:B117 a sh:NodeShape ;
    sh:sparql [ sh:message "B117: Accepted handover requires successful safety, protocol and metering assessments and evidence." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:acceptanceState cd:acceptanceState_Accepted; cd:safetyAccepted ?s; cd:protocolAccepted ?p; cd:meteringAccepted ?m. FILTER(!?s || !?p || !?m || !EXISTS {$this cd:acceptedAt ?t} || !EXISTS {$this cd:acceptanceEvidence ?e}) }""" ] ;
    sh:targetClass cd:OperationalAcceptance .

cd:B118 a sh:NodeShape ;
    sh:sparql [ sh:message "B118: Replacement and retirement cannot abandon open charging sessions or replace an asset with itself." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { {$this cd:assetAction ?a; cd:openSessionCount ?n. FILTER(?a IN (cd:assetAction_Replace,cd:assetAction_Decommission,cd:assetAction_Dispose) && ?n>0)} UNION {$this cd:station ?s; cd:replacementStation ?s} }""" ] ;
    sh:targetClass cd:AssetLifecycleEvent .

cd:B119 a sh:NodeShape ;
    sh:sparql [ sh:message "B119: A compatible offer requires agreement of physical connector, voltage and current type." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:compatibilityState cd:compatibilityState_Compatible; cd:connectorTypeMatch ?c; cd:voltageMatch ?v; cd:currentTypeMatch ?t. FILTER(!?c || !?v || !?t) }""" ] ;
    sh:targetClass cd:ConnectorCompatibility .

cd:B120 a sh:NodeShape ;
    sh:sparql [ sh:message "B120: Ad hoc offers do not require account registration." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:offerMode cd:offerMode_AdHoc; cd:registrationRequired true. }""" ] ;
    sh:targetClass cd:CommercialOffer .

cd:B121 a sh:NodeShape ;
    sh:sparql [ sh:message "B121: Disclosed currency, tariff currency and offer currency agree and offer expiry follows issue." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { {$this cd:currency ?a; cd:selectedTariff/cd:currency ?b. FILTER(?a!=?b)} UNION {$this cd:currency ?a; cd:priceDisplay/cd:displayCurrency ?b. FILTER(?a!=?b)} UNION {$this cd:issuedAt ?a; cd:expiresAt ?b. FILTER(?b<=?a)} }""" ] ;
    sh:targetClass cd:CommercialOffer .

cd:B122 a sh:NodeShape ;
    sh:sparql [ sh:message "B122: Offer acceptance occurs during the disclosed offer validity window." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:acceptedAt ?t; cd:commercialOffer ?o. ?o cd:issuedAt ?a; cd:expiresAt ?b. FILTER(?t<?a || ?t>=?b) }""" ] ;
    sh:targetClass cd:OfferAcceptance .

cd:B123 a sh:NodeShape ;
    sh:sparql [ sh:message "B123: Acceptance is bound to the same customer and selected tariff as the charging session." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:customer ?c; cd:session ?s; cd:commercialOffer/cd:selectedTariff ?t. FILTER NOT EXISTS {?s cd:customer ?c; cd:selectedTariff ?t} }""" ] ;
    sh:targetClass cd:OfferAcceptance .

cd:B124 a sh:NodeShape ;
    sh:sparql [ sh:message "B124: The commercial supplier matches the supplier of the governing service agreement." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:serviceSupplier ?a; cd:serviceAgreement/cd:supplier ?b. FILTER(?a!=?b) }""" ] ;
    sh:targetClass cd:CommercialResponsibility .

cd:B125 a sh:NodeShape ;
    sh:sparql [ sh:message "B125: Offline admission obeys credential revocation, cache age, unknown-token policy and financial exposure limits." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:offlineDecision cd:offlineDecision_Allow; cd:credentialRevoked ?r; cd:cacheAgeSeconds ?a; cd:maximumCacheAgeSeconds ?m; cd:unknownCredential ?u; cd:permitUnknownCredential ?p; cd:exposureAmount ?e; cd:maximumExposureAmount ?l. FILTER(?r || ?a>?m || (?u && !?p) || ?e>?l || ?e<0 || ?l<0) }""" ] ;
    sh:targetClass cd:OfflineAuthorizationAssessment .

cd:B126 a sh:NodeShape ;
    sh:sparql [ sh:message "B126: Duplicate delivery refers to an already applied event with matching producer, key, scope and payload and has no new effects." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:processingState cd:processingState_Duplicate; cd:processingContextKey ?s; cd:idempotencyKey ?k; cd:payloadDigest ?d; cd:sourceEvent/cd:sourceSystem ?producer. FILTER(EXISTS {$this cd:businessEffect ?e} || !EXISTS {$this cd:duplicateOf ?old. ?old cd:processingState cd:processingState_Applied; cd:processingContextKey ?s; cd:idempotencyKey ?k; cd:payloadDigest ?d; cd:sourceEvent/cd:sourceSystem ?producer}) }""" ] ;
    sh:targetClass cd:EventProcessingOutcome .

cd:B127 a sh:NodeShape ;
    sh:sparql [ sh:message "B127: A producer/key/scope combination has at most one applied business-effect outcome in a tenant." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:processingState cd:processingState_Applied; cd:tenant ?t; cd:processingContextKey ?s; cd:idempotencyKey ?k; cd:sourceEvent/cd:sourceSystem ?p. ?other a cd:EventProcessingOutcome; cd:processingState cd:processingState_Applied; cd:tenant ?t; cd:processingContextKey ?s; cd:idempotencyKey ?k; cd:sourceEvent/cd:sourceSystem ?p. FILTER(?other!=$this) }""" ] ;
    sh:targetClass cd:EventProcessingOutcome .

cd:B128 a sh:NodeShape ;
    sh:sparql [ sh:message "B128: Quarantined events retain a reason and produce no accepted business effects." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:processingState cd:processingState_Quarantined. FILTER(EXISTS {$this cd:businessEffect ?e} || !EXISTS {$this cd:quarantineReason ?r}) }""" ] ;
    sh:targetClass cd:EventProcessingOutcome .

cd:B129 a sh:NodeShape ;
    sh:sparql [ sh:message "B129: Measured usage compares cumulative readings of the same register meter, unit and direction within its epoch." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:deltaBasis cd:deltaBasis_Measured; cd:registerEpoch ?e; cd:startReading ?a; cd:endReading ?b. ?e cd:meter ?m; cd:unitIri ?u; cd:energyDirection ?d; cd:validFrom ?start. OPTIONAL {?e cd:validUntil ?end} FILTER(!EXISTS {?a cd:meter ?m; cd:unitIri ?u; cd:energyDirection ?d; cd:readingKind cd:readingKind_Cumulative; cd:observedAt ?at. FILTER(?at>=?start)} || !EXISTS {?b cd:meter ?m; cd:unitIri ?u; cd:energyDirection ?d; cd:readingKind cd:readingKind_Cumulative; cd:observedAt ?bt. FILTER(!BOUND(?end)||?bt<?end)}) }""" ] ;
    sh:targetClass cd:MeterDelta .

cd:B130 a sh:NodeShape ;
    sh:sparql [ sh:message "B130: Measured deltas preserve ordering, multiplier and reset boundaries; estimated deltas require evidence." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { {$this cd:deltaBasis cd:deltaBasis_Measured; cd:resetDetected ?r; cd:deltaValue ?d; cd:startReading ?a; cd:endReading ?b; cd:registerEpoch/cd:multiplier ?m. ?a cd:numericValue ?x; cd:observedAt ?at. ?b cd:numericValue ?y; cd:observedAt ?bt. FILTER(?r || ?m<=0 || ?bt<=?at || ?d<0 || ?d!=(?y-?x)*?m)} UNION {$this cd:deltaBasis cd:deltaBasis_Estimated. FILTER NOT EXISTS {$this cd:deltaEvidence ?e}} }""" ] ;
    sh:targetClass cd:MeterDelta .

cd:B131 a sh:NodeShape ;
    sh:sparql [ sh:message "B131: Billing readiness requires completed charging and resolved usage, authorization, price, tax, commercial responsibility and blocking issues." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:readinessState cd:readinessState_Ready; cd:usageComplete ?u; cd:priceResolved ?p; cd:taxResolved ?t; cd:authorizationResolved ?a; cd:responsibilityResolved ?r; cd:openBlockingIssueCount ?n. FILTER(!?u || !?p || !?t || !?a || !?r || ?n!=0 || !EXISTS {$this cd:session/cd:sessionState cd:sessionState_Completed} || !EXISTS {$this cd:readinessEvidence ?e}) }""" ] ;
    sh:targetClass cd:BillingReadinessAssessment .

cd:B132 a sh:NodeShape ;
    sh:sparql [ sh:message "B132: A local debit CDR carries a ready billing decision for the same completed session." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:recordOrigin cd:recordOrigin_Local; cd:recordKind cd:recordKind_Debit; cd:session ?s. FILTER NOT EXISTS {$this cd:billingReadiness ?a. ?a cd:readinessState cd:readinessState_Ready; cd:session ?s} }""" ] ;
    sh:targetClass cd:ChargeDetailRecord .

cd:B133 a sh:NodeShape ;
    sh:sparql [ sh:message "B133: Credit CDRs preserve parties and currency, reverse the original totals and cannot credit the same debit more than once." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { { $this cd:recordKind cd:recordKind_Credit; cd:currency ?cur; cd:issuer ?issuer; cd:recipient ?recipient; cd:netAmount ?n; cd:taxAmount ?t; cd:grossAmount ?g. FILTER NOT EXISTS {$this cd:originalChargeRecord ?old. ?old cd:recordKind cd:recordKind_Debit; cd:currency ?cur; cd:issuer ?issuer; cd:recipient ?recipient; cd:netAmount ?on; cd:taxAmount ?ot; cd:grossAmount ?og. FILTER(?old!=$this && ?n=-?on && ?t=-?ot && ?g=-?og)} } UNION { $this cd:recordKind cd:recordKind_Credit; cd:originalChargeRecord ?original. ?other a cd:ChargeDetailRecord; cd:recordKind cd:recordKind_Credit; cd:originalChargeRecord ?original. FILTER(?other!=$this) } }""" ] ;
    sh:targetClass cd:ChargeDetailRecord .

cd:B134 a sh:NodeShape ;
    sh:sparql [ sh:message "B134: Corrections form an acyclic lineage and cannot replace a record with itself." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:originalRecord ?old; cd:correctingRecord ?new. FILTER(?old=?new || EXISTS {?old (^cd:originalRecord/cd:correctingRecord)+ ?old}) }""" ] ;
    sh:targetClass cd:RecordCorrection .

cd:B135 a sh:NodeShape ;
    sh:sparql [ sh:message "B135: Outstanding liability reconciles original charges, credits, collected money and authorized write-offs." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:originalAmount ?o; cd:creditedAmount ?c; cd:collectedAmount ?p; cd:writtenOffAmount ?w; cd:outstandingAmount ?r. FILTER(?o<0 || ?c<0 || ?p<0 || ?w<0 || ?r<0 || ?r!=?o-?c-?p-?w) }""" ] ;
    sh:targetClass cd:FinancialPosition .

cd:B136 a sh:NodeShape ;
    sh:sparql [ sh:message "B136: A settled position has no residual liability; a written-off position records the write-off." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:positionState ?s; cd:outstandingAmount ?v; cd:writtenOffAmount ?w. FILTER((?s=cd:positionState_Settled && ?v!=0) || (?s=cd:positionState_WrittenOff && (?v!=0 || ?w<=0))) }""" ] ;
    sh:targetClass cd:FinancialPosition .

cd:B137 a sh:NodeShape ;
    sh:sparql [ sh:message "B137: Posted allocations use confirmed collections, positive amounts and matching currencies." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:allocationState cd:allocationState_Posted; cd:allocatedAmount ?v; cd:currency ?c; cd:paymentCapture ?p; cd:financialPosition ?f. FILTER(?v<=0 || !EXISTS {?p cd:captureState cd:captureState_Confirmed; cd:currency ?c} || !EXISTS {?f cd:currency ?c}) }""" ] ;
    sh:targetClass cd:PaymentAllocation .

cd:B138 a sh:NodeShape ;
    sh:sparql [ sh:message "B138: Total posted allocations never spend a collection more than once." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:capturedAmount ?limit. {SELECT $this (SUM(?v) AS ?total) WHERE {?a a cd:PaymentAllocation; cd:paymentCapture $this; cd:allocationState cd:allocationState_Posted; cd:allocatedAmount ?v} GROUP BY $this} FILTER(?total>?limit) }""" ] ;
    sh:targetClass cd:PaymentCapture .

cd:B139 a sh:NodeShape ;
    sh:sparql [ sh:message "B139: Missing-record cases allow an absent side with a locator; comparison cases require both actual records." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:mismatchKind ?k. FILTER((?k=cd:mismatchKind_Missing && ((!EXISTS {$this cd:expectedRecord ?e} && !EXISTS {$this cd:observedRecord ?o} && !EXISTS {$this cd:expectedIdentifier ?i}) || (EXISTS {$this cd:expectedRecord ?e} && EXISTS {$this cd:observedRecord ?o}))) || (?k!=cd:mismatchKind_Missing && (!EXISTS {$this cd:expectedRecord ?e} || !EXISTS {$this cd:observedRecord ?o}))) }""" ] ;
    sh:targetClass cd:ReconciliationCase .

cd:B140 a sh:NodeShape ;
    sh:sparql [ sh:message "B140: Resolved reconciliation retains a resolution for the same case, a timestamp and explanation." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:caseState cd:caseState_Resolved. FILTER(!EXISTS {$this cd:resolvedAt ?t} || !EXISTS {$this cd:resolutionNote ?n} || !EXISTS {$this cd:reconciliationResolution ?r. ?r cd:reconciliationCase $this}) }""" ] ;
    sh:targetClass cd:ReconciliationCase .

cd:B141 a sh:NodeShape ;
    sh:sparql [ sh:message "B141: A corrected reconciliation identifies its immutable correction case." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:resolutionKind cd:resolutionKind_Corrected. FILTER NOT EXISTS {$this cd:correction ?c} }""" ] ;
    sh:targetClass cd:ReconciliationResolution .

cd:B142 a sh:NodeShape ;
    sh:sparql [ sh:message "B142: Disputes preserve response deadlines, reasoned closure and an explicit remedy when remedied." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { {$this cd:openedAt ?o; cd:responseDueAt ?d. FILTER(?d<?o)} UNION {$this cd:disputeCaseState ?s. FILTER(?s IN (cd:disputeCaseState_Remedied,cd:disputeCaseState_Closed)) FILTER(!EXISTS {$this cd:resolutionEvidence ?e} || (?s=cd:disputeCaseState_Remedied && !EXISTS {$this cd:remedyRecord ?r}))} }""" ] ;
    sh:targetClass cd:ServiceDispute .

cd:B143 a sh:NodeShape ;
    sh:sparql [ sh:message "B143: Collection escalation pauses for unresolved disputes against the position or its source record even without an explicit dispute link." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { { $this cd:actionKind cd:actionKind_Escalate. { $this cd:financialPosition/cd:positionState cd:positionState_Disputed } UNION {$this cd:serviceDispute/cd:disputeCaseState ?s. FILTER(?s IN (cd:disputeCaseState_Opened,cd:disputeCaseState_Investigating,cd:disputeCaseState_Accepted))} } UNION { $this cd:actionKind cd:actionKind_Escalate; cd:financialPosition ?position. ?dispute a cd:ServiceDispute; cd:disputedRecord ?record; cd:disputeCaseState ?state. FILTER(?state IN (cd:disputeCaseState_Opened,cd:disputeCaseState_Investigating,cd:disputeCaseState_Accepted)) FILTER(?record=?position || EXISTS {?position cd:sourceRecord ?record}) } }""" ] ;
    sh:targetClass cd:DunningAction .

cd:B144 a sh:NodeShape ;
    sh:sparql [ sh:message "B144: Approval cannot release a partner settlement with unresolved differences or missing approval evidence." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:approvalState cd:approvalState_Approved; cd:openDifferenceCount ?n. FILTER(?n!=0 || !EXISTS {$this cd:approvedAt ?t} || !EXISTS {$this cd:approvalEvidence ?e}) }""" ] ;
    sh:targetClass cd:SettlementApproval .

cd:B145 a sh:NodeShape ;
    sh:sparql [ sh:message "B145: Partner settlement totals equal their items; released batches retain an approved release decision." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { { $this cd:netAmount ?n; cd:taxAmount ?t; cd:grossAmount ?g. {SELECT $this (SUM(?in) AS ?sn) (SUM(?it) AS ?st) (SUM(?ig) AS ?sg) WHERE {$this cd:settlementItem ?i. ?i cd:netAmount ?in; cd:taxAmount ?it; cd:grossAmount ?ig} GROUP BY $this} FILTER(?n!=?sn || ?t!=?st || ?g!=?sg) } UNION { $this cd:settlementState ?state. FILTER(?state IN (cd:settlementState_Approved,cd:settlementState_Invoiced,cd:settlementState_Settled)) FILTER NOT EXISTS {?approval a cd:SettlementApproval; cd:settlementBatch $this; cd:approvalState cd:approvalState_Approved} } }""" ] ;
    sh:targetClass cd:SettlementBatch .

cd:B146 a sh:NodeShape ;
    sh:sparql [ sh:message "B146: Approved reimbursement matches claimant, currency, amount, rate and eligible measured energy of the claim." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:approvalState cd:approvalState_Approved; cd:reimbursementRecord ?r; cd:entitledAccount ?a; cd:approvedAmount ?v; cd:approvedRate ?rate; cd:approvedEnergyKWh ?k; cd:currency ?c. FILTER(?v<0 || ?rate<0 || ?k<0 || !EXISTS {$this cd:approvalEvidence ?e} || !EXISTS {$this cd:approvedAt ?t} || !EXISTS {?r cd:beneficiaryAccount ?a; cd:currency ?c; cd:reimbursementAmount ?v; cd:reimbursementRate ?rate; cd:reimbursableEnergyKWh ?k; cd:session/cd:importedEnergyKWh ?measured. FILTER(?k<=?measured)}) }""" ] ;
    sh:targetClass cd:ReimbursementApproval .

cd:B147 a sh:NodeShape ;
    sh:sparql [ sh:message "B147: Paid reimbursements identify an approved claim and a confirmed payout with matching amount and currency." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:reimbursementState cd:reimbursementState_Paid; cd:reimbursementAmount ?a; cd:currency ?c. FILTER(!EXISTS {$this cd:reimbursementApproval ?approval. ?approval cd:reimbursementRecord $this; cd:approvalState cd:approvalState_Approved} || !EXISTS {$this cd:payout ?p. ?p cd:payoutState cd:payoutState_Confirmed; cd:payoutAmount ?a; cd:currency ?c}) }""" ] ;
    sh:targetClass cd:ReimbursementRecord .

cd:B148 a sh:NodeShape ;
    sh:sparql [ sh:message "B148: Consumed reservations reference consumption for the same allowance, billing period and session within the reserved amount." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:reservationState cd:reservationState_Consumed; cd:allowance ?a; cd:billingPeriod ?b; cd:session ?s; cd:reservedValue ?v. FILTER NOT EXISTS {$this cd:consumption ?c. ?c cd:allowance ?a; cd:billingPeriod ?b; cd:session ?s; cd:consumedValue ?used. FILTER(?used>=0 && ?used<=?v)} }""" ] ;
    sh:targetClass cd:BenefitReservation .

cd:B149 a sh:NodeShape ;
    sh:sparql [ sh:message "B149: A power decision stays within safety and contract limits even when optimization preferences are overridden." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:requestedPowerKW ?r; cd:feasiblePowerKW ?f; cd:safetyLimitKW ?s; cd:contractualLimitKW ?c; cd:controlDecision ?d. FILTER(?r<0 || ?f<0 || ?s<0 || ?c<0 || ?f>?s || ?f>?c || ?f>?r || (?d=cd:controlDecision_Accepted && ?f!=?r) || (?d=cd:controlDecision_Rejected && ?f!=0)) }""" ] ;
    sh:targetClass cd:ControlDecision .

cd:B150 a sh:NodeShape ;
    sh:sparql [ sh:message "B150: An accepted export decision requires an export agreement valid throughout the control interval at the same site." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:energyDirection cd:energyDirection_Export; cd:controlDecision ?d; cd:interval ?i; cd:chargingUnit/cd:station/cd:site ?site. FILTER(?d!=cd:controlDecision_Rejected) ?i cd:startsAt ?start; cd:endsAt ?end. FILTER NOT EXISTS {$this cd:exportAgreement ?a. ?a cd:exportPermitted true; cd:site ?site; cd:validFrom ?from. OPTIONAL {?a cd:validUntil ?until} FILTER(?start>=?from && (!BOUND(?until)||?end<=?until))} }""" ] ;
    sh:targetClass cd:ControlDecision .

cd:B151 a sh:NodeShape ;
    sh:sparql [ sh:message "B151: An override is authorized for this unit and covers the entire control interval." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:overrideAuthorization ?o; cd:chargingUnit ?u; cd:interval ?i. ?i cd:startsAt ?s; cd:endsAt ?e. FILTER NOT EXISTS {?o cd:authorizedScope ?u; cd:validFrom ?a; cd:validUntil ?b. FILTER(?s>=?a && ?e<=?b)} }""" ] ;
    sh:targetClass cd:ControlDecision .

cd:B152 a sh:NodeShape ;
    sh:sparql [ sh:message "B152: Fulfilled rights requests require verified identity, completion time and retained response evidence." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:requestState cd:requestState_Fulfilled; cd:identityVerified ?v. FILTER(!?v || !EXISTS {$this cd:completedAt ?t} || !EXISTS {$this cd:responseEvidence ?e}) }""" ] ;
    sh:targetClass cd:DataSubjectRequest .

cd:B153 a sh:NodeShape ;
    sh:sparql [ sh:message "B153: Refusal of a rights request retains a reason and a communicated response." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:requestState cd:requestState_Refused. FILTER(!EXISTS {$this cd:refusalReason ?r} || !EXISTS {$this cd:responseEvidence ?e}) }""" ] ;
    sh:targetClass cd:DataSubjectRequest .

cd:B154 a sh:NodeShape ;
    sh:sparql [ sh:message "B154: Completed disposition retains evidence and respects explicit holds and independently recorded active account-wide holds." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { { $this cd:dispositionState cd:dispositionState_Completed. FILTER(!EXISTS {$this cd:completedAt ?t} || !EXISTS {$this cd:dispositionEvidence ?e} || EXISTS {$this cd:legalHold/cd:holdState cd:holdState_Active}) } UNION { $this cd:dispositionState cd:dispositionState_Completed; cd:subjectAccount ?account. ?hold a cd:LegalHold; cd:heldRecord ?account; cd:holdState cd:holdState_Active. } }""" ] ;
    sh:targetClass cd:DataDisposition .

cd:B155 a sh:NodeShape ;
    sh:sparql [ sh:message "B155: Holds have a future review relative to inception and explicit release evidence in time." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { {$this cd:validFrom ?s; cd:reviewAt ?e. FILTER(?e<=?s)} UNION {$this cd:holdState cd:holdState_Released. FILTER NOT EXISTS {$this cd:releasedAt ?t}} }""" ] ;
    sh:targetClass cd:LegalHold .

cd:B156 a sh:NodeShape ;
    sh:sparql [ sh:message "B156: International personal-data transfers retain an explicit safeguards assessment." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:internationalTransfer true. FILTER NOT EXISTS {$this cd:transferSafeguardEvidence ?e} }""" ] ;
    sh:targetClass cd:ProcessingPurpose .

cd:B157 a sh:NodeShape ;
    sh:sparql [ sh:message "B157: Permission decisions require an active time-valid scoped grant and cannot authorize a currently disabled principal." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { { $this cd:accessDecision cd:accessDecision_Permit; cd:grantee ?p; cd:scopeRecord ?r; cd:permission ?perm; cd:decidedAt ?t. FILTER NOT EXISTS {$this cd:accessGrant ?g. ?g cd:grantState cd:grantState_Active; cd:grantee ?p; cd:scopeRecord ?r; cd:securityRole/cd:permission ?perm; cd:validFrom ?s. OPTIONAL {?g cd:validUntil ?e} FILTER(?t>=?s && (!BOUND(?e)||?t<?e))} } UNION { $this cd:accessDecision cd:accessDecision_Permit; cd:grantee/cd:principalState cd:principalState_Disabled. } }""" ] ;
    sh:targetClass cd:AccessDecision .

cd:B158 a sh:NodeShape ;
    sh:sparql [ sh:message "B158: Valid artifact verification retains a matching computed digest and verification evidence." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:verificationState cd:verificationState_Valid; cd:artifact/cd:contentDigest ?expected. FILTER(!EXISTS {$this cd:computedDigest ?expected} || !EXISTS {$this cd:verificationEvidence ?e}) }""" ] ;
    sh:targetClass cd:EvidenceVerification .

cd:B159 a sh:NodeShape ;
    sh:sparql [ sh:message "B159: Availability commitments use a proportion between zero and one." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:targetFraction ?v. FILTER(?v<0 || ?v>1) }""" ] ;
    sh:targetClass cd:ServiceLevelCommitment .

cd:B160 a sh:NodeShape ;
    sh:sparql [ sh:message "B160: Closed service breaches retain completed remediation or a contractual remedy." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:breachState cd:breachState_Closed. FILTER(!EXISTS {$this cd:workOrder/cd:workState cd:workState_Completed} && !EXISTS {$this cd:remedyRecord ?r}) }""" ] ;
    sh:targetClass cd:ServiceLevelBreach .

cd:B161 a sh:NodeShape ;
    sh:sparql [ sh:message "B161: A passed recovery rehearsal meets both time and data-loss objectives." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:recoveryResult cd:recoveryResult_Passed; cd:recoveryTimeObjectiveSeconds ?rto; cd:recoveryPointObjectiveSeconds ?rpo; cd:achievedRecoverySeconds ?time; cd:achievedDataLossSeconds ?loss. FILTER(?time>?rto || ?loss>?rpo) }""" ] ;
    sh:targetClass cd:RecoveryExercise .

cd:B162 a sh:NodeShape ;
    sh:sparql [ sh:message "B162: Completed migration reconciles all expected records without rejects and revokes obsolete source credentials." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:migrationState cd:migrationState_Completed; cd:expectedRecordCount ?e; cd:migratedRecordCount ?m; cd:rejectedRecordCount ?r; cd:sourceCredentialsRevoked ?revoked. FILTER(?e!=?m || ?r!=0 || !?revoked || !EXISTS {$this cd:reconciliationEvidence ?x}) }""" ] ;
    sh:targetClass cd:MigrationBatch .

cd:B163 a sh:NodeShape ;
    sh:sparql [ sh:message "B163: Current lifecycle snapshots agree with the current subject state and any cited transition." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:targetRecord ?r; cd:stateProperty ?p; cd:stateValue ?v; cd:effectiveAt ?time; cd:snapshotKind ?kind. FILTER((?kind=cd:snapshotKind_Current && !EXISTS {?r ?p ?v}) || EXISTS {$this cd:basisTransition ?t. FILTER NOT EXISTS {?t cd:targetRecord ?r; cd:stateProperty ?p; cd:nextState ?v; cd:transitionedAt ?at. FILTER(?at<=?time)}}) }""" ] ;
    sh:targetClass cd:LifecycleSnapshot .

cd:B164 a sh:NodeShape ;
    sh:sparql [ sh:message "B164: Chained transitions preserve record, property, state continuity and nondecreasing time without circular history." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { { $this cd:previousTransition ?prev; cd:targetRecord ?r; cd:stateProperty ?p; cd:previousState ?s; cd:transitionedAt ?now. FILTER NOT EXISTS {?prev cd:targetRecord ?r; cd:stateProperty ?p; cd:nextState ?s; cd:transitionedAt ?before. FILTER(?now>=?before)} } UNION { $this cd:previousTransition+ $this. } }""" ] ;
    sh:targetClass cd:StateTransition .

cd:B165 a sh:NodeShape ;
    sh:sparql [ sh:message "B165: An adapter cannot declare a feature both supported and unsupported." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:supportedFeature ?f; cd:unsupportedFeature ?f. }""" ] ;
    sh:targetClass cd:ProtocolProfile .

cd:B166 a sh:NodeShape ;
    sh:sparql [ sh:message "B166: Completed business journeys retain evidence and only successfully completed, compensated or explicitly skipped steps." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:processState cd:processState_Completed. FILTER(!EXISTS {$this cd:processEvidence ?e} || EXISTS {$this cd:processStep/cd:stepState ?s. FILTER(?s NOT IN (cd:stepState_Succeeded,cd:stepState_Compensated,cd:stepState_Skipped))}) }""" ] ;
    sh:targetClass cd:ProcessExecution .

cd:B167 a sh:NodeShape ;
    sh:sparql [ sh:message "B167: Successful steps have output and evidence; compensated steps identify their compensating record." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:stepState ?s. FILTER((?s=cd:stepState_Succeeded && (!EXISTS {$this cd:outputRecord ?o} || !EXISTS {$this cd:stepEvidence ?e})) || (?s=cd:stepState_Compensated && !EXISTS {$this cd:compensationRecord ?c})) }""" ] ;
    sh:targetClass cd:ProcessStep .

cd:B168 a sh:NodeShape ;
    sh:sparql [ sh:message "B168: Step sequence numbers are unique within a business journey." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:processStep ?a,?b. ?a cd:stepSequence ?n. ?b cd:stepSequence ?n. FILTER(?a!=?b) }""" ] ;
    sh:targetClass cd:ProcessExecution .

cd:B169 a sh:NodeShape ;
    sh:sparql [ sh:message "B169: Credit-note currency and issuer match the original invoice and cumulative credits stay within its gross amount." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:currency ?cur; cd:issuer ?issuer; cd:originalInvoice ?i. FILTER(!EXISTS {?i cd:currency ?cur; cd:issuer ?issuer} || EXISTS {?i cd:grossAmount ?limit. {SELECT ?i (SUM(?v) AS ?total) WHERE {?note a cd:CreditNote; cd:originalInvoice ?i; cd:creditAmount ?v} GROUP BY ?i} FILTER(?total>?limit)}) }""" ] ;
    sh:targetClass cd:CreditNote .

cd:B170 a sh:NodeShape ;
    sh:sparql [ sh:message "B170: Remaining allowance reconciles opening rollover, grants, consumption, reservations and expired value without a negative balance." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:openingValue ?o; cd:grantedValue ?g; cd:consumedValue ?c; cd:reservedValue ?r; cd:expiredValue ?e; cd:closingValue ?b. FILTER(?o<0 || ?g<0 || ?c<0 || ?r<0 || ?e<0 || ?b<0 || ?b!=?o+?g-?c-?r-?e) }""" ] ;
    sh:targetClass cd:AllowanceBalance .

cd:B171 a sh:NodeShape ;
    sh:sparql [ sh:message "B171: Allowance totals reconcile actual usage and reservations for the same allowance, period and session customer." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { { $this cd:allowance ?allowance; cd:billingPeriod ?period; cd:consumedValue ?c; cd:reservedValue ?r. {SELECT $this (SUM(?used) AS ?totalUsed) WHERE {OPTIONAL {?x a cd:AllowanceConsumption; cd:allowanceBalance $this; cd:consumedValue ?used}} GROUP BY $this} {SELECT $this (SUM(?held) AS ?totalHeld) WHERE {OPTIONAL {?x a cd:BenefitReservation; cd:allowanceBalance $this; cd:reservationState cd:reservationState_Active; cd:reservedValue ?held}} GROUP BY $this} FILTER(?c!=COALESCE(?totalUsed,0) || ?r!=COALESCE(?totalHeld,0) || EXISTS {?item cd:allowanceBalance $this; cd:allowance ?other. FILTER(?other!=?allowance)} || EXISTS {?item cd:allowanceBalance $this; cd:billingPeriod ?other. FILTER(?other!=?period)}) } UNION { $this cd:customer ?owner. ?item cd:allowanceBalance $this; cd:session ?session. FILTER NOT EXISTS {?session cd:customer ?owner} } }""" ] ;
    sh:targetClass cd:AllowanceBalance .

cd:B172 a sh:NodeShape ;
    sh:sparql [ sh:message "B172: Money-denominated allowances identify a currency instead of being treated as energy credits." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:allowance/cd:allowanceDimension cd:allowanceDimension_Money. FILTER NOT EXISTS {$this cd:currency ?c} }""" ] ;
    sh:targetClass cd:AllowanceBalance .

cd:B173 a sh:NodeShape ;
    sh:sparql [ sh:message "B173: Session intervals are contained within the parent session." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:session ?s; cd:interval ?i. ?s cd:startedAt ?start. OPTIONAL {?s cd:endedAt ?end} ?i cd:startsAt ?a; cd:endsAt ?b. FILTER(?a<?start || (BOUND(?end) && ?b>?end)) }""" ] ;
    sh:targetClass cd:ChargingInterval .

cd:B174 a sh:NodeShape ;
    sh:sparql [ sh:message "B174: One online selection set cannot expose overlapping candidate versions of the same tariff identity." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this (cd:defaultTariff|cd:tariffAssignment/cd:assignedTariff) ?x,?y. ?x cd:tariff ?t; cd:validFrom ?a. OPTIONAL {?x cd:validUntil ?b} ?y cd:tariff ?t; cd:validFrom ?c. OPTIONAL {?y cd:validUntil ?d} FILTER(?x!=?y && (!BOUND(?b)||?c<?b) && (!BOUND(?d)||?a<?d)) }""" ] ;
    sh:targetClass cd:TariffSet .

cd:B175 a sh:NodeShape ;
    sh:sparql [ sh:message "B175: Calendar-date values must identify real Gregorian dates." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this ?p ?v. ?p cd:calendarDate true. BIND(xsd:integer(SUBSTR(STR(?v),1,4)) AS ?y) BIND(xsd:integer(SUBSTR(STR(?v),6,2)) AS ?m) BIND(xsd:integer(SUBSTR(STR(?v),9,2)) AS ?d) BIND((?y - FLOOR(?y/4)*4 = 0 && (?y - FLOOR(?y/100)*100 != 0 || ?y - FLOOR(?y/400)*400 = 0)) AS ?leap) FILTER(?y<1 || ?m<1 || ?m>12 || ?d<1 || ?d>31 || (?m IN (4,6,9,11) && ?d>30) || (?m=2 && (?d>29 || (?d=29 && !?leap)))) }""" ] ;
    sh:targetClass cd:Record .

cd:B176 a sh:NodeShape ;
    sh:sparql [ sh:message "B176: Present temporal slices have an immutable graph and digest; retractions have neither." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { {$this cd:sliceState cd:sliceState_Present. FILTER(!EXISTS {$this cd:payloadGraph ?g} || !EXISTS {$this cd:contentDigest ?d})} UNION {$this cd:sliceState cd:sliceState_Retracted. FILTER(EXISTS {$this cd:payloadGraph ?g} || EXISTS {$this cd:contentDigest ?d})} }""" ] ;
    sh:targetClass cd:TemporalSlice .

cd:B177 a sh:NodeShape ;
    sh:sparql [ sh:message "B177: Commit slices form a non-overlapping effective-time map." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:temporalSlice ?x,?y. ?x cd:validFrom ?a. ?y cd:validFrom ?c. OPTIONAL {?x cd:validUntil ?b} OPTIONAL {?y cd:validUntil ?d} FILTER(?x!=?y && (!BOUND(?b)||?c<?b) && (!BOUND(?d)||?a<?d)) }""" ] ;
    sh:targetClass cd:TemporalCommit .

cd:B178 a sh:NodeShape ;
    sh:sparql [ sh:message "B178: Successor commits preserve scope and tenant, advance recording time and sequence, and cannot branch or cycle." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { {$this cd:previousCommit ?p; cd:recordedAt ?now; cd:commitSequence ?n; cd:tenant ?tenant; cd:snapshotScope ?scope. FILTER NOT EXISTS {?p cd:tenant ?tenant; cd:snapshotScope ?scope; cd:recordedAt ?before; cd:commitSequence ?old. FILTER(?now>?before && ?n=?old+1)}} UNION {$this cd:previousCommit+ $this} UNION {$this cd:previousCommit ?p. ?other a cd:TemporalCommit; cd:previousCommit ?p. FILTER(?other!=$this)} UNION {$this cd:commitSequence ?n. FILTER NOT EXISTS {$this cd:previousCommit ?p} FILTER(?n!=1)} UNION {$this cd:tenant ?t; cd:snapshotScope ?scope. ?other a cd:TemporalCommit; cd:tenant ?t; cd:snapshotScope ?scope. FILTER(?other!=$this) FILTER NOT EXISTS {$this cd:previousCommit ?p} FILTER NOT EXISTS {?other cd:previousCommit ?q}} UNION {$this cd:tenant ?t; cd:snapshotScope ?scope; cd:recordedAt ?time. ?other a cd:TemporalCommit; cd:tenant ?t; cd:snapshotScope ?scope; cd:recordedAt ?time. FILTER(?other!=$this)} }""" ] ;
    sh:targetClass cd:TemporalCommit .

cd:B179 a sh:NodeShape ;
    sh:sparql [ sh:message "B179: Committed projections have complete, unique, non-future and monotonic source checkpoints." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { {$this cd:sourceWatermark ?w. FILTER NOT EXISTS {?w cd:watermarkState cd:watermarkState_Complete}} UNION {$this cd:recordedAt ?r; cd:sourceWatermark/cd:watermarkAt ?w. FILTER(?w>?r)} UNION {$this cd:sourceWatermark ?x,?y. ?x cd:sourceSystem ?source; cd:sourcePartition ?part. ?y cd:sourceSystem ?source; cd:sourcePartition ?part. FILTER(?x!=?y)} UNION {$this cd:previousCommit/cd:sourceWatermark ?old. ?old cd:sourceSystem ?source; cd:sourcePartition ?part; cd:sourceOffset ?offset; cd:completeThrough ?time. FILTER NOT EXISTS {$this cd:sourceWatermark ?new. ?new cd:sourceSystem ?source; cd:sourcePartition ?part; cd:sourceOffset ?newOffset; cd:completeThrough ?newTime. FILTER(?newOffset>=?offset && ?newTime>=?time)}} }""" ] ;
    sh:targetClass cd:TemporalCommit .

cd:B180 a sh:NodeShape ;
    sh:sparql [ sh:message "B180: A source completeness cutoff cannot exceed its watermark observation time." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:completeThrough ?t; cd:watermarkAt ?w. FILTER(?t>?w) }""" ] ;
    sh:targetClass cd:ProjectionWatermark .

cd:B181 a sh:NodeShape ;
    sh:sparql [ sh:message "B181: Assignments of a credential cannot overlap inside a coherent validation snapshot." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:credential ?k; cd:validFrom ?a; cd:validUntil ?b. ?other a cd:CredentialAssignment; cd:credential ?k; cd:validFrom ?c; cd:validUntil ?d. FILTER(?other!=$this && ?a<?d && ?c<?b) }""" ] ;
    sh:targetClass cd:CredentialAssignment .

cd:B182 a sh:NodeShape ;
    sh:sparql [ sh:message "B182: Coincident module allocations must remain within cabinet power capacity." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:totalCabinetPowerKW ?capacity. {SELECT $this ?point (SUM(?power) AS ?total) WHERE {{SELECT DISTINCT $this ?point WHERE {?anchor a cd:PowerModuleAllocation; cd:powerCabinet $this; cd:interval/cd:startsAt ?point}} ?allocation a cd:PowerModuleAllocation; cd:powerCabinet $this; cd:allocatedPowerKW ?power; cd:interval ?i. ?i cd:startsAt ?s; cd:endsAt ?e. FILTER(?s<=?point && ?point<?e)} GROUP BY $this ?point} FILTER(?total>?capacity) }""" ] ;
    sh:targetClass cd:PowerCabinet .

cd:B183 a sh:NodeShape ;
    sh:sparql [ sh:message "B183: Confirmed bookings cannot allocate the same charging unit during overlapping windows." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { $this cd:bookingState cd:bookingState_Confirmed; cd:chargingUnit ?unit; cd:bookingWindow ?i. ?i cd:startsAt ?a; cd:endsAt ?b. ?other a cd:Booking; cd:bookingState cd:bookingState_Confirmed; cd:chargingUnit ?unit; cd:bookingWindow ?j. ?j cd:startsAt ?c; cd:endsAt ?d. FILTER(?other!=$this && ?a<?d && ?c<?b) }""" ] ;
    sh:targetClass cd:Booking .

cd:B184 a sh:NodeShape ;
    sh:sparql [ sh:message "B184: Snapshot selection must identify the latest matching commit and slice, or explicitly report unavailability." ;
            sh:select """PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { { $this cd:selectionState ?state. OPTIONAL {$this cd:selectedCommit ?c} OPTIONAL {$this cd:selectedSlice ?s} FILTER((?state=cd:selectionState_Unavailable && (BOUND(?c)||BOUND(?s))) || (?state!=cd:selectionState_Unavailable && (!BOUND(?c)||!BOUND(?s)))) } UNION { $this cd:selectedCommit ?c; cd:selectedSlice ?s; cd:selectionState ?state; cd:validAt ?v; cd:knownAt ?k; cd:snapshotScope ?scope; cd:tenant ?tenant. FILTER NOT EXISTS {?c cd:temporalSlice ?s; cd:snapshotScope ?scope; cd:tenant ?tenant; cd:recordedAt ?r. ?s cd:validFrom ?a; cd:sliceState ?ss. OPTIONAL {?s cd:validUntil ?b} FILTER(?r<=?k && ?a<=?v && (!BOUND(?b)||?v<?b) && ((?state=cd:selectionState_Present && ?ss=cd:sliceState_Present)||(?state=cd:selectionState_Retracted && ?ss=cd:sliceState_Retracted))) FILTER NOT EXISTS {?new a cd:TemporalCommit; cd:tenant ?tenant; cd:snapshotScope ?scope; cd:recordedAt ?nr. FILTER(?r<?nr && ?nr<=?k)}} } UNION { $this cd:selectionState cd:selectionState_Unavailable; cd:validAt ?v; cd:knownAt ?k; cd:snapshotScope ?scope; cd:tenant ?tenant. ?c a cd:TemporalCommit; cd:tenant ?tenant; cd:snapshotScope ?scope; cd:recordedAt ?r; cd:temporalSlice ?s. ?s cd:validFrom ?a. OPTIONAL {?s cd:validUntil ?b} FILTER(?r<=?k && ?a<=?v && (!BOUND(?b)||?v<?b)) FILTER NOT EXISTS {?new a cd:TemporalCommit; cd:tenant ?tenant; cd:snapshotScope ?scope; cd:recordedAt ?nr. FILTER(?r<?nr && ?nr<=?k)} } }""" ] ;
    sh:targetClass cd:TemporalSnapshotSelection .

