    sh:pattern "(Z|[+-][0-9]{2}:[0-9]{2})$" .

cd:WorkOrder_issueShape a sh:PropertyShape ;
    sh:class cd:Issue ;
    sh:maxCount 1 ;
    sh:message "WorkOrder.issue violates its domain contract." ;
    sh:name "issue" ;
    sh:nodeKind sh:IRI ;
    sh:path cd:issue .

cd:WorkOrder_maintenanceProviderShape a sh:PropertyShape ;
    sh:class cd:LegalEntity ;
    sh:maxCount 1 ;
    sh:message "WorkOrder.maintenanceProvider violates its domain contract." ;
    sh:minCount 1 ;
    sh:name "maintenance Provider" ;
    sh:nodeKind sh:IRI ;
    sh:path cd:maintenanceProvider .

cd:WorkOrder_workStateShape a sh:PropertyShape ;
    sh:class cd:WorkStateCode ;
    sh:in ( cd:workState_New cd:workState_Assigned cd:workState_InProgress cd:workState_Completed cd:workState_Cancelled ) ;
    sh:maxCount 1 ;
    sh:message "WorkOrder.workState violates its domain contract." ;
    sh:minCount 1 ;
    sh:name "work State" ;
    sh:nodeKind sh:IRI ;
    sh:path cd:workState .

