@prefix cd: <https://example.org/charge-domain#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cd:AccessDecisionShape a sh:NodeShape ;
    sh:description "Time-specific authorization decision for a principal, permission and record scope; an account identity alone grants no operational authority." ;
    sh:nodeKind sh:IRI ;
    sh:property cd:AccessDecision_accessDecisionShape,
        cd:AccessDecision_accessGrantShape,
        cd:AccessDecision_decidedAtShape,
        cd:AccessDecision_decisionEvidenceShape,
        cd:AccessDecision_granteeShape,
        cd:AccessDecision_permissionShape,
        cd:AccessDecision_scopeRecordShape ;
    sh:targetClass cd:AccessDecision .

cd:AccessGrantShape a sh:NodeShape ;
    sh:description "Time-qualified grant of permissions to a principal over an explicit scope." ;
    sh:nodeKind sh:IRI ;
    sh:property cd:AccessGrant_grantStateShape,
        cd:AccessGrant_granteeShape,
        cd:AccessGrant_scopeRecordShape,
        cd:AccessGrant_securityRoleShape,
        cd:AccessGrant_validFromShape,
        cd:AccessGrant_validUntilShape ;
    sh:targetClass cd:AccessGrant .

cd:AccessTokenLeaseShape a sh:NodeShape ;
    sh:description "Metadata for an issued API access token; token material is stored in a secret manager and is never the RDF identifier." ;
    sh:nodeKind sh:IRI ;
