{
  "process": {
    "id": "meter-correction-review",
    "version": 1,
    "label": "Meter correction",
    "stages": [
      {
        "id": "detected",
        "label": "Mismatch detected"
      },
      {
        "id": "evidence",
        "label": "Evidence received"
      },
      {
        "id": "review",
        "label": "Operator review"
      },
      {
        "id": "adjustment",
        "label": "Billing adjustment"
      }
    ]
  },
  "case": {
    "id": "CW-BILL-0471",
    "title": "Review corrected meter reading",
    "description": "A partner supplied a revised meter value for a completed charging session. Review the evidence and decide whether to apply the correction.",
    "category": "Billing exception",
    "status": "open",
    "priority": "Needs attention",
    "dueLabel": "Due today \u00b7 16:30",
    "assignedRole": "CPO billing operations",
    "assignee": "Unassigned",
    "openedAt": "Today \u00b7 09:42",
    "currentStage": "review",
    "sessionId": "SES-AMS-260928-0471",
    "cdrId": "CDR-NL-EV-0471",
    "site": "Arena parking P2 \u00b7 Amsterdam",
    "partner": "Northline Charge Installations",
    "meterId": "NL-MTR-AMS-4481",
    "meterStart": 12840.5,
    "originalMeterEnd": 12851.1,
    "proposedMeterEnd": 12849.6,
    "tariffEurPerKwh": 0.32,
    "evidenceReference": "EV-2026-4481",
    "evidence": {
      "signatureValid": true,
      "sameRegisterEpoch": true,
      "verified": true
    },
    "registerEpoch": "EPOCH-NL-MTR-AMS-4481-1",
    "pricingBasis": "Tax-inclusive illustrative tariff; no separate fees"
  },
  "task": {
    "id": "review-meter-correction",
    "version": 1,
    "title": "Review partner correction",
    "instructions": "Compare the signed evidence with the original meter record. If it is valid, enter the corrected register value and explain your decision.",
    "submitLabel": "Record decision",
    "form": {
      "id": "meter-correction-decision",
      "version": 1,
      "fields": [
        {
          "id": "meterEnd",
          "label": "Corrected meter end reading",
          "concept": "command:submitCorrection.meterEnd",
          "datatype": "decimal",
          "control": "quantity",
          "unit": "kWh",
          "min": 12840.5,
          "step": 0.001,
          "required": true,
          "defaultValue": "12849.600",
          "help": "Must be greater than the accepted start reading. The platform recalculates the energy and amount.",
          "span": "wide",
          "binding": {
            "kind": "commandInput",
            "command": "submitCorrection",
            "field": "meterEnd"
          }
        },
        {
          "id": "reason",
          "label": "Reason for correction",
          "concept": "RecordCorrection.correctionReason",
          "datatype": "controlled-vocabulary",
          "control": "select",
          "required": true,
          "defaultValue": "partner-correction",
          "options": [
            {
              "value": "partner-correction",
              "label": "Partner submitted corrected meter evidence"
            },
            {
              "value": "transcription-error",
              "label": "Original value was transcribed incorrectly"
            },
            {
              "value": "meter-review",
              "label": "Meter register was reviewed by operations"
            }
          ],
          "help": "Select the reason that best matches the supporting evidence.",
          "binding": {
            "kind": "commandInput",
            "command": "submitCorrection",
            "field": "reason"
          }
        },
        {
          "id": "evidenceReference",
          "label": "Evidence reference",
          "concept": "command:submitCorrection.evidenceReference",
          "datatype": "identifier",
          "control": "masked",
          "mask": "EV-####-####",
          "pattern": "EV-[0-9]{4}-[0-9]{4}",
          "maxLength": 12,
          "required": true,
          "defaultValue": "EV-2026-4481",
          "help": "Enter the reference of the signed partner evidence.",
          "binding": {
            "kind": "commandInput",
            "command": "submitCorrection",
            "field": "evidenceReference"
          }
        },
        {
          "id": "operatorNote",
          "label": "Decision note",
          "concept": "RecordCorrection.correctionReason",
          "datatype": "string",
          "control": "textarea",
          "minLength": 20,
          "maxLength": 500,
          "required": true,
          "placeholder": "Explain what you checked and why the correction is valid\u2026",
          "help": "This note is retained with the correction record for audit and reconciliation.",
          "span": "wide",
          "binding": {
            "kind": "commandInput",
            "command": "submitCorrection",
            "field": "operatorNote"
          }
        }
      ]
    }
  },
  "additionalTasks": [
    {
      "id": "correction-approval",
      "version": 1,
      "form": {
        "id": "chargeweave.correction-approval",
        "version": "1.0.0",
        "fields": [
          {
            "id": "outcome",
            "label": "Decision",
            "concept": "RecordCorrection.correctionReason",
            "datatype": "controlled-vocabulary",
            "control": "select",
            "required": true,
            "options": [
              {
                "value": "approve",
                "label": "Approve correction"
              },
              {
                "value": "reject",
                "label": "Reject correction"
              }
            ],
            "help": "A rejection does not issue a credit or replacement record.",
            "binding": {
              "kind": "commandInput",
              "command": "decideCorrection",
              "field": "outcome"
            }
          },
          {
            "id": "note",
            "label": "Decision note",
            "concept": "RecordCorrection.correctionReason",
            "datatype": "string",
            "control": "textarea",
            "minLength": 20,
            "maxLength": 500,
            "required": true,
            "help": "Explain the evidence and your decision.",
            "span": "wide",
            "binding": {
              "kind": "commandInput",
              "command": "decideCorrection",
              "field": "note"
            }
          }
        ]
      },
      "title": "Approve the billing correction",
      "assignedRole": "BillingApprover",
      "instructions": "Review the prepared evidence and accept or decline the correction."
    }
  ]
}
