@prefix cd: <https://example.org/charge-domain#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/charge-domain> a owl:Ontology ;
    dct:title "Charge Domain Ontology"@en ;
    owl:versionIRI <https://example.org/charge-domain/1.0.0> ;
    owl:versionInfo "1.0.0" .

cd:AccessTokenLease a owl:Class ;
    rdfs:label "Access Token Lease"@en ;
    rdfs:comment "Metadata for an issued API access token; token material is stored in a secret manager and is never the RDF identifier."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:tokenFingerprint ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:issuedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ApiClient ;
            owl:onProperty cd:apiClient ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:revokedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:AccessTokenStateCode ;
            owl:onProperty cd:accessTokenState ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:expiresAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Permission ;
            owl:onProperty cd:permission ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "security-governance" .

cd:ActionApproval a owl:Class ;
    rdfs:label "Action Approval"@en ;
    rdfs:comment "Human approval or rejection of an assistant-proposed operation; never implied by a suggestion."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:AssistantRecommendation ;
            owl:onProperty cd:recommendation ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:RemoteCommand ;
            owl:onProperty cd:approvedCommand ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:decidedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Principal ;
            owl:onProperty cd:approver ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ApprovalDecisionCode ;
            owl:onProperty cd:approvalDecision ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "integration-experience" .

cd:AllowanceConsumption a owl:Class ;
    rdfs:label "Allowance Consumption"@en ;
    rdfs:comment "Consumption of a plan allowance with session and period evidence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:consumedValue ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:BenefitAllowance ;
            owl:onProperty cd:allowance ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ChargingSession ;
            owl:onProperty cd:session ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:recordedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:BillingPeriod ;
            owl:onProperty cd:billingPeriod ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "subscriptions-benefits" .

cd:ApplicationInstallation a owl:Class ;
    rdfs:label "Application Installation"@en ;
    rdfs:comment "Marketplace or custom extension installed with declared permissions and version."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:InstallationStateCode ;
            owl:onProperty cd:installationState ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:AccessGrant ;
            owl:onProperty cd:accessGrant ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:LegalEntity ;
            owl:onProperty cd:provider ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:IntegrationConnection ;
            owl:onProperty cd:integration ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:applicationVersion ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:applicationName ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "integration-experience" .

cd:AuditEntry a owl:Class ;
    rdfs:label "Audit Entry"@en ;
    rdfs:comment "Append-only actor-action-result evidence for privileged or business-significant changes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:AuditResultCode ;
            owl:onProperty cd:auditResult ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:SourceEvent ;
            owl:onProperty cd:sourceEvent ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:newDigest ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:eventAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Principal ;
            owl:onProperty cd:actor ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:previousDigest ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:actionCode ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Record ;
            owl:onProperty cd:auditedRecord ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "security-governance" .

cd:AvailabilityResult a owl:Class ;
    rdfs:label "Availability Result"@en ;
    rdfs:comment "Calculated uptime evidence using a stated denominator and policy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:unavailableSeconds ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:AvailabilityPolicy ;
            owl:onProperty cd:availabilityPolicy ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:eligibleSeconds ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:availabilityFraction ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:calculatedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:TimeWindow ;
            owl:onProperty cd:interval ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Record ;
            owl:onProperty cd:observedAsset ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "operations" .

cd:CertificateLifecycleEvent a owl:Class ;
    rdfs:label "Certificate Lifecycle Event"@en ;
    rdfs:comment "Issuance, installation, renewal or revocation evidence for a certificate."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:eventAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:CertificateActionCode ;
            owl:onProperty cd:certificateAction ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:RemoteCommand ;
            owl:onProperty cd:command ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:CertificateRecord ;
            owl:onProperty cd:certificate ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ChargingStation ;
            owl:onProperty cd:station ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:EvidenceDocument ;
            owl:onProperty cd:evidence ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "security-governance" .

cd:Chargeback a owl:Class ;
    rdfs:label "Chargeback"@en ;
    rdfs:comment "Dispute raised through a payment provider with evidential deadline and outcome."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:disputedAmount ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:reasonCode ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Currency ;
            owl:onProperty cd:currency ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:EvidenceDocument ;
            owl:onProperty cd:evidence ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:responseDueAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:DisputeStateCode ;
            owl:onProperty cd:disputeState ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:PaymentCapture ;
            owl:onProperty cd:paymentCapture ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "payments-ledger" .

cd:CommandOutcome a owl:Class ;
    rdfs:label "Command Outcome"@en ;
    rdfs:comment "Reported acknowledgement or terminal outcome of one command."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:RemoteCommand ;
            owl:onProperty cd:command ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:reportedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:reasonCode ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:EvidenceDocument ;
            owl:onProperty cd:evidence ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:OutcomeKindCode ;
            owl:onProperty cd:outcomeKind ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:OutcomeStateCode ;
            owl:onProperty cd:outcomeState ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "commands-booking" .

cd:CommunicationLog a owl:Class ;
    rdfs:label "Communication Log"@en ;
    rdfs:comment "Bounded request/response metadata and evidence for external communication."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:SourceEvent ;
            owl:onProperty cd:sourceEvent ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:DirectionCode ;
            owl:onProperty cd:direction ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:correlationId ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:wireProtocol ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ProtocolEndpoint ;
            owl:onProperty cd:endpoint ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:protocolResponseCode ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:messageType ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:IntegrationConnection ;
            owl:onProperty cd:integration ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "integration-experience" .

cd:ComplianceAssessment a owl:Class ;
    rdfs:label "Compliance Assessment"@en ;
    rdfs:comment "Provision-specific applicability and evidence assessment; no automatic legal conclusion."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:assessedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:jurisdictionCode ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:EvidenceDocument ;
            owl:onProperty cd:evidence ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:provisionReference ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Record ;
            owl:onProperty cd:assessedRecord ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:AssessmentResultCode ;
            owl:onProperty cd:assessmentResult ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty cd:applicable ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Principal ;
            owl:onProperty cd:assessor ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty cd:regulationReference ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "security-governance" .

cd:ConfigurationVariable a owl:Class ;
    rdfs:label "Configuration Variable"@en ;
    rdfs:comment "Desired and observed device configuration, including component and EVSE addressing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:variableName ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:observedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:componentName ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:attributeType ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ChargingStation ;
            owl:onProperty cd:station ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:observedValue ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:desiredValue ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ConfigurationStateCode ;
            owl:onProperty cd:configurationState ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "device-management" .

cd:ConnectionObservation a owl:Class ;
    rdfs:label "Connection Observation"@en ;
    rdfs:comment "Network reachability observation separated from physical availability and administrative state."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:lastHeartbeatAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:observedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ConnectionStateCode ;
            owl:onProperty cd:connectionState ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ChargingStation ;
            owl:onProperty cd:station ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "device-management" .

cd:ConsentDecision a owl:Class ;
    rdfs:label "Consent Decision"@en ;
    rdfs:comment "Recorded grant or withdrawal for a specific person, purpose and document version."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:CustomerAccount ;
            owl:onProperty cd:customer ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ConsentChoiceCode ;
            owl:onProperty cd:consentChoice ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:consentPurpose ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:PolicyDocument ;
            owl:onProperty cd:policyDocument ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:EvidenceDocument ;
            owl:onProperty cd:evidence ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:decidedAt ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "security-governance" .

cd:ControlGroupMembership a owl:Class ;
    rdfs:label "Control Group Membership"@en ;
    rdfs:comment "Assignment of a station or unit to a load control group with conductor mapping."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:Record ;
            owl:onProperty cd:controlledAsset ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:phaseRotation ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:LoadControlGroup ;
            owl:onProperty cd:controlGroup ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:validFrom ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:validUntil ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "energy" .

cd:CorporateCostAllocation a owl:Class ;
    rdfs:label "Corporate Cost Allocation"@en ;
    rdfs:comment "Split of an eligible session charge between sponsor and driver."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:sponsorAmount ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:totalAmount ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Currency ;
            owl:onProperty cd:currency ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ChargingSession ;
            owl:onProperty cd:session ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:driverAmount ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:CorporateBillingSnapshot ;
            owl:onProperty cd:corporateSnapshot ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:calculationVersion ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "partners-settlement" .

cd:CredentialAssignment a owl:Class ;
    rdfs:label "Credential Assignment"@en ;
    rdfs:comment "Time-bound assignment of a charging credential to a customer or vehicle."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:validUntil ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Vehicle ;
            owl:onProperty cd:vehicle ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ChargingCredential ;
            owl:onProperty cd:credential ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:validFrom ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:CustomerAccount ;
            owl:onProperty cd:customer ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "vehicles-authorization" .

cd:CreditNote a owl:Class ;
    rdfs:label "Credit Note"@en ;
    rdfs:comment "Accounting correction linked to an original invoice, separate from refund execution."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:creditAmount ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:issuedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:EvidenceDocument ;
            owl:onProperty cd:artifact ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:creditReason ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:creditNumber ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Invoice ;
            owl:onProperty cd:originalInvoice ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Currency ;
            owl:onProperty cd:currency ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:LegalEntity ;
            owl:onProperty cd:issuer ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "billing-tax" .

cd:CustomerNotification a owl:Class ;
    rdfs:label "Customer Notification"@en ;
    rdfs:comment "Customer-facing message request and delivery evidence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:ContentTemplate ;
            owl:onProperty cd:contentTemplate ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:requestedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:SourceEvent ;
            owl:onProperty cd:sourceEvent ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:NotificationChannelCode ;
            owl:onProperty cd:notificationChannel ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:NotificationStateCode ;
            owl:onProperty cd:notificationState ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:CustomerAccount ;
            owl:onProperty cd:customer ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "integration-experience" .

cd:DataDisposition a owl:Class ;
    rdfs:label "Data Disposition"@en ;
    rdfs:comment "Evidence of a requested or completed deletion/anonymization action."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:DispositionStateCode ;
            owl:onProperty cd:dispositionState ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:requestedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:RetentionPolicy ;
            owl:onProperty cd:retentionPolicy ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:completedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:EvidenceDocument ;
            owl:onProperty cd:dispositionEvidence ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:CustomerAccount ;
            owl:onProperty cd:subjectAccount ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "security-governance" .

cd:DiagnosticArtifact a owl:Class ;
    rdfs:label "Diagnostic Artifact"@en ;
    rdfs:comment "Diagnostic or security log collection associated with a request and result."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:ChargingStation ;
            owl:onProperty cd:station ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:DiagnosticStateCode ;
            owl:onProperty cd:diagnosticState ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:RemoteCommand ;
            owl:onProperty cd:command ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:requestedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:EvidenceDocument ;
            owl:onProperty cd:artifact ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "device-management" .

cd:DistributedEnergyAsset a owl:Class ;
    rdfs:label "Distributed Energy Asset"@en ;
    rdfs:comment "Site generation or storage participating in energy management."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:ratedPowerKW ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:IntegrationConnection ;
            owl:onProperty cd:integration ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:EnergyAssetKindCode ;
            owl:onProperty cd:energyAssetKind ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty cd:bidirectional ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ChargingSite ;
            owl:onProperty cd:site ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:capacityKWh ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "energy" .

cd:DowntimePeriod a owl:Class ;
    rdfs:label "Downtime Period"@en ;
    rdfs:comment "Planned or unplanned unavailability with cause and notice; exclusions are policy-specific."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:DowntimeStateCode ;
            owl:onProperty cd:downtimeState ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:reasonCode ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:TimeWindow ;
            owl:onProperty cd:interval ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:DowntimeKindCode ;
            owl:onProperty cd:downtimeKind ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ServiceNotice ;
            owl:onProperty cd:serviceNotice ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Record ;
            owl:onProperty cd:observedAsset ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "operations" .

cd:EventDelivery a owl:Class ;
    rdfs:label "Event Delivery"@en ;
    rdfs:comment "Idempotent delivery attempt of one source event to one subscription."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty cd:responseCode ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:positiveInteger ;
            owl:onProperty cd:attemptNumber ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:nextRetryAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:DeliveryStateCode ;
            owl:onProperty cd:deliveryState ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:EventSubscription ;
            owl:onProperty cd:eventSubscription ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:SourceEvent ;
            owl:onProperty cd:sourceEvent ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:attemptedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:idempotencyKey ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "integration-experience" .

cd:ExchangeRate a owl:Class ;
    rdfs:label "Exchange Rate"@en ;
    rdfs:comment "Directional currency conversion quote tied to an instant and provider."@en ;
