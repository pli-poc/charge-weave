            owl:allValuesFrom rdf:langString ;
            owl:onProperty cd:policyTitle ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:validUntil ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "security-governance" .

cd:PowerCabinet a owl:Class ;
    rdfs:label "Power Cabinet"@en ;
    rdfs:comment "Shared DC conversion capacity serving multiple charging units, separate from a station identity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:totalCabinetPowerKW ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:moduleSizeKW ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ChargingSite ;
            owl:onProperty cd:site ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:SharingModeCode ;
            owl:onProperty cd:sharingMode ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ChargingUnit ;
            owl:onProperty cd:servedUnit ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "energy" .

cd:PriceComponent a owl:Class ;
    rdfs:label "Price Component"@en ;
    rdfs:comment "Charge dimension with explicit unit price, billing increment and thresholds."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:unitPrice ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:PricingCondition ;
            owl:onProperty cd:pricingCondition ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:FeeBounds ;
            owl:onProperty cd:feeBounds ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:PriceDimensionCode ;
            owl:onProperty cd:priceDimension ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:graceQuantity ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:PriceTier ;
            owl:onProperty cd:priceTier ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:PriceFreezePolicy ;
            owl:onProperty cd:priceFreezePolicy ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:billingStep ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:GraceModeCode ;
            owl:onProperty cd:graceMode ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:maximumQuantity ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:TaxRule ;
            owl:onProperty cd:taxRule ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:minimumQuantity ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "pricing" .

cd:ProtocolTransaction a owl:Class ;
    rdfs:label "Protocol Transaction"@en ;
    rdfs:comment "Wire-protocol transaction scoped to endpoint and boot epoch; may be one fragment of a session."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:ChargingSession ;
            owl:onProperty cd:session ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:startedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:transactionIdentifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:protocolVersion ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ProtocolEndpoint ;
            owl:onProperty cd:endpoint ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:endedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:bootEpoch ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "sessions-metering" .

cd:RatedLine a owl:Class ;
    rdfs:label "Rated Line"@en ;
    rdfs:comment "Priced usage or fee component with quantity, rounding and tax evidence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:PriceComponent ;
            owl:onProperty cd:priceComponent ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:taxAmount ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Currency ;
            owl:onProperty cd:currency ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:netAmount ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:grossAmount ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:TaxDetermination ;
            owl:onProperty cd:taxDetermination ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:quantityValue ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:unitPrice ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ChargingInterval ;
            owl:onProperty cd:chargingInterval ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:RoundingPolicy ;
            owl:onProperty cd:roundingPolicy ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "billing-tax" .

cd:ReimbursementPolicy a owl:Class ;
    rdfs:label "Reimbursement Policy"@en ;
    rdfs:comment "Date-based home-charge reimbursement rate selection policy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:ServiceAgreement ;
            owl:onProperty cd:serviceAgreement ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:policyName ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ReimbursementRateSourceCode ;
            owl:onProperty cd:reimbursementRateSource ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ElectricityPriceSchedule ;
            owl:onProperty cd:electricitySchedule ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:validFromDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:LegalEntity ;
            owl:onProperty cd:partner ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:validUntilDate ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "partners-settlement" .

cd:RevenueShareRule a owl:Class ;
    rdfs:label "Revenue Share Rule"@en ;
    rdfs:comment "Contractual allocation of a defined revenue base to a beneficiary."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:shareFraction ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:fixedAmount ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Currency ;
            owl:onProperty cd:currency ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:RevenueBasisCode ;
            owl:onProperty cd:revenueBasis ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:LegalEntity ;
            owl:onProperty cd:beneficiary ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:TariffVersion ;
            owl:onProperty cd:applicableTariff ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "partners-settlement" .

cd:RoamingNetwork a owl:Class ;
    rdfs:label "Roaming Network"@en ;
    rdfs:comment "Hub or direct-exchange network with provider identity and supported protocols."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:LegalEntity ;
            owl:onProperty cd:provider ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:networkName ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:supportedVersion ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ProtocolNameCode ;
            owl:onProperty cd:protocolName ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "roaming" .

cd:RoamingParty a owl:Class ;
    rdfs:label "Roaming Party"@en ;
    rdfs:comment "Counterparty representation with externally scoped CPO or eMSP identity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:countryCode ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:LegalEntity ;
            owl:onProperty cd:localPartner ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:partyCode ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:RoamingNetwork ;
            owl:onProperty cd:roamingNetwork ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:RoamingRoleCode ;
            owl:onProperty cd:roamingRole ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:LegalEntity ;
            owl:onProperty cd:party ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "roaming" .

cd:RoundingPolicy a owl:Class ;
    rdfs:label "Rounding Policy"@en ;
    rdfs:comment "Explicit rounding mode and granularity for reproducible commercial calculations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:RoundingStageCode ;
            owl:onProperty cd:roundingStage ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:nonNegativeInteger ;
            owl:onProperty cd:decimalPlaces ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:RoundingModeCode ;
            owl:onProperty cd:roundingMode ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "pricing" .

cd:SelectionStrategyCode a owl:Class ;
    rdfs:label "selection Strategy code"@en ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( cd:selectionStrategy_HighestPriorityFirst ) ] .

cd:ServiceNotice a owl:Class ;
    rdfs:label "Service Notice"@en ;
    rdfs:comment "Localized customer information with severity and effective interval."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:Record ;
            owl:onProperty cd:affectedRecord ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdf:langString ;
            owl:onProperty cd:noticeText ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:validFrom ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:NoticeSeverityCode ;
            owl:onProperty cd:noticeSeverity ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:validUntil ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "places" .

cd:Tariff a owl:Class ;
    rdfs:label "Tariff"@en ;
    rdfs:comment "Stable identity of a commercial pricing offer whose versions hold the immutable terms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:TariffPurposeCode ;
            owl:onProperty cd:tariffPurpose ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:TariffStateCode ;
            owl:onProperty cd:tariffState ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdf:langString ;
            owl:onProperty cd:tariffName ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:OperatorService ;
            owl:onProperty cd:operatorService ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "pricing" .

cd:TariffSet a owl:Class ;
    rdfs:label "Tariff Set"@en ;
    rdfs:comment "Ordered candidate selection policy, with explicit default and offline pricing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:TariffAssignment ;
            owl:onProperty cd:tariffAssignment ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:setName ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:TariffVersion ;
            owl:onProperty cd:defaultTariff ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:TariffVersion ;
            owl:onProperty cd:offlineTariff ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:SelectionStrategyCode ;
            owl:onProperty cd:selectionStrategy ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:OperatorService ;
            owl:onProperty cd:operatorService ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "pricing" .

cd:TaxRule a owl:Class ;
    rdfs:label "Tax Rule"@en ;
    rdfs:comment "Versioned tax rule selected by jurisdiction and supply context; not a global VAT default."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:validUntil ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:jurisdictionCode ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:taxName ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:validFrom ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:taxFraction ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:taxCategory ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:TaxIdentifier ;
            owl:onProperty cd:taxIdentifier ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "billing-tax" .

cd:Tenant a owl:Class ;
    rdfs:label "Tenant"@en ;
    rdfs:comment "Administrative data-isolation boundary, independent of legal entities and brands."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:tenantName ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:tenantKey ] ;
    cd:definitionStatus "Defined" ;
    cd:module "foundation" .

cd:Voucher a owl:Class ;
    rdfs:label "Voucher"@en ;
    rdfs:comment "Monetary redemption instrument with opaque code reference and finite redemption terms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:validFrom ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty cd:voucherCodeReference ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:faceValue ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:validUntil ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:positiveInteger ;
            owl:onProperty cd:redemptionLimit ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Currency ;
            owl:onProperty cd:currency ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:VoucherStateCode ;
            owl:onProperty cd:voucherState ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "payments-ledger" .

