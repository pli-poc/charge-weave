cd:Connector a owl:Class ;
    rdfs:label "Connector"@en ;
    rdfs:comment "Physical vehicle interface attached to a charging unit."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:ChargingUnit ;
            owl:onProperty cd:chargingUnit ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:ratedCurrentA ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:maximumPowerKW ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:connectorStandard ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:connectorReference ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:ratedVoltageV ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ConnectorFormatCode ;
            owl:onProperty cd:connectorFormat ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "assets" .

cd:PartyRole a owl:Class ;
    rdfs:label "Party Role"@en ;
    rdfs:comment "Time-qualified business role held by a legal entity within a service context."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:validFrom ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:LegalEntity ;
            owl:onProperty cd:party ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:validUntil ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:BusinessRoleCode ;
            owl:onProperty cd:businessRole ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:OperatorService ;
            owl:onProperty cd:operatorService ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "identity" .

