    skos:prefLabel "visibility"@en .

cd:walletStateScheme a skos:ConceptScheme ;
    skos:prefLabel "wallet State"@en .

cd:ApiClient a owl:Class ;
    rdfs:label "Api Client"@en ;
    rdfs:comment "Machine API identity with bounded permissions and rate-limit policy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:positiveInteger ;
            owl:onProperty cd:requestsPerMinute ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Principal ;
            owl:onProperty cd:principal ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:allowedNetwork ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:AccessGrant ;
            owl:onProperty cd:accessGrant ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty cd:credentialReference ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:positiveInteger ;
            owl:onProperty cd:requestsPerDay ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "integration-experience" .

cd:ApprovalDecisionCode a owl:Class ;
    rdfs:label "approval Decision code"@en ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( cd:approvalDecision_Approved cd:approvalDecision_Rejected ) ] .

cd:BenefitAllowance a owl:Class ;
    rdfs:label "Benefit Allowance"@en ;
    rdfs:comment "Plan benefit measured in an explicit dimension with reset semantics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty cd:rolloverAllowed ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:allowanceValue ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:AllowanceDimensionCode ;
            owl:onProperty cd:allowanceDimension ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ResetRuleCode ;
            owl:onProperty cd:resetRule ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "subscriptions-benefits" .

cd:BillingCycleCode a owl:Class ;
    rdfs:label "billing Cycle code"@en ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( cd:billingCycle_Annual cd:billingCycle_Monthly ) ] .

cd:BillingModeCode a owl:Class ;
    rdfs:label "billing Mode code"@en ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( cd:billingMode_Postpaid cd:billingMode_Prepaid ) ] .

cd:BillingTypeCode a owl:Class ;
    rdfs:label "billing Type code"@en ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( cd:billingType_Postpaid cd:billingType_Prepaid ) ] .

cd:Booking a owl:Class ;
    rdfs:label "Booking"@en ;
    rdfs:comment "Confirmed future allocation tied to a request, distinct from immediate charger reservation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:TimeWindow ;
            owl:onProperty cd:bookingWindow ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ChargingUnit ;
            owl:onProperty cd:chargingUnit ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ParkingSpace ;
            owl:onProperty cd:parkingSpace ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:BookingRequest ;
            owl:onProperty cd:bookingRequest ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:BookingStateCode ;
            owl:onProperty cd:bookingState ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "commands-booking" .

cd:ChargingArea a owl:Class ;
    rdfs:label "Charging Area"@en ;
    rdfs:comment "Named subdivision of a physical charging site."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom rdf:langString ;
            owl:onProperty cd:areaName ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ParkingSpace ;
            owl:onProperty cd:parkingSpace ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:PaymentTerminal ;
            owl:onProperty cd:terminal ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ChargingSite ;
            owl:onProperty cd:site ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "places" .

cd:ChargingCredential a owl:Class ;
    rdfs:label "Charging Credential"@en ;
    rdfs:comment "Opaque charging credential; RFID, Autocharge and certificate identities remain distinguishable."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:CustomerAccount ;
            owl:onProperty cd:customer ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:validUntil ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:PaymentInstrument ;
            owl:onProperty cd:paymentInstrument ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Vehicle ;
            owl:onProperty cd:vehicle ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty cd:homeOnly ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:CredentialKindCode ;
            owl:onProperty cd:credentialKind ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ExternalIdentifier ;
            owl:onProperty cd:credentialIdentifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:CredentialStateCode ;
            owl:onProperty cd:credentialState ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:validFrom ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "vehicles-authorization" .

cd:ConnectorFormatCode a owl:Class ;
    rdfs:label "connector Format code"@en ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( cd:connectorFormat_Cable cd:connectorFormat_Socket ) ] .

cd:ContentTemplate a owl:Class ;
