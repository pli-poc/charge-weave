cd:timezoneName a owl:DatatypeProperty ;
    rdfs:label "timezone Name"@en ;
    rdfs:comment "Domain relation or value timezone Name; per-class meaning, range and cardinality are specified in the linked class contracts. Used by ChargingSite, ElectricityPriceSchedule, RecurringWindow."@en ;
