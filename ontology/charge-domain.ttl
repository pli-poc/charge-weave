            owl:onProperty cd:area ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:bayReference ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "places" .

cd:PaymentCapture a owl:Class ;
    rdfs:label "Payment Capture"@en ;
    rdfs:comment "Confirmed or pending capture against a payment intent."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
