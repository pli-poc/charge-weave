    skos:prefLabel "service Role"@en .

cd:severityScheme a skos:ConceptScheme ;
    skos:prefLabel "severity"@en .

cd:sharingModeScheme a skos:ConceptScheme ;
    skos:prefLabel "sharing Mode"@en .

cd:stationUseScheme a skos:ConceptScheme ;
    skos:prefLabel "station Use"@en .

cd:subsidyBasisScheme a skos:ConceptScheme ;
    skos:prefLabel "subsidy Basis"@en .

cd:targetRecord a owl:ObjectProperty ;
    rdfs:label "target Record"@en ;
    rdfs:comment "Domain relation or value target Record; per-class meaning, range and cardinality are specified in the linked class contracts. Used by PriorityRule, RemoteCommand, StateTransition."@en ;
    rdfs:range cd:Record ;
