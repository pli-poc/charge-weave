    rdfs:label "verification State"@en ;
    rdfs:comment "Domain relation or value verification State; per-class meaning, range and cardinality are specified in the linked class contracts. Used by CalibrationRecord, DeviceCapability, TaxIdentifier."@en ;
    rdfs:range cd:VerificationStateCode .

