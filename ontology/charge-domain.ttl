        [ a owl:Restriction ;
            owl:allValuesFrom cd:ElectricityPriceInterval ;
            owl:onProperty cd:priceInterval ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:scheduleName ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:defaultUnitPrice ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Currency ;
            owl:onProperty cd:currency ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:LegalEntity ;
            owl:onProperty cd:utilityParty ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:timezoneName ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:PricingModeCode ;
            owl:onProperty cd:pricingMode ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "pricing" .

