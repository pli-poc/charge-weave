    rdfs:comment "Domain relation or value received At; per-class meaning, range and cardinality are specified in the linked class contracts. Used by ChargeDetailRecord, RoamingCommand, SourceEvent."@en ;
    rdfs:range xsd:dateTime .

cd:refundStateScheme a skos:ConceptScheme ;
    skos:prefLabel "refund State"@en .

cd:requestKindScheme a skos:ConceptScheme ;
    skos:prefLabel "request Kind"@en .

cd:requestedBy a owl:ObjectProperty ;
    rdfs:label "requested By"@en ;
    rdfs:comment "Domain relation or value requested By; per-class meaning, range and cardinality are specified in the linked class contracts. Used by AssistantRecommendation, RemoteCommand, ScheduledTariffChange."@en ;
    rdfs:range cd:Principal ;
    cd:sameTenant true .

cd:resetRuleScheme a skos:ConceptScheme ;
    skos:prefLabel "reset Rule"@en .

cd:resolvedAt a owl:DatatypeProperty ;
    rdfs:label "resolved At"@en ;
    rdfs:comment "Domain relation or value resolved At; per-class meaning, range and cardinality are specified in the linked class contracts. Used by Issue, ReconciliationCase, TariffResolution."@en ;
    rdfs:range xsd:dateTime .

cd:retentionPolicy a owl:ObjectProperty ;
    rdfs:label "retention Policy"@en ;
    rdfs:comment "Domain relation or value retention Policy; per-class meaning, range and cardinality are specified in the linked class contracts. Used by ContactProfile, DataDisposition, EvidenceDocument."@en ;
    rdfs:range cd:RetentionPolicy ;
    cd:sameTenant true .

cd:roamingRoleScheme a skos:ConceptScheme ;
    skos:prefLabel "roaming Role"@en .

cd:roundingStageScheme a skos:ConceptScheme ;
    skos:prefLabel "rounding Stage"@en .

cd:scheduleKindScheme a skos:ConceptScheme ;
    skos:prefLabel "schedule Kind"@en .

cd:scheduledAt a owl:DatatypeProperty ;
    rdfs:label "scheduled At"@en ;
    rdfs:comment "Domain relation or value scheduled At; per-class meaning, range and cardinality are specified in the linked class contracts. Used by InstallationJob, Payout, PayoutBatch."@en ;
    rdfs:range xsd:dateTime .

