cd:AccessGrant a owl:Class ;
    rdfs:label "Access Grant"@en ;
    rdfs:comment "Time-qualified grant of permissions to a principal over an explicit scope."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:Principal ;
            owl:onProperty cd:grantee ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:SecurityRole ;
            owl:onProperty cd:securityRole ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:GrantStateCode ;
            owl:onProperty cd:grantState ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Record ;
            owl:onProperty cd:scopeRecord ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:validFrom ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:validUntil ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "identity" .

