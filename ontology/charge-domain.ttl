cd:TaxDetermination a owl:Class ;
    rdfs:label "Tax Determination"@en ;
    rdfs:comment "Recorded tax treatment and evidential facts for a supply or billing line."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:determinedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:determinationReason ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Record ;
            owl:onProperty cd:customerParty ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:LegalEntity ;
            owl:onProperty cd:supplier ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Currency ;
            owl:onProperty cd:currency ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:taxBasisAmount ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:TaxRule ;
            owl:onProperty cd:taxRule ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:taxAmount ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "billing-tax" .

cd:TaxIdentifier a owl:Class ;
    rdfs:label "Tax Identifier"@en ;
    rdfs:comment "Tax registration identifier qualified by issuing jurisdiction and identifier type."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:LegalEntity ;
            owl:onProperty cd:party ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:taxIdentifierType ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:taxNumber ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:jurisdictionCode ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:VerificationStateCode ;
            owl:onProperty cd:verificationState ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "billing-tax" .

cd:TierModeCode a owl:Class ;
    rdfs:label "tier Mode code"@en ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( cd:tierMode_Graduated cd:tierMode_WholeQuantity ) ] .

cd:ValidityModeCode a owl:Class ;
    rdfs:label "validity Mode code"@en ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( cd:validityMode_DaysAfterRedemption cd:validityMode_FixedWindow ) ] .

cd:Wallet a owl:Class ;
    rdfs:label "Wallet"@en ;
    rdfs:comment "Customer monetary balance projection, backed by immutable ledger entries."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:Currency ;
            owl:onProperty cd:currency ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:CustomerAccount ;
            owl:onProperty cd:customer ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:balanceAsOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:balanceAmount ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:WalletStateCode ;
            owl:onProperty cd:walletState ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "payments-ledger" .

cd:accessGrant a owl:ObjectProperty ;
    rdfs:label "access Grant"@en ;
    rdfs:comment "Domain relation or value access Grant; per-class meaning, range and cardinality are specified in the linked class contracts. Used by ApiClient, ApplicationInstallation, ManagementDelegation, SharingAgreement."@en ;
    rdfs:range cd:AccessGrant ;
    cd:sameTenant true .

