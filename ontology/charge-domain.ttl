cd:tariffStateScheme a skos:ConceptScheme ;
    skos:prefLabel "tariff State"@en .

cd:taxBasisScheme a skos:ConceptScheme ;
    skos:prefLabel "tax Basis"@en .

cd:taxDetermination a owl:ObjectProperty ;
    rdfs:label "tax Determination"@en ;
    rdfs:comment "Domain relation or value tax Determination; per-class meaning, range and cardinality are specified in the linked class contracts. Used by CustomFee, RatedLine, ReimbursementTaxCalculation."@en ;
    rdfs:range cd:TaxDetermination ;
    cd:sameTenant true .

cd:taxIdentifier a owl:ObjectProperty ;
    rdfs:label "tax Identifier"@en ;
    rdfs:comment "Domain relation or value tax Identifier; per-class meaning, range and cardinality are specified in the linked class contracts. Used by BillingProfile, LegalEntity, TaxRule."@en ;
    rdfs:range cd:TaxIdentifier ;
