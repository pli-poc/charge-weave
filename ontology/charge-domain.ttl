            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:minimumSessionCharge ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:minimumConnectionEnergyKWh ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Currency ;
            owl:onProperty cd:currency ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:optimizedUnitPrice ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:evaluationVersion ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:optimizedPriceThreshold ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdf:langString ;
            owl:onProperty cd:optimizedLabel ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "pricing" .

cd:SettlementBatch a owl:Class ;
    rdfs:label "Settlement Batch"@en ;
    rdfs:comment "Partner receivable/payable reconciliation over a defined period and currency."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:SettlementStateCode ;
            owl:onProperty cd:settlementState ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:SettlementItem ;
            owl:onProperty cd:settlementItem ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:taxAmount ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Invoice ;
            owl:onProperty cd:invoice ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:grossAmount ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ServiceAgreement ;
            owl:onProperty cd:serviceAgreement ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:TimeWindow ;
            owl:onProperty cd:period ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Currency ;
            owl:onProperty cd:currency ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:netAmount ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "partners-settlement" .

cd:SettlementItem a owl:Class ;
    rdfs:label "Settlement Item"@en ;
    rdfs:comment "Individual charge or adjustment attributed under a contract."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:Currency ;
            owl:onProperty cd:currency ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:netAmount ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:grossAmount ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:taxAmount ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ServiceAgreement ;
            owl:onProperty cd:serviceAgreement ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:adjustmentReason ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ChargeDetailRecord ;
            owl:onProperty cd:chargeRecord ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:LegalEntity ;
            owl:onProperty cd:beneficiary ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "partners-settlement" .

cd:SharingAgreement a owl:Class ;
    rdfs:label "Sharing Agreement"@en ;
    rdfs:comment "Time-limited sharing of an asset with an account or partner, preserving ownership."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:validUntil ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Record ;
            owl:onProperty cd:sharedRecord ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:AccessGrant ;
            owl:onProperty cd:accessGrant ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:LegalEntity ;
            owl:onProperty cd:sharingParty ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Record ;
            owl:onProperty cd:beneficiary ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:validFrom ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "places" .

cd:SignedMeterEvidence a owl:Class ;
    rdfs:label "Signed Meter Evidence"@en ;
    rdfs:comment "Cryptographically signed metering evidence with signing identity and verification result."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:verifiedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:CertificateRecord ;
            owl:onProperty cd:signingCertificate ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:signatureAlgorithm ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:SignatureVerificationCode ;
            owl:onProperty cd:signatureVerification ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:EvidenceDocument ;
            owl:onProperty cd:artifact ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "sessions-metering" .

cd:Subscription a owl:Class ;
    rdfs:label "Subscription"@en ;
    rdfs:comment "Customer enrollment in a plan with explicit renewal and cancellation semantics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:CustomerAccount ;
            owl:onProperty cd:customer ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty cd:renewAutomatically ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:startsAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:endsAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:SubscriptionPlan ;
            owl:onProperty cd:subscriptionPlan ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:cancelledAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:SubscriptionStateCode ;
            owl:onProperty cd:subscriptionState ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "subscriptions-benefits" .

cd:SubscriptionBillingPolicy a owl:Class ;
    rdfs:label "Subscription Billing Policy"@en ;
    rdfs:comment "Subscription fee accumulation, renewal and personal-charger multipliers independent of the service allowance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:feePerPersonalStation ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:SubscriptionPlan ;
            owl:onProperty cd:replacementPlan ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:nonNegativeInteger ;
            owl:onProperty cd:freeRenewalPeriods ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:positiveInteger ;
            owl:onProperty cd:renewalIntervalMonths ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:baseFee ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:usageBillingThreshold ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty cd:applyBaseFeePerStation ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:BillingTypeCode ;
            owl:onProperty cd:billingType ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty cd:accumulateChargingCharges ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Currency ;
            owl:onProperty cd:currency ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "subscriptions-benefits" .

cd:SubsidyRule a owl:Class ;
    rdfs:label "Subsidy Rule"@en ;
    rdfs:comment "Externally funded reduction with a beneficiary, policy version and optional integration authority."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:PricingCondition ;
            owl:onProperty cd:pricingCondition ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:IntegrationConnection ;
            owl:onProperty cd:integrationConnection ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:SubsidyBasisCode ;
            owl:onProperty cd:subsidyBasis ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:subsidyPolicyVersion ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:LegalEntity ;
            owl:onProperty cd:fundingParty ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:subsidyValue ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "pricing" .

cd:TariffAssignment a owl:Class ;
    rdfs:label "Tariff Assignment"@en ;
    rdfs:comment "Membership of a tariff version in a selection set, with explicit priority."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty cd:priority ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:CustomerGroup ;
            owl:onProperty cd:eligibleGroup ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:PricingCondition ;
            owl:onProperty cd:pricingCondition ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:TariffVersion ;
            owl:onProperty cd:assignedTariff ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "pricing" .

cd:TariffResolution a owl:Class ;
    rdfs:label "Tariff Resolution"@en ;
    rdfs:comment "Recorded result of price selection, including input evidence and resolver version."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:resolverVersion ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:decisionExplanation ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ChargingSession ;
            owl:onProperty cd:session ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:TariffVersion ;
            owl:onProperty cd:resolvedBaseTariff ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:resolvedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:TariffSet ;
            owl:onProperty cd:tariffSet ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:TariffVersion ;
            owl:onProperty cd:selectedTariff ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "pricing" .

cd:WalletEntry a owl:Class ;
    rdfs:label "Wallet Entry"@en ;
    rdfs:comment "Signed customer balance movement linked to immutable journal evidence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:idempotencyKey ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:signedAmount ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:recordedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Journal ;
            owl:onProperty cd:journal ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Wallet ;
            owl:onProperty cd:wallet ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:EntryReasonCode ;
            owl:onProperty cd:entryReason ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "payments-ledger" .

