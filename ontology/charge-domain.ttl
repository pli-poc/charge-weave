cd:AvailabilityPolicy a owl:Class ;
    rdfs:label "Availability Policy"@en ;
    rdfs:comment "Versioned definition of downtime inclusion, exclusions and freshness."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty cd:includePlannedDowntime ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:policyVersion ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:calculationExpression ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:positiveInteger ;
            owl:onProperty cd:staleAfterSeconds ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:policyName ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "operations" .

cd:BillingProfile a owl:Class ;
    rdfs:label "Billing Profile"@en ;
    rdfs:comment "Versionable invoice-party details captured when financial documents are issued."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:TaxIdentifier ;
            owl:onProperty cd:taxIdentifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:receiptEmail ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:LegalEntity ;
            owl:onProperty cd:billingParty ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Address ;
            owl:onProperty cd:billToAddress ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:billToName ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "billing-tax" .

cd:BrandProfile a owl:Class ;
    rdfs:label "Brand Profile"@en ;
    rdfs:comment "White-label identity and locale configuration shared across customer channels."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:supportedLanguage ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:primaryColour ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ContactProfile ;
            owl:onProperty cd:supportContact ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:defaultLanguage ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:brandName ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:MediaAsset ;
            owl:onProperty cd:logo ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "integration-experience" .

cd:CalibrationRecord a owl:Class ;
    rdfs:label "Calibration Record"@en ;
    rdfs:comment "Metrology certification and validity information, without assuming compliance from a label."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
