cd:Annotation a owl:Class ;
    rdfs:label "Annotation"@en ;
    rdfs:comment "Authored note attached to a domain record; stored independently from controlled classifications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:noteText ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Principal ;
            owl:onProperty cd:author ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:VisibilityCode ;
            owl:onProperty cd:visibility ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:notedAt ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "foundation" .

cd:AssistantRecommendation a owl:Class ;
    rdfs:label "Assistant Recommendation"@en ;
    rdfs:comment "AI-assisted operational suggestion with evidence and a separate action approval trail."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:Principal ;
            owl:onProperty cd:requestedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:RemoteCommand ;
            owl:onProperty cd:proposedCommand ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:EvidenceDocument ;
            owl:onProperty cd:evidence ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:recommendationText ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:generatedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:modelReference ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Record ;
            owl:onProperty cd:affectedRecord ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "integration-experience" .

cd:AuthorizationDecision a owl:Class ;
    rdfs:label "Authorization Decision"@en ;
    rdfs:comment "Explicit charging decision with reason, policy and offline or remote origin."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:decidedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:AuthorizationRequest ;
            owl:onProperty cd:authorizationRequest ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:expiresAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:DecisionSourceCode ;
            owl:onProperty cd:decisionSource ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:DecisionCode ;
            owl:onProperty cd:decision ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Record ;
            owl:onProperty cd:appliedPolicy ],
        [ a owl:Restriction ;
