@prefix cd: <https://example.org/charge-domain#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cd:PublicListing a owl:Class ;
    rdfs:label "Public Listing"@en ;
    rdfs:comment "Published representation of a site for discovery or roaming, with audience and publication state."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:ChargingSite ;
            owl:onProperty cd:site ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:OperatorService ;
            owl:onProperty cd:operatorService ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ListingStateCode ;
            owl:onProperty cd:listingState ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:paymentBrandCode ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:AccessibilityCode ;
            owl:onProperty cd:accessibility ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:facilityCode ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdf:langString ;
            owl:onProperty cd:publicName ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:publishedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:paymentOptionCode ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:PaymentOptionsKnowledgeCode ;
            owl:onProperty cd:paymentOptionsKnowledge ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:MediaAsset ;
            owl:onProperty cd:media ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:parkingCategory ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "places" .

cd:SharingInvitation a owl:Class ;
    rdfs:label "Sharing Invitation"@en ;
    rdfs:comment "Invitation to accept asset access; stores a secret reference rather than an invitation token."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:expiresAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:inviteeReference ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:SharingAgreement ;
            owl:onProperty cd:sharingAgreement ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty cd:invitationSecretReference ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Principal ;
            owl:onProperty cd:inviter ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Record ;
            owl:onProperty cd:sharedRecord ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:InvitationStateCode ;
            owl:onProperty cd:invitationState ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "places" .

cd:ChargingArea a owl:Class ;
    rdfs:label "Charging Area"@en ;
    rdfs:comment "Named subdivision of a physical charging site."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom rdf:langString ;
            owl:onProperty cd:areaName ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ChargingSite ;
            owl:onProperty cd:site ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:PaymentTerminal ;
            owl:onProperty cd:terminal ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ParkingSpace ;
            owl:onProperty cd:parkingSpace ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "places" .

cd:MediaAsset a owl:Class ;
    rdfs:label "Media Asset"@en ;
    rdfs:comment "Image or media associated with a place or brand, with rights and language metadata."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:rightsStatement ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdf:langString ;
            owl:onProperty cd:altText ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:mediaType ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty cd:mediaUrl ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "places" .

cd:ParkingSpace a owl:Class ;
    rdfs:label "Parking Space"@en ;
    rdfs:comment "Physical parking bay that can serve one or more reachable charging units."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:OccupancyCode ;
            owl:onProperty cd:occupancy ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty cd:accessibleBay ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ChargingArea ;
            owl:onProperty cd:area ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ChargingUnit ;
            owl:onProperty cd:servesUnit ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ChargingSite ;
            owl:onProperty cd:site ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:bayReference ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:occupancyObservedAt ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "places" .

cd:ServiceNotice a owl:Class ;
    rdfs:label "Service Notice"@en ;
    rdfs:comment "Localized customer information with severity and effective interval."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:NoticeSeverityCode ;
            owl:onProperty cd:noticeSeverity ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Record ;
            owl:onProperty cd:affectedRecord ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:validFrom ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:validUntil ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdf:langString ;
            owl:onProperty cd:noticeText ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "places" .

cd:SharingAgreement a owl:Class ;
    rdfs:label "Sharing Agreement"@en ;
    rdfs:comment "Time-limited sharing of an asset with an account or partner, preserving ownership."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:LegalEntity ;
            owl:onProperty cd:sharingParty ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Record ;
            owl:onProperty cd:sharedRecord ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:AccessGrant ;
            owl:onProperty cd:accessGrant ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:validUntil ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Record ;
            owl:onProperty cd:beneficiary ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:validFrom ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "places" .

cd:SiteAccessPolicy a owl:Class ;
    rdfs:label "Site Access Policy"@en ;
    rdfs:comment "Rules for physical or service access, independent of map visibility."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty cd:stopOutsideOpening ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:credentialMethod ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:CustomerGroup ;
            owl:onProperty cd:eligibleGroup ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:RecurringWindow ;
            owl:onProperty cd:openingWindow ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:AccessModeCode ;
            owl:onProperty cd:accessMode ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "places" .

cd:ChargingSite a owl:Class ;
    rdfs:label "Charging Site"@en ;
    rdfs:comment "Physical place containing charging infrastructure, separated from its public listing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:LegalEntity ;
            owl:onProperty cd:siteHost ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:timezoneName ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ServiceNotice ;
            owl:onProperty cd:serviceNotice ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdf:langString ;
            owl:onProperty cd:siteName ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Address ;
            owl:onProperty cd:address ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:SiteAccessPolicy ;
            owl:onProperty cd:siteAccessPolicy ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:GeoPosition ;
            owl:onProperty cd:position ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:RecurringWindow ;
            owl:onProperty cd:openingWindow ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "places" .

