@prefix cd: <https://example.org/charge-domain#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cd:CreditNote a owl:Class ;
    rdfs:label "Credit Note"@en ;
    rdfs:comment "Accounting correction linked to an original invoice, separate from refund execution."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:creditReason ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:creditNumber ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:creditAmount ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:issuedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:LegalEntity ;
            owl:onProperty cd:issuer ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:EvidenceDocument ;
            owl:onProperty cd:artifact ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Currency ;
            owl:onProperty cd:currency ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Invoice ;
            owl:onProperty cd:originalInvoice ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "billing-tax" .

cd:CustomFee a owl:Class ;
    rdfs:label "Custom Fee"@en ;
    rdfs:comment "Explicit non-session fee tied to a customer and accounting basis."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:Currency ;
            owl:onProperty cd:currency ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:netAmount ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:grossAmount ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:CustomerAccount ;
            owl:onProperty cd:customer ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:assessedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:TaxDetermination ;
            owl:onProperty cd:taxDetermination ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:taxAmount ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:feeReason ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "billing-tax" .

cd:FiscalizationAttempt a owl:Class ;
    rdfs:label "Fiscalization Attempt"@en ;
    rdfs:comment "Attempt to submit an invoice to a fiscal authority, with retry and authority outcome."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:authorityReference ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Invoice ;
            owl:onProperty cd:invoice ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:positiveInteger ;
            owl:onProperty cd:attemptNumber ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:failureCode ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:EvidenceDocument ;
            owl:onProperty cd:fiscalDocument ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:attemptedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:IntegrationConnection ;
            owl:onProperty cd:integration ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:FiscalizationStateCode ;
            owl:onProperty cd:fiscalizationState ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "billing-tax" .

cd:RatingCalculation a owl:Class ;
    rdfs:label "Rating Calculation"@en ;
    rdfs:comment "Versioned calculation of a session charge from immutable tariff and usage inputs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:EvidenceDocument ;
            owl:onProperty cd:evidence ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:calculatedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:TariffResolution ;
            owl:onProperty cd:tariffResolution ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:taxAmount ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:netAmount ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:TariffVersion ;
            owl:onProperty cd:selectedTariff ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:ratingVersion ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ChargingSession ;
            owl:onProperty cd:session ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Currency ;
            owl:onProperty cd:currency ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:grossAmount ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:RatedLine ;
            owl:onProperty cd:ratedLine ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "billing-tax" .

cd:Receipt a owl:Class ;
    rdfs:label "Receipt"@en ;
    rdfs:comment "Evidence of a monetary receipt tied to payment capture and optional invoice."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:EvidenceDocument ;
            owl:onProperty cd:artifact ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:receiptNumber ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:receivedAmount ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Invoice ;
            owl:onProperty cd:invoice ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:PaymentCapture ;
            owl:onProperty cd:paymentCapture ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:issuedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Currency ;
            owl:onProperty cd:currency ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "billing-tax" .

cd:BillingProfile a owl:Class ;
    rdfs:label "Billing Profile"@en ;
    rdfs:comment "Versionable invoice-party details captured when financial documents are issued."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:receiptEmail ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:LegalEntity ;
            owl:onProperty cd:billingParty ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Address ;
            owl:onProperty cd:billToAddress ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:TaxIdentifier ;
            owl:onProperty cd:taxIdentifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:billToName ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "billing-tax" .

cd:DocumentNumberSequence a owl:Class ;
    rdfs:label "Document Number Sequence"@en ;
    rdfs:comment "Issuer-scoped numbering configuration with preserved string prefixes and auditability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:DocumentKindCode ;
            owl:onProperty cd:documentKind ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:nonNegativeInteger ;
            owl:onProperty cd:nextSequence ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:nonNegativeInteger ;
            owl:onProperty cd:numberWidth ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:LegalEntity ;
            owl:onProperty cd:issuer ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:numberPrefix ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "billing-tax" .

cd:InvoiceLine a owl:Class ;
    rdfs:label "Invoice Line"@en ;
    rdfs:comment "Invoice line linked to rated or contractual supply evidence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:ServiceAgreement ;
            owl:onProperty cd:serviceAgreement ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Currency ;
            owl:onProperty cd:currency ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:RatedLine ;
            owl:onProperty cd:ratedLine ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ChargeDetailRecord ;
            owl:onProperty cd:chargeRecord ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:taxAmount ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:quantityValue ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdf:langString ;
            owl:onProperty cd:lineDescription ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:unitPrice ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:grossAmount ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:netAmount ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "billing-tax" .

cd:TaxRule a owl:Class ;
    rdfs:label "Tax Rule"@en ;
    rdfs:comment "Versioned tax rule selected by jurisdiction and supply context; not a global VAT default."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:jurisdictionCode ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:validFrom ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:taxCategory ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:taxName ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:TaxIdentifier ;
            owl:onProperty cd:taxIdentifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:taxFraction ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:validUntil ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "billing-tax" .

cd:RatedLine a owl:Class ;
    rdfs:label "Rated Line"@en ;
    rdfs:comment "Priced usage or fee component with quantity, rounding and tax evidence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:quantityValue ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:grossAmount ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ChargingInterval ;
            owl:onProperty cd:chargingInterval ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:PriceComponent ;
            owl:onProperty cd:priceComponent ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:AmountRounding ;
            owl:onProperty cd:amountRounding ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:unitPrice ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:TaxDetermination ;
            owl:onProperty cd:taxDetermination ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:taxAmount ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Currency ;
            owl:onProperty cd:currency ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:RoundingPolicy ;
            owl:onProperty cd:roundingPolicy ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:netAmount ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "billing-tax" .

cd:TaxDetermination a owl:Class ;
    rdfs:label "Tax Determination"@en ;
    rdfs:comment "Recorded tax treatment and evidential facts for a supply or billing line."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:LegalEntity ;
            owl:onProperty cd:supplier ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:TaxRule ;
            owl:onProperty cd:taxRule ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:taxableAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Currency ;
            owl:onProperty cd:currency ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:determinationReason ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:taxBasisAmount ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:taxAmount ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:determinedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Record ;
            owl:onProperty cd:customerParty ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "billing-tax" .

cd:TaxIdentifier a owl:Class ;
    rdfs:label "Tax Identifier"@en ;
    rdfs:comment "Tax registration identifier qualified by issuing jurisdiction and identifier type."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:taxIdentifierType ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:LegalEntity ;
            owl:onProperty cd:party ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:VerificationStateCode ;
            owl:onProperty cd:verificationState ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:jurisdictionCode ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:taxNumber ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "billing-tax" .

cd:Invoice a owl:Class ;
    rdfs:label "Invoice"@en ;
    rdfs:comment "Issued or draft accounting document with independent lifecycle and issuer numbering."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:dueAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:taxAmount ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:InvoiceStateCode ;
            owl:onProperty cd:invoiceState ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:issuedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:BillingProfile ;
            owl:onProperty cd:billingProfile ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:invoiceNumber ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:LegalEntity ;
            owl:onProperty cd:issuer ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:DocumentNumberSequence ;
            owl:onProperty cd:numberSequence ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:InvoiceLine ;
            owl:onProperty cd:invoiceLine ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:CommercialResponsibility ;
            owl:onProperty cd:commercialResponsibility ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:netAmount ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:grossAmount ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:LegalEntity ;
            owl:onProperty cd:financialOwner ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Currency ;
            owl:onProperty cd:currency ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "billing-tax" .

