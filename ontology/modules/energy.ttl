@prefix cd: <https://example.org/charge-domain#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cd:ChargingProfile a owl:Class ;
    rdfs:label "Charging Profile"@en ;
    rdfs:comment "Protocol-independent charging profile preserving purpose, kind, stack precedence and schedule."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:relativeAnchor ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ChargingSchedule ;
            owl:onProperty cd:chargingSchedule ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ProtocolTransaction ;
            owl:onProperty cd:protocolTransaction ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ProfileKindCode ;
            owl:onProperty cd:profileKind ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:nonNegativeInteger ;
            owl:onProperty cd:stackLevel ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ProfilePurposeCode ;
            owl:onProperty cd:profilePurpose ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:RecurrenceKindCode ;
            owl:onProperty cd:recurrenceKind ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "energy" .

cd:ControlDecision a owl:Class ;
    rdfs:label "Control Decision"@en ;
    rdfs:comment "Requested versus feasible power decision constrained by physical, contractual and safety limits, with an explicit rejected or accepted outcome."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:ControlDecisionCode ;
            owl:onProperty cd:controlDecision ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:EnergyDirectionCode ;
            owl:onProperty cd:energyDirection ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:feasiblePowerKW ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:LegalEntity ;
            owl:onProperty cd:accountableParty ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:EvidenceDocument ;
            owl:onProperty cd:controlEvidence ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:requestedPowerKW ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:contractualLimitKW ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:TimeWindow ;
            owl:onProperty cd:interval ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:safetyLimitKW ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ExportAgreement ;
            owl:onProperty cd:exportAgreement ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:OverrideAuthorization ;
            owl:onProperty cd:overrideAuthorization ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ChargingUnit ;
            owl:onProperty cd:chargingUnit ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "energy" .

cd:ControlGroupMembership a owl:Class ;
    rdfs:label "Control Group Membership"@en ;
    rdfs:comment "Assignment of a station or unit to a load control group with conductor mapping."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:Record ;
            owl:onProperty cd:controlledAsset ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:LoadControlGroup ;
            owl:onProperty cd:controlGroup ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:validUntil ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:validFrom ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:phaseRotation ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "energy" .

cd:DistributedEnergyAsset a owl:Class ;
    rdfs:label "Distributed Energy Asset"@en ;
    rdfs:comment "Site generation or storage participating in energy management."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:EnergyAssetKindCode ;
            owl:onProperty cd:energyAssetKind ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:ratedPowerKW ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ChargingSite ;
            owl:onProperty cd:site ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:IntegrationConnection ;
            owl:onProperty cd:integration ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:capacityKWh ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty cd:bidirectional ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "energy" .

cd:FlexibilityDelivery a owl:Class ;
    rdfs:label "Flexibility Delivery"@en ;
    rdfs:comment "Measured delivery against an activation and baseline, retaining verification evidence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:EvidenceDocument ;
            owl:onProperty cd:evidence ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:FlexibilityActivation ;
            owl:onProperty cd:flexibilityActivation ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:baselineEnergyKWh ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:verifiedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:actualEnergyKWh ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:deliveredAdjustmentKWh ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "energy" .

cd:GridConnection a owl:Class ;
    rdfs:label "Grid Connection"@en ;
    rdfs:comment "Site boundary with contractual import and export power limits."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:importLimitKW ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:exportLimitKW ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ExternalIdentifier ;
            owl:onProperty cd:connectionIdentifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:LegalEntity ;
            owl:onProperty cd:gridOperator ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ChargingSite ;
            owl:onProperty cd:site ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:TimeWindow ;
            owl:onProperty cd:effectiveWindow ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "energy" .

cd:PhaseCurrentConstraint a owl:Class ;
    rdfs:label "Phase Current Constraint"@en ;
    rdfs:comment "Per-phase electrical current bound used alongside aggregate power constraints."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:ConstraintOriginCode ;
            owl:onProperty cd:constraintOrigin ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:maximumCurrentA ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:LoadControlGroup ;
            owl:onProperty cd:controlGroup ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:phaseCode ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:TimeWindow ;
            owl:onProperty cd:interval ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "energy" .

cd:PowerConstraint a owl:Class ;
    rdfs:label "Power Constraint"@en ;
    rdfs:comment "Time-limited directional power limit with origin and precedence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:EnergyDirectionCode ;
            owl:onProperty cd:energyDirection ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:maximumPowerKW ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:TimeWindow ;
            owl:onProperty cd:interval ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty cd:priority ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:LoadControlGroup ;
            owl:onProperty cd:controlGroup ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ConstraintOriginCode ;
            owl:onProperty cd:constraintOrigin ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "energy" .

cd:PowerModuleAllocation a owl:Class ;
    rdfs:label "Power Module Allocation"@en ;
    rdfs:comment "Time-bounded assignment of cabinet power modules to a charging unit."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:TimeWindow ;
            owl:onProperty cd:interval ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:allocatedPowerKW ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:PowerCabinet ;
            owl:onProperty cd:powerCabinet ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:positiveInteger ;
            owl:onProperty cd:allocatedModules ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ChargingUnit ;
            owl:onProperty cd:chargingUnit ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "energy" .

cd:PriorityRule a owl:Class ;
    rdfs:label "Priority Rule"@en ;
    rdfs:comment "Allocation preference for a customer, asset, session or state-of-charge band."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:maximumStateOfChargePercent ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty cd:priority ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:minimumStateOfChargePercent ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:LoadControlGroup ;
            owl:onProperty cd:controlGroup ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Record ;
            owl:onProperty cd:targetRecord ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:boostUntil ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "energy" .

cd:ScheduleApplication a owl:Class ;
    rdfs:label "Schedule Application"@en ;
    rdfs:comment "Evidence of device acceptance and observed enforcement of a schedule."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:RemoteCommand ;
            owl:onProperty cd:command ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ChargingSchedule ;
            owl:onProperty cd:chargingSchedule ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ApplicationStateCode ;
            owl:onProperty cd:applicationState ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:appliedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ObservedComplianceCode ;
            owl:onProperty cd:observedCompliance ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "energy" .

cd:SmartChargingPreference a owl:Class ;
    rdfs:label "Smart Charging Preference"@en ;
    rdfs:comment "Customer charging objective including deadline, target energy and randomized-delay preference."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:targetStateOfChargePercent ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:CustomerAccount ;
            owl:onProperty cd:customer ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ChargingStation ;
            owl:onProperty cd:station ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:requiredEnergyKWh ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:nonNegativeInteger ;
            owl:onProperty cd:randomizedDelaySeconds ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:StrategyCode ;
            owl:onProperty cd:strategy ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:departureAt ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "energy" .

cd:UnmanagedLoadObservation a owl:Class ;
    rdfs:label "Unmanaged Load Observation"@en ;
    rdfs:comment "Measured or estimated non-controlled load used for site allocation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:powerKW ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:phaseCode ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:observedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:LoadControlGroup ;
            owl:onProperty cd:controlGroup ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:SourceEvent ;
            owl:onProperty cd:sourceEvent ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:QualityCode ;
            owl:onProperty cd:quality ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:phaseCurrentA ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "energy" .

cd:DemandResponseProgram a owl:Class ;
    rdfs:label "Demand Response Program"@en ;
    rdfs:comment "Utility or aggregator program defining controllable services and measurement obligations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:LegalEntity ;
            owl:onProperty cd:programProvider ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ProtocolNameCode ;
            owl:onProperty cd:protocolName ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ServiceAgreement ;
            owl:onProperty cd:serviceAgreement ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:programReference ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "energy" .

cd:EnergyForecast a owl:Class ;
    rdfs:label "Energy Forecast"@en ;
    rdfs:comment "Versioned forecast series with issue time, horizon, source and uncertainty semantics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:forecastMethod ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Record ;
            owl:onProperty cd:forecastTarget ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:issuedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:TimeWindow ;
            owl:onProperty cd:horizon ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ForecastPoint ;
            owl:onProperty cd:forecastPoint ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "energy" .

cd:ExportAgreement a owl:Class ;
    rdfs:label "Export Agreement"@en ;
    rdfs:comment "Explicit permission, metering and settlement responsibility for bidirectional export rather than assuming import authorization permits export."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:Vehicle ;
            owl:onProperty cd:vehicle ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:LegalEntity ;
            owl:onProperty cd:energySupplier ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ChargingSite ;
            owl:onProperty cd:site ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:validFrom ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ElectricityMeter ;
            owl:onProperty cd:exportMeter ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty cd:exportPermitted ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:LegalEntity ;
            owl:onProperty cd:exportBeneficiary ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:LegalEntity ;
            owl:onProperty cd:gridOperator ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ServiceAgreement ;
            owl:onProperty cd:serviceAgreement ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:validUntil ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "energy" .

cd:FlexibilityActivation a owl:Class ;
    rdfs:label "Flexibility Activation"@en ;
    rdfs:comment "Requested power adjustment over a defined interval with acceptance and delivery tracking."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:FlexibilityAsset ;
            owl:onProperty cd:flexibilityAsset ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:EnergyForecast ;
            owl:onProperty cd:baseline ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:TimeWindow ;
            owl:onProperty cd:interval ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ActivationStateCode ;
            owl:onProperty cd:activationState ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:requestedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:requestedPowerKW ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "energy" .

cd:FlexibilityAsset a owl:Class ;
    rdfs:label "Flexibility Asset"@en ;
    rdfs:comment "Registered control group participating in a flexibility program."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:LoadControlGroup ;
            owl:onProperty cd:controlGroup ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:IntegrationConnection ;
            owl:onProperty cd:integration ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:AssetStateCode ;
            owl:onProperty cd:assetState ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:DemandResponseProgram ;
            owl:onProperty cd:demandResponseProgram ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:validUntil ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "energy" .

cd:ForecastPoint a owl:Class ;
    rdfs:label "Forecast Point"@en ;
    rdfs:comment "Forecast value and optional interval bounds for one time bucket."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:upperBound ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:lowerBound ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:TimeWindow ;
            owl:onProperty cd:interval ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:predictedValue ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "energy" .

cd:OverrideAuthorization a owl:Class ;
    rdfs:label "Override Authorization"@en ;
    rdfs:comment "Time-limited permission to override an optimization preference; it never grants permission to exceed physical safety limits."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:overrideReason ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Principal ;
            owl:onProperty cd:authorizedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:validUntil ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Record ;
            owl:onProperty cd:authorizedScope ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:validFrom ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:EvidenceDocument ;
            owl:onProperty cd:overrideEvidence ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "energy" .

cd:PowerCabinet a owl:Class ;
    rdfs:label "Power Cabinet"@en ;
    rdfs:comment "Shared DC conversion capacity serving multiple charging units, separate from a station identity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:SharingModeCode ;
            owl:onProperty cd:sharingMode ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:totalCabinetPowerKW ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:moduleSizeKW ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ChargingSite ;
            owl:onProperty cd:site ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ChargingUnit ;
            owl:onProperty cd:servedUnit ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "energy" .

cd:SchedulePeriod a owl:Class ;
    rdfs:label "Schedule Period"@en ;
    rdfs:comment "Non-overlapping interval within a charging schedule with a signed directional setpoint."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:positiveInteger ;
            owl:onProperty cd:numberOfPhases ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:EnergyDirectionCode ;
            owl:onProperty cd:energyDirection ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:periodStart ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:periodEnd ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:limitValue ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "energy" .

cd:ChargingSchedule a owl:Class ;
    rdfs:label "Charging Schedule"@en ;
    rdfs:comment "Time-based power/current proposal with explicit version, purpose and validity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:ChargingSession ;
            owl:onProperty cd:session ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ScheduleUnitCode ;
            owl:onProperty cd:scheduleUnit ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:validFrom ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:SchedulePeriod ;
            owl:onProperty cd:schedulePeriod ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:SchedulePurposeCode ;
            owl:onProperty cd:schedulePurpose ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Record ;
            owl:onProperty cd:controlledAsset ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ScheduleKindCode ;
            owl:onProperty cd:scheduleKind ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:nonNegativeInteger ;
            owl:onProperty cd:stackLevel ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:validUntil ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "energy" .

cd:LoadControlGroup a owl:Class ;
    rdfs:label "Load Control Group"@en ;
    rdfs:comment "Virtual allocation group for dynamic load management, separate from physical circuit topology."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:ControlStrategyCode ;
            owl:onProperty cd:controlStrategy ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:groupName ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:IntegrationConnection ;
            owl:onProperty cd:externalControlIntegration ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:PhaseSystemCode ;
            owl:onProperty cd:phaseSystem ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ChargingSite ;
            owl:onProperty cd:site ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:LoadControlGroup ;
            owl:onProperty cd:parentControlGroup ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:offlineReserveCurrentA ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:phaseRotation ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "energy" .

