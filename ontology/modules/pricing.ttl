@prefix cd: <https://example.org/charge-domain#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cd:ScheduledTariffChange a owl:Class ;
    rdfs:label "Scheduled Tariff Change"@en ;
    rdfs:comment "Future activation of a tariff version with accountable scheduling and outcome."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:effectiveAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ChangeStateCode ;
            owl:onProperty cd:changeState ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Principal ;
            owl:onProperty cd:requestedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Tariff ;
            owl:onProperty cd:tariff ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:TariffVersion ;
            owl:onProperty cd:nextTariffVersion ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "pricing" .

cd:SessionLimitPolicy a owl:Class ;
    rdfs:label "Session Limit Policy"@en ;
    rdfs:comment "Limits on charging start or continuation with an explicit enforcement outcome."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:LimitDimensionCode ;
            owl:onProperty cd:limitDimension ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:EnforcementCode ;
            owl:onProperty cd:enforcement ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:TariffVersion ;
            owl:onProperty cd:applicableTariff ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:limitValue ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "pricing" .

cd:TariffResolution a owl:Class ;
    rdfs:label "Tariff Resolution"@en ;
    rdfs:comment "Recorded result of price selection, including input evidence and resolver version."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:resolverVersion ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:decisionExplanation ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ChargingSession ;
            owl:onProperty cd:session ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:TariffVersion ;
            owl:onProperty cd:resolvedBaseTariff ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:resolvedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:TariffSet ;
            owl:onProperty cd:tariffSet ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:TariffVersion ;
            owl:onProperty cd:selectedTariff ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "pricing" .

cd:DiscountRule a owl:Class ;
    rdfs:label "Discount Rule"@en ;
    rdfs:comment "Explicit reduction applied to selected price dimensions or a session total; computation order is part of the policy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:AffectedDimensionCode ;
            owl:onProperty cd:affectedDimension ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:DiscountBasisCode ;
            owl:onProperty cd:discountBasis ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:PricingCondition ;
            owl:onProperty cd:pricingCondition ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:discountMagnitude ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty cd:discountOrder ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "pricing" .

cd:DynamicPriceFormula a owl:Class ;
    rdfs:label "Dynamic Price Formula"@en ;
    rdfs:comment "Versioned formula referencing price feeds, markup and fallback; executable implementation is external."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:fixedMarkup ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:fallbackUnitPrice ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:maximumUnitPrice ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ElectricityPriceSchedule ;
            owl:onProperty cd:fallbackSchedule ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:formulaExpression ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:calculationVersion ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:percentageMarkup ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:formulaLanguage ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ElectricityPriceSchedule ;
            owl:onProperty cd:electricitySchedule ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:minimumUnitPrice ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "pricing" .

cd:ElectricityPriceInterval a owl:Class ;
    rdfs:label "Electricity Price Interval"@en ;
    rdfs:comment "Price for an explicit interval or recurring local window; one timing form is required."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:unitPrice ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:TimeWindow ;
            owl:onProperty cd:interval ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:quotedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:RecurringWindow ;
            owl:onProperty cd:recurringWindow ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "pricing" .

cd:EnergyMix a owl:Class ;
    rdfs:label "Energy Mix"@en ;
    rdfs:comment "Attributed electricity generation mix with period and evidential origin."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:EvidenceDocument ;
            owl:onProperty cd:evidence ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:mixName ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:TimeWindow ;
            owl:onProperty cd:reportingPeriod ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:EnergySourceShare ;
            owl:onProperty cd:sourceShare ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "pricing" .

cd:EnergySourceShare a owl:Class ;
    rdfs:label "Energy Source Share"@en ;
    rdfs:comment "Fraction of generation from one energy source."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:shareFraction ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:EnergySourceCode ;
            owl:onProperty cd:energySource ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "pricing" .

cd:FeeBounds a owl:Class ;
    rdfs:label "Fee Bounds"@en ;
    rdfs:comment "Currency-denominated cap and minimum with an optional quantity cap for one price component."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:maximumBillableQuantity ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:minimumCharge ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Currency ;
            owl:onProperty cd:currency ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:maximumCharge ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "pricing" .

cd:PreauthorizationPolicy a owl:Class ;
    rdfs:label "Preauthorization Policy"@en ;
    rdfs:comment "Payment hold policy separated from the tariff's actual charge calculation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:initialHoldAmount ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:FailureActionCode ;
            owl:onProperty cd:failureAction ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Currency ;
            owl:onProperty cd:currency ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:positiveInteger ;
            owl:onProperty cd:holdTimeoutSeconds ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:incrementalHoldAmount ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "pricing" .

cd:PriceComponent a owl:Class ;
    rdfs:label "Price Component"@en ;
    rdfs:comment "Charge dimension with explicit unit price, billing increment and thresholds."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:unitPrice ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:PricingCondition ;
            owl:onProperty cd:pricingCondition ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:FeeBounds ;
            owl:onProperty cd:feeBounds ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:PriceDimensionCode ;
            owl:onProperty cd:priceDimension ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:graceQuantity ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:PriceTier ;
            owl:onProperty cd:priceTier ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:PriceFreezePolicy ;
            owl:onProperty cd:priceFreezePolicy ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:billingStep ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:GraceModeCode ;
            owl:onProperty cd:graceMode ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:maximumQuantity ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:TaxRule ;
            owl:onProperty cd:taxRule ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:minimumQuantity ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "pricing" .

cd:PriceDisplay a owl:Class ;
    rdfs:label "Price Display"@en ;
    rdfs:comment "Localized pre-session price disclosure and the tariff version it describes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:effectiveAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:DisclosureChannelCode ;
            owl:onProperty cd:disclosureChannel ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty cd:includesTax ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdf:langString ;
            owl:onProperty cd:displayText ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Currency ;
            owl:onProperty cd:displayCurrency ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "pricing" .

cd:PriceFreezePolicy a owl:Class ;
    rdfs:label "Price Freeze Policy"@en ;
    rdfs:comment "Defines when a component's selected unit price is frozen, independently of quantities and tax."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:PriceDimensionCode ;
            owl:onProperty cd:priceDimension ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:FreezeMomentCode ;
            owl:onProperty cd:freezeMoment ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "pricing" .

cd:PriceTier a owl:Class ;
    rdfs:label "Price Tier"@en ;
    rdfs:comment "Tier in a component's piecewise price schedule with explicit accumulation semantics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:tierUnitPrice ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:tierLowerBound ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:PricingCondition ;
            owl:onProperty cd:pricingCondition ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:tierUpperBound ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:TierModeCode ;
            owl:onProperty cd:tierMode ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "pricing" .

cd:RoundingPolicy a owl:Class ;
    rdfs:label "Rounding Policy"@en ;
    rdfs:comment "Explicit rounding mode and granularity for reproducible commercial calculations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:RoundingStageCode ;
            owl:onProperty cd:roundingStage ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:nonNegativeInteger ;
            owl:onProperty cd:decimalPlaces ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:RoundingModeCode ;
            owl:onProperty cd:roundingMode ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "pricing" .

cd:SessionPricingPolicy a owl:Class ;
    rdfs:label "Session Pricing Policy"@en ;
    rdfs:comment "Session-wide floor, ceiling, fee eligibility and ordered component evaluation policy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:nonNegativeInteger ;
            owl:onProperty cd:minimumConnectionDurationSeconds ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:maximumSessionCharge ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:minimumSessionCharge ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:minimumConnectionEnergyKWh ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Currency ;
            owl:onProperty cd:currency ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:optimizedUnitPrice ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:evaluationVersion ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:optimizedPriceThreshold ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdf:langString ;
            owl:onProperty cd:optimizedLabel ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "pricing" .

cd:SubsidyRule a owl:Class ;
    rdfs:label "Subsidy Rule"@en ;
    rdfs:comment "Externally funded reduction with a beneficiary, policy version and optional integration authority."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:PricingCondition ;
            owl:onProperty cd:pricingCondition ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:IntegrationConnection ;
            owl:onProperty cd:integrationConnection ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:SubsidyBasisCode ;
            owl:onProperty cd:subsidyBasis ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:subsidyPolicyVersion ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:LegalEntity ;
            owl:onProperty cd:fundingParty ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:subsidyValue ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "pricing" .

cd:TariffAssignment a owl:Class ;
    rdfs:label "Tariff Assignment"@en ;
    rdfs:comment "Membership of a tariff version in a selection set, with explicit priority."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty cd:priority ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:CustomerGroup ;
            owl:onProperty cd:eligibleGroup ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:PricingCondition ;
            owl:onProperty cd:pricingCondition ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:TariffVersion ;
            owl:onProperty cd:assignedTariff ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "pricing" .

cd:TariffSet a owl:Class ;
    rdfs:label "Tariff Set"@en ;
    rdfs:comment "Ordered candidate selection policy, with explicit default and offline pricing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:TariffAssignment ;
            owl:onProperty cd:tariffAssignment ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:setName ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:TariffVersion ;
            owl:onProperty cd:defaultTariff ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:TariffVersion ;
            owl:onProperty cd:offlineTariff ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:SelectionStrategyCode ;
            owl:onProperty cd:selectionStrategy ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:OperatorService ;
            owl:onProperty cd:operatorService ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "pricing" .

cd:ElectricityPriceSchedule a owl:Class ;
    rdfs:label "Electricity Price Schedule"@en ;
    rdfs:comment "Energy procurement price source, distinct from customer charging tariffs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:EnergyMix ;
            owl:onProperty cd:energyMix ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ElectricityPriceInterval ;
            owl:onProperty cd:priceInterval ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:scheduleName ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:defaultUnitPrice ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Currency ;
            owl:onProperty cd:currency ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:LegalEntity ;
            owl:onProperty cd:utilityParty ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:timezoneName ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:PricingModeCode ;
            owl:onProperty cd:pricingMode ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "pricing" .

cd:Tariff a owl:Class ;
    rdfs:label "Tariff"@en ;
    rdfs:comment "Stable identity of a commercial pricing offer whose versions hold the immutable terms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:TariffPurposeCode ;
            owl:onProperty cd:tariffPurpose ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:TariffStateCode ;
            owl:onProperty cd:tariffState ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdf:langString ;
            owl:onProperty cd:tariffName ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:OperatorService ;
            owl:onProperty cd:operatorService ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "pricing" .

cd:PricingCondition a owl:Class ;
    rdfs:label "Pricing Condition"@en ;
    rdfs:comment "Typed eligibility predicate for a pricing rule, using an explicit comparator and typed value."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:Record ;
            owl:onProperty cd:relatedRecord ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ComparisonOperatorCode ;
            owl:onProperty cd:comparisonOperator ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:positiveInteger ;
            owl:onProperty cd:measurementWindowSeconds ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:comparisonValue ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:MeasurementAggregationCode ;
            owl:onProperty cd:measurementAggregation ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ConditionDimensionCode ;
            owl:onProperty cd:conditionDimension ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty cd:priority ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "pricing" .

cd:TariffVersion a owl:Class ;
    rdfs:label "Tariff Version"@en ;
    rdfs:comment "Immutable price definition including effective window, currency and component rules."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:snapshotDigest ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:BaseTariffSelectionCode ;
            owl:onProperty cd:baseTariffSelection ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:versionTag ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:SubsidyRule ;
            owl:onProperty cd:subsidyRule ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:DynamicPriceFormula ;
            owl:onProperty cd:dynamicPriceFormula ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:TariffModeCode ;
            owl:onProperty cd:tariffMode ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:PriceDisplay ;
            owl:onProperty cd:priceDisplay ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:DiscountRule ;
            owl:onProperty cd:discountRule ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:PricingCondition ;
            owl:onProperty cd:pricingCondition ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:RoundingPolicy ;
            owl:onProperty cd:roundingPolicy ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:validUntil ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Currency ;
            owl:onProperty cd:currency ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:SessionPricingPolicy ;
            owl:onProperty cd:sessionPricingPolicy ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:TariffVersion ;
            owl:onProperty cd:baseTariffVersion ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:validFrom ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Tariff ;
            owl:onProperty cd:tariff ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:PriceComponent ;
            owl:onProperty cd:priceComponent ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:PreauthorizationPolicy ;
            owl:onProperty cd:preauthorizationPolicy ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "pricing" .

