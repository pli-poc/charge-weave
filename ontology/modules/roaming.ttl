@prefix cd: <https://example.org/charge-domain#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cd:PublicDataPublication a owl:Class ;
    rdfs:label "Public Data Publication"@en ;
    rdfs:comment "Versioned public-data export with schema, audience, freshness and evidence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:publishedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:schemaVersion ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:publicationSchema ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:PublicListing ;
            owl:onProperty cd:listing ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:EvidenceDocument ;
            owl:onProperty cd:publicationEvidence ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:validUntil ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty cd:destinationUrl ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "roaming" .

cd:RoamingCommand a owl:Class ;
    rdfs:label "Roaming Command"@en ;
    rdfs:comment "Cross-network command tied to a local command and asynchronous remote outcome."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:remoteCommandReference ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:RemoteCommand ;
            owl:onProperty cd:command ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:RemoteCommandStateCode ;
            owl:onProperty cd:remoteCommandState ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty cd:callbackUrl ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:RoamingConnection ;
            owl:onProperty cd:roamingConnection ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:receivedAt ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "roaming" .

cd:RoamingExchange a owl:Class ;
    rdfs:label "Roaming Exchange"@en ;
    rdfs:comment "Delivery and acknowledgement of one versioned roaming resource or command."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:RoamingConnection ;
            owl:onProperty cd:roamingConnection ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:positiveInteger ;
            owl:onProperty cd:attemptNumber ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:acknowledgedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ExternalIdentifier ;
            owl:onProperty cd:externalIdentifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ExchangeDirectionCode ;
            owl:onProperty cd:exchangeDirection ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ExchangeStateCode ;
            owl:onProperty cd:exchangeState ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Record ;
            owl:onProperty cd:exchangedRecord ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:SourceEvent ;
            owl:onProperty cd:sourceEvent ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "roaming" .

cd:RoamingTariffFilter a owl:Class ;
    rdfs:label "Roaming Tariff Filter"@en ;
    rdfs:comment "Ordered rule for selecting or transforming a remote operator tariff."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:TariffVersion ;
            owl:onProperty cd:resultingTariff ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:FilterStateCode ;
            owl:onProperty cd:filterState ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:PricingCondition ;
            owl:onProperty cd:pricingCondition ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:RoamingParty ;
            owl:onProperty cd:remoteParty ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty cd:priority ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "roaming" .

cd:RoamingTariffMapping a owl:Class ;
    rdfs:label "Roaming Tariff Mapping"@en ;
    rdfs:comment "Connection-specific imported tariff and local commercial interpretation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:TariffVersion ;
            owl:onProperty cd:importedTariff ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ExternalIdentifier ;
            owl:onProperty cd:remoteTariffIdentifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:RoamingConnection ;
            owl:onProperty cd:roamingConnection ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:importedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:EvidenceDocument ;
            owl:onProperty cd:sourceEvidence ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:TariffVersion ;
            owl:onProperty cd:retailTariff ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "roaming" .

cd:SynchronizationCursor a owl:Class ;
    rdfs:label "Synchronization Cursor"@en ;
    rdfs:comment "Checkpoint of a partner stream retaining negotiated ordering and freshness semantics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:streamModuleName ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:RoamingConnection ;
            owl:onProperty cd:roamingConnection ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:watermarkAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:lastSuccessfulAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:cursorValue ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "roaming" .

cd:RoamingBehaviorPolicy a owl:Class ;
    rdfs:label "Roaming Behavior Policy"@en ;
    rdfs:comment "Versioned interpretation rules at a roaming boundary, including unknown status and tariff precedence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:MappingModeCode ;
            owl:onProperty cd:mappingMode ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty cd:periodicMeterUpdates ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:PhasePowerFormulaCode ;
            owl:onProperty cd:phasePowerFormula ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:policyVersion ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:UnknownUnitStatusCode ;
            owl:onProperty cd:unknownUnitStatus ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty cd:overrideExplicitTariff ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "roaming" .

cd:RoamingModuleAgreement a owl:Class ;
    rdfs:label "Roaming Module Agreement"@en ;
    rdfs:comment "Versioned sender/receiver role for one negotiated roaming module."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:ModuleNameCode ;
            owl:onProperty cd:moduleName ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty cd:endpointUrl ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:moduleVersion ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:LocalRoleCode ;
            owl:onProperty cd:localRole ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "roaming" .

cd:RoamingNetwork a owl:Class ;
    rdfs:label "Roaming Network"@en ;
    rdfs:comment "Hub or direct-exchange network with provider identity and supported protocols."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:networkName ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ProtocolNameCode ;
            owl:onProperty cd:protocolName ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:LegalEntity ;
            owl:onProperty cd:provider ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:supportedVersion ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "roaming" .

cd:RoamingParty a owl:Class ;
    rdfs:label "Roaming Party"@en ;
    rdfs:comment "Counterparty representation with externally scoped CPO or eMSP identity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:LegalEntity ;
            owl:onProperty cd:localPartner ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:RoamingRoleCode ;
            owl:onProperty cd:roamingRole ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:RoamingNetwork ;
            owl:onProperty cd:roamingNetwork ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:partyCode ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:countryCode ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:LegalEntity ;
            owl:onProperty cd:party ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "roaming" .

cd:RoamingConnection a owl:Class ;
    rdfs:label "Roaming Connection"@en ;
    rdfs:comment "Contracted technical relationship with negotiated protocol modules and credential references."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:protocolVersion ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:OperatorService ;
            owl:onProperty cd:localService ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty cd:credentialReference ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ServiceAgreement ;
            owl:onProperty cd:serviceAgreement ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:RoamingBehaviorPolicy ;
            owl:onProperty cd:roamingBehaviorPolicy ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ProtocolNameCode ;
            owl:onProperty cd:protocolName ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ConnectionStateCode ;
            owl:onProperty cd:connectionState ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:RoamingModuleAgreement ;
            owl:onProperty cd:moduleAgreement ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty cd:endpointUrl ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:RoamingNetwork ;
            owl:onProperty cd:roamingNetwork ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:RoamingParty ;
            owl:onProperty cd:remoteParty ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "roaming" .

