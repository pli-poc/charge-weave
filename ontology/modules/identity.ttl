@prefix cd: <https://example.org/charge-domain#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cd:GroupMembership a owl:Class ;
    rdfs:label "Group Membership"@en ;
    rdfs:comment "Time-bound association of a customer account with a group."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:CustomerAccount ;
            owl:onProperty cd:customer ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:validFrom ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:CustomerGroup ;
            owl:onProperty cd:customerGroup ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:validUntil ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "identity" .

cd:ManagementDelegation a owl:Class ;
    rdfs:label "Management Delegation"@en ;
    rdfs:comment "Authorized delegation of operational responsibility, without changing asset ownership."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:OperatorService ;
            owl:onProperty cd:delegator ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:AccessGrant ;
            owl:onProperty cd:accessGrant ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:validUntil ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:validFrom ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Record ;
            owl:onProperty cd:scopeRecord ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:LegalEntity ;
            owl:onProperty cd:delegate ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "identity" .

cd:PartyRole a owl:Class ;
    rdfs:label "Party Role"@en ;
    rdfs:comment "Time-qualified business role held by a legal entity within a service context."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:LegalEntity ;
            owl:onProperty cd:party ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:BusinessRoleCode ;
            owl:onProperty cd:businessRole ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:OperatorService ;
            owl:onProperty cd:operatorService ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:validFrom ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:validUntil ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "identity" .

cd:ServiceEntitlement a owl:Class ;
    rdfs:label "Service Entitlement"@en ;
    rdfs:comment "Time-bounded right to consume an explicitly scoped service under a contract, independent of login permissions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:Record ;
            owl:onProperty cd:scopeRecord ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:validUntil ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ServiceAgreement ;
            owl:onProperty cd:serviceAgreement ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:validFrom ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:LegalEntity ;
            owl:onProperty cd:accountableParty ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:CustomerAccount ;
            owl:onProperty cd:customer ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:EntitlementStateCode ;
            owl:onProperty cd:entitlementState ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "identity" .

cd:UserDevice a owl:Class ;
    rdfs:label "User Device"@en ;
    rdfs:comment "Client-device registration using an opaque push or device reference."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty cd:pushTokenReference ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:CustomerAccount ;
            owl:onProperty cd:customer ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:lastSeenAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:platformName ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:deviceReference ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "identity" .

cd:AccessGrant a owl:Class ;
    rdfs:label "Access Grant"@en ;
    rdfs:comment "Time-qualified grant of permissions to a principal over an explicit scope."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:validUntil ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:validFrom ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Principal ;
            owl:onProperty cd:grantee ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:SecurityRole ;
            owl:onProperty cd:securityRole ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Record ;
            owl:onProperty cd:scopeRecord ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:GrantStateCode ;
            owl:onProperty cd:grantState ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "identity" .

cd:AccountClosure a owl:Class ;
    rdfs:label "Account Closure"@en ;
    rdfs:comment "Account offboarding decision that preserves or explicitly transfers remaining debt, refunds and statutory retention duties."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:openLiabilityAmount ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Currency ;
            owl:onProperty cd:currency ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:CustomerAccount ;
            owl:onProperty cd:customer ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:completedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ClosureStateCode ;
            owl:onProperty cd:closureState ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:nonNegativeInteger ;
            owl:onProperty cd:activeGrantCount ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:requestedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:LegalEntity ;
            owl:onProperty cd:residualLiabilityOwner ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:EvidenceDocument ;
            owl:onProperty cd:closureEvidence ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:nonNegativeInteger ;
            owl:onProperty cd:revokedGrantCount ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "identity" .

cd:CustomerGroup a owl:Class ;
    rdfs:label "Customer Group"@en ;
    rdfs:comment "Group for pricing, eligibility, reporting or access; membership is explicit and temporal."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:groupName ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:GroupingPurposeCode ;
            owl:onProperty cd:groupingPurpose ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:OperatorService ;
            owl:onProperty cd:operatorService ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "identity" .

cd:Permission a owl:Class ;
    rdfs:label "Permission"@en ;
    rdfs:comment "Named action permission for a class or bounded resource scope."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:descriptionText ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:permissionAction ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "identity" .

cd:Principal a owl:Class ;
    rdfs:label "Principal"@en ;
    rdfs:comment "Human or machine security subject linked to an identity provider by opaque reference."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:subjectReference ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Person ;
            owl:onProperty cd:person ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:identityProvider ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:PrincipalStateCode ;
            owl:onProperty cd:principalState ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:PrincipalKindCode ;
            owl:onProperty cd:principalKind ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "identity" .

cd:SecurityRole a owl:Class ;
    rdfs:label "Security Role"@en ;
    rdfs:comment "Named collection of permissions; not an organization business role."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:roleName ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Permission ;
            owl:onProperty cd:permission ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "identity" .

cd:ContactProfile a owl:Class ;
    rdfs:label "Contact Profile"@en ;
    rdfs:comment "Purpose-specific contact details with visibility and retention boundaries."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:Address ;
            owl:onProperty cd:contactAddress ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:contactPurpose ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:emailAddress ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:telephoneNumber ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:RetentionPolicy ;
            owl:onProperty cd:retentionPolicy ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "identity" .

cd:Person a owl:Class ;
    rdfs:label "Person"@en ;
    rdfs:comment "Minimal person reference; personally identifying details remain purpose-controlled."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:personReference ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:preferredLanguage ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ContactProfile ;
            owl:onProperty cd:contact ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "identity" .

cd:CustomerAccount a owl:Class ;
    rdfs:label "Customer Account"@en ;
    rdfs:comment "Service account used for charging and commercial relationships; may represent an ad hoc customer."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:AccountClosure ;
            owl:onProperty cd:accountClosure ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:BillingProfile ;
            owl:onProperty cd:billingProfile ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:AccountKindCode ;
            owl:onProperty cd:accountKind ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:LegalEntity ;
            owl:onProperty cd:organization ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:OperatorService ;
            owl:onProperty cd:operatorService ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:preferredLanguage ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:AccountStateCode ;
            owl:onProperty cd:accountState ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Person ;
            owl:onProperty cd:person ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "identity" .

cd:OperatorService a owl:Class ;
    rdfs:label "Operator Service"@en ;
    rdfs:comment "Business service operating a network or driver offering within one tenant."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:Currency ;
            owl:onProperty cd:defaultCurrency ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:serviceName ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:BrandProfile ;
            owl:onProperty cd:brand ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ServiceRoleCode ;
            owl:onProperty cd:serviceRole ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:LegalEntity ;
            owl:onProperty cd:serviceProvider ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:OperatorService ;
            owl:onProperty cd:parentService ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "identity" .

cd:LegalEntity a owl:Class ;
    rdfs:label "Legal Entity"@en ;
    rdfs:comment "Legal person participating in charging services; role is represented separately."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:registrationNumber ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Address ;
            owl:onProperty cd:registeredAddress ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:TaxIdentifier ;
            owl:onProperty cd:taxIdentifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ContactProfile ;
            owl:onProperty cd:contact ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:FinancialAccountReference ;
            owl:onProperty cd:financialAccount ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:legalName ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "identity" .

