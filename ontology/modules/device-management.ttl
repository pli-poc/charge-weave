@prefix cd: <https://example.org/charge-domain#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cd:ConfigurationVariable a owl:Class ;
    rdfs:label "Configuration Variable"@en ;
    rdfs:comment "Desired and observed device configuration, including component and EVSE addressing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:variableName ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:desiredValue ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:componentName ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ConfigurationStateCode ;
            owl:onProperty cd:configurationState ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:attributeType ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:observedValue ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:observedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ChargingStation ;
            owl:onProperty cd:station ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "device-management" .

cd:ConnectionObservation a owl:Class ;
    rdfs:label "Connection Observation"@en ;
    rdfs:comment "Network reachability observation separated from physical availability and administrative state."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:ConnectionStateCode ;
            owl:onProperty cd:connectionState ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ChargingStation ;
            owl:onProperty cd:station ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:lastHeartbeatAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:observedAt ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "device-management" .

cd:DiagnosticArtifact a owl:Class ;
    rdfs:label "Diagnostic Artifact"@en ;
    rdfs:comment "Diagnostic or security log collection associated with a request and result."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:DiagnosticStateCode ;
            owl:onProperty cd:diagnosticState ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:requestedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ChargingStation ;
            owl:onProperty cd:station ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:RemoteCommand ;
            owl:onProperty cd:command ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:EvidenceDocument ;
            owl:onProperty cd:artifact ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "device-management" .

cd:FirmwareDeployment a owl:Class ;
    rdfs:label "Firmware Deployment"@en ;
    rdfs:comment "Scheduled rollout to a station with explicit progression and rollback reference."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:FirmwareRelease ;
            owl:onProperty cd:firmware ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:DeploymentStateCode ;
            owl:onProperty cd:deploymentState ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:FirmwareRelease ;
            owl:onProperty cd:rollbackFirmware ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:RemoteCommand ;
            owl:onProperty cd:command ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:requestedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:completedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ChargingStation ;
            owl:onProperty cd:station ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "device-management" .

cd:HardwareStatusObservation a owl:Class ;
    rdfs:label "Hardware Status Observation"@en ;
    rdfs:comment "Timestamped equipment state from a specific reporting source."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:observedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:HardwareStateCode ;
            owl:onProperty cd:hardwareState ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Record ;
            owl:onProperty cd:observedAsset ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:SourceEvent ;
            owl:onProperty cd:sourceEvent ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:VendorFaultDefinition ;
            owl:onProperty cd:vendorFault ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "device-management" .

cd:ProtocolEndpoint a owl:Class ;
    rdfs:label "Protocol Endpoint"@en ;
    rdfs:comment "Versioned charger communication endpoint with identity and credential reference."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty cd:credentialReference ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:securityProfile ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty cd:endpointUrl ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ExternalIdentifier ;
            owl:onProperty cd:endpointIdentity ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ProtocolNameCode ;
            owl:onProperty cd:protocolName ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ProtocolProfile ;
            owl:onProperty cd:protocolProfile ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:protocolVersion ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "device-management" .

cd:TemplateApplication a owl:Class ;
    rdfs:label "Template Application"@en ;
    rdfs:comment "Auditable attempt to apply a configuration template to a station."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:requestedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ChargingStation ;
            owl:onProperty cd:station ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ConfigurationTemplate ;
            owl:onProperty cd:configurationTemplate ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ApplicationStateCode ;
            owl:onProperty cd:applicationState ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:RemoteCommand ;
            owl:onProperty cd:command ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "device-management" .

cd:ConfigurationTemplate a owl:Class ;
    rdfs:label "Configuration Template"@en ;
    rdfs:comment "Reusable versioned collection of desired device configuration values."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:templateVersion ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:templateName ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ConfigurationTemplateEntry ;
            owl:onProperty cd:templateEntry ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "device-management" .

cd:ConfigurationTemplateEntry a owl:Class ;
    rdfs:label "Configuration Template Entry"@en ;
    rdfs:comment "One typed variable assignment within a configuration template."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:attributeType ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:componentName ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:variableName ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:lexicalValue ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "device-management" .

cd:FirmwareRelease a owl:Class ;
    rdfs:label "Firmware Release"@en ;
    rdfs:comment "Firmware artifact with immutable digest, compatibility and verification information."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:EquipmentModel ;
            owl:onProperty cd:compatibleModel ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:EvidenceDocument ;
            owl:onProperty cd:firmwareArtifact ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:firmwareVersion ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty cd:signatureVerified ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:releaseDate ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "device-management" .

