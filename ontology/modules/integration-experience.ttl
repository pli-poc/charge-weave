@prefix cd: <https://example.org/charge-domain#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cd:ActionApproval a owl:Class ;
    rdfs:label "Action Approval"@en ;
    rdfs:comment "Human approval or rejection of an assistant-proposed operation; never implied by a suggestion."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:AssistantRecommendation ;
            owl:onProperty cd:recommendation ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:RemoteCommand ;
            owl:onProperty cd:approvedCommand ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:decidedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Principal ;
            owl:onProperty cd:approver ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ApprovalDecisionCode ;
            owl:onProperty cd:approvalDecision ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "integration-experience" .

cd:ApplicationInstallation a owl:Class ;
    rdfs:label "Application Installation"@en ;
    rdfs:comment "Marketplace or custom extension installed with declared permissions and version."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:InstallationStateCode ;
            owl:onProperty cd:installationState ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:AccessGrant ;
            owl:onProperty cd:accessGrant ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:LegalEntity ;
            owl:onProperty cd:provider ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:IntegrationConnection ;
            owl:onProperty cd:integration ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:applicationVersion ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:applicationName ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "integration-experience" .

cd:CommunicationLog a owl:Class ;
    rdfs:label "Communication Log"@en ;
    rdfs:comment "Bounded request/response metadata and evidence for external communication."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:SourceEvent ;
            owl:onProperty cd:sourceEvent ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:DirectionCode ;
            owl:onProperty cd:direction ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:correlationId ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:wireProtocol ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ProtocolEndpoint ;
            owl:onProperty cd:endpoint ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:protocolResponseCode ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:messageType ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:IntegrationConnection ;
            owl:onProperty cd:integration ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "integration-experience" .

cd:CustomerNotification a owl:Class ;
    rdfs:label "Customer Notification"@en ;
    rdfs:comment "Customer-facing message request and delivery evidence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:ContentTemplate ;
            owl:onProperty cd:contentTemplate ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:requestedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:SourceEvent ;
            owl:onProperty cd:sourceEvent ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:NotificationChannelCode ;
            owl:onProperty cd:notificationChannel ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:NotificationStateCode ;
            owl:onProperty cd:notificationState ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:CustomerAccount ;
            owl:onProperty cd:customer ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "integration-experience" .

cd:EventDelivery a owl:Class ;
    rdfs:label "Event Delivery"@en ;
    rdfs:comment "Idempotent delivery attempt of one source event to one subscription."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty cd:responseCode ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:positiveInteger ;
            owl:onProperty cd:attemptNumber ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:nextRetryAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:DeliveryStateCode ;
            owl:onProperty cd:deliveryState ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:EventSubscription ;
            owl:onProperty cd:eventSubscription ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:SourceEvent ;
            owl:onProperty cd:sourceEvent ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:attemptedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:idempotencyKey ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "integration-experience" .

cd:ExperienceChannel a owl:Class ;
    rdfs:label "Experience Channel"@en ;
    rdfs:comment "Branded driver or partner interface and its audience/capability configuration."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:PolicyDocument ;
            owl:onProperty cd:policyDocument ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:OperatorService ;
            owl:onProperty cd:operatorService ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty cd:channelUrl ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ChannelKindCode ;
            owl:onProperty cd:channelKind ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:BrandProfile ;
            owl:onProperty cd:brand ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "integration-experience" .

cd:HelpArticle a owl:Class ;
    rdfs:label "Help Article"@en ;
    rdfs:comment "Localized customer-help content with ordering and publication lifecycle."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:ContentStateCode ;
            owl:onProperty cd:contentState ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdf:langString ;
            owl:onProperty cd:question ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:nonNegativeInteger ;
            owl:onProperty cd:displayOrder ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdf:langString ;
            owl:onProperty cd:answer ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "integration-experience" .

cd:MetricObservation a owl:Class ;
    rdfs:label "Metric Observation"@en ;
    rdfs:comment "Calculated metric value tied to a scope, time interval and definition version."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:TimeWindow ;
            owl:onProperty cd:interval ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:EvidenceDocument ;
            owl:onProperty cd:evidence ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty cd:numericValue ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:MetricDefinition ;
            owl:onProperty cd:metricDefinition ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Record ;
            owl:onProperty cd:scopeRecord ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:calculatedAt ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "integration-experience" .

cd:PlatformSetting a owl:Class ;
    rdfs:label "Platform Setting"@en ;
    rdfs:comment "Typed, scoped platform configuration, independently versioned from domain state."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:settingValue ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:settingKey ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Record ;
            owl:onProperty cd:scopeRecord ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:effectiveAt ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "integration-experience" .

cd:ApiClient a owl:Class ;
    rdfs:label "Api Client"@en ;
    rdfs:comment "Machine API identity with bounded permissions and rate-limit policy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:positiveInteger ;
            owl:onProperty cd:requestsPerMinute ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Principal ;
            owl:onProperty cd:principal ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:allowedNetwork ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:AccessGrant ;
            owl:onProperty cd:accessGrant ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty cd:credentialReference ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:positiveInteger ;
            owl:onProperty cd:requestsPerDay ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "integration-experience" .

cd:AssistantRecommendation a owl:Class ;
    rdfs:label "Assistant Recommendation"@en ;
    rdfs:comment "AI-assisted operational suggestion with evidence and a separate action approval trail."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:Principal ;
            owl:onProperty cd:requestedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:RemoteCommand ;
            owl:onProperty cd:proposedCommand ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:EvidenceDocument ;
            owl:onProperty cd:evidence ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:recommendationText ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty cd:generatedAt ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:modelReference ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:Record ;
            owl:onProperty cd:affectedRecord ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "integration-experience" .

cd:BrandProfile a owl:Class ;
    rdfs:label "Brand Profile"@en ;
    rdfs:comment "White-label identity and locale configuration shared across customer channels."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:supportedLanguage ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:primaryColour ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ContactProfile ;
            owl:onProperty cd:supportContact ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:defaultLanguage ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:brandName ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:MediaAsset ;
            owl:onProperty cd:logo ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "integration-experience" .

cd:ContentTemplate a owl:Class ;
    rdfs:label "Content Template"@en ;
    rdfs:comment "Localized versioned communication template with declared placeholders."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cd:ChannelKindCode ;
            owl:onProperty cd:channelKind ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:placeholderName ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:templateVersion ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdf:langString ;
            owl:onProperty cd:templateBody ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:templateKey ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "integration-experience" .

cd:EventSubscription a owl:Class ;
    rdfs:label "Event Subscription"@en ;
    rdfs:comment "Subscription to domain event types over a declared transport and filtering scope."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty cd:signingKeyReference ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty cd:destinationReference ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty cd:suppressOwnEvents ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty cd:includeRoamingAssets ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty cd:includeTimestampInSignature ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:DeliveryTransportCode ;
            owl:onProperty cd:deliveryTransport ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:positiveInteger ;
            owl:onProperty cd:maximumAttempts ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:ApiClient ;
            owl:onProperty cd:subscriber ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "integration-experience" .

cd:MetricDefinition a owl:Class ;
    rdfs:label "Metric Definition"@en ;
    rdfs:comment "Versioned operational or financial metric with explicit population, denominator and unit."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:metricName ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:metricExpression ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:metricVersion ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:expressionLanguage ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "integration-experience" .

cd:IntegrationConnection a owl:Class ;
    rdfs:label "Integration Connection"@en ;
    rdfs:comment "Configured external-service integration with a versioned contract and secret reference."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty cd:credentialReference ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:IntegrationKindCode ;
            owl:onProperty cd:integrationKind ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:contractVersion ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:LegalEntity ;
            owl:onProperty cd:provider ],
        [ a owl:Restriction ;
            owl:allValuesFrom cd:IntegrationStateCode ;
            owl:onProperty cd:integrationState ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cd:integrationName ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty cd:endpointUrl ],
        cd:Record ;
    cd:definitionStatus "Defined" ;
    cd:module "integration-experience" .

