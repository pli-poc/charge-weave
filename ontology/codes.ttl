@prefix cd: <https://example.org/charge-domain#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

cd:SelectionStrategyCode a owl:Class ;
    rdfs:label "selection Strategy code"@en ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( cd:selectionStrategy_HighestPriorityFirst ) ] .

cd:selectionStrategyScheme a skos:ConceptScheme ;
    skos:prefLabel "selection Strategy"@en .

cd:AccessDecisionCode a owl:Class ;
    rdfs:label "access Decision code"@en ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( cd:accessDecision_Deny cd:accessDecision_Permit ) ] .

cd:ApprovalDecisionCode a owl:Class ;
    rdfs:label "approval Decision code"@en ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( cd:approvalDecision_Approved cd:approvalDecision_Rejected ) ] .

cd:BillingCycleCode a owl:Class ;
    rdfs:label "billing Cycle code"@en ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Class ;
