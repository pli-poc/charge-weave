PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?this WHERE { ?this rdf:type/rdfs:subClassOf* cd:ControlDecision . ?this cd:overrideAuthorization ?o; cd:chargingUnit ?u; cd:interval ?i. ?i cd:startsAt ?s; cd:endsAt ?e. FILTER NOT EXISTS {?o cd:authorizedScope ?u; cd:validFrom ?a; cd:validUntil ?b. FILTER(?s>=?a && ?e<=?b)} }
