PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?this WHERE { ?this rdf:type/rdfs:subClassOf* cd:AccountClosure . ?this cd:closureState cd:closureState_Completed; cd:customer ?account; cd:requestedAt ?requested; cd:completedAt ?completed. FILTER(?completed<?requested || !EXISTS {?account cd:accountState cd:accountState_Closed} || EXISTS {?grant a cd:AccessGrant; cd:scopeRecord ?account; cd:grantState cd:grantState_Active}) }
