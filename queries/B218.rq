PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?this WHERE { ?this rdf:type/rdfs:subClassOf* cd:SettlementApproval . ?this cd:approvalState cd:approvalState_Approved; cd:settlementBatch ?batch. ?case a cd:ReconciliationCase; cd:caseState ?state. FILTER(?state!=cd:caseState_Resolved) {?case cd:expectedRecord ?record} UNION {?case cd:observedRecord ?record} FILTER(?record=?batch || EXISTS {?batch cd:settlementItem ?record}) }
