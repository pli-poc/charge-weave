PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?this WHERE { ?this rdf:type/rdfs:subClassOf* cd:BillingReadinessAssessment . ?this cd:readinessState cd:readinessState_Ready; cd:usageComplete ?u; cd:priceResolved ?p; cd:taxResolved ?t; cd:authorizationResolved ?a; cd:responsibilityResolved ?r; cd:openBlockingIssueCount ?n. FILTER(!?u || !?p || !?t || !?a || !?r || ?n!=0 || !EXISTS {?this cd:session/cd:sessionState cd:sessionState_Completed} || !EXISTS {?this cd:readinessEvidence ?e}) }
