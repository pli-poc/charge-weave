PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?this WHERE { ?this rdf:type/rdfs:subClassOf* cd:AnalyticalComparison . ?this cd:comparisonKind ?k. FILTER((?k=cd:comparisonKind_PreviousPeriod && (!EXISTS {?this cd:referenceWindow ?r} || EXISTS {?this cd:targetValue ?v})) || (?k=cd:comparisonKind_Target && (!EXISTS {?this cd:targetValue ?v} || EXISTS {?this cd:referenceWindow ?r})) || (?k=cd:comparisonKind_None && (EXISTS {?this cd:referenceWindow ?r} || EXISTS {?this cd:targetValue ?v}))) }
