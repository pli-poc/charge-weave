PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?this WHERE { ?this rdf:type/rdfs:subClassOf* cd:SettlementLeg . ?this cd:legState cd:legState_Posted; cd:tenant ?tenant; cd:settlementBatch ?batch; cd:legReference ?key. ?other a cd:SettlementLeg; cd:legState cd:legState_Posted; cd:tenant ?tenant; cd:settlementBatch ?batch; cd:legReference ?key. FILTER(?other!=?this) }
