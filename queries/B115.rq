PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?this WHERE { ?this rdf:type/rdfs:subClassOf* cd:AccountClosure . ?this cd:closureState cd:closureState_Completed; cd:activeGrantCount ?g; cd:openLiabilityAmount ?a. FILTER(?g!=0 || !EXISTS {?this cd:completedAt ?t} || !EXISTS {?this cd:closureEvidence ?e} || (?a!=0 && !EXISTS {?this cd:residualLiabilityOwner ?p})) }
