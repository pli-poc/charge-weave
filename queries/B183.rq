PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?this WHERE { ?this rdf:type/rdfs:subClassOf* cd:RatingCalculation . ?this cd:currency ?cur; cd:netAmount ?net; cd:taxAmount ?tax; cd:grossAmount ?gross. {SELECT ?this (SUM(?n) AS ?sn) (SUM(?t) AS ?st) (SUM(?g) AS ?sg) WHERE {?this cd:ratedLine ?line. ?line cd:netAmount ?n; cd:taxAmount ?t; cd:grossAmount ?g} GROUP BY ?this} FILTER(?net!=?sn || ?tax!=?st || ?gross!=?sg || EXISTS {?this cd:ratedLine/cd:currency ?other. FILTER(?other!=?cur)}) }
