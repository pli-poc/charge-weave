PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?this WHERE { ?this rdf:type/rdfs:subClassOf* cd:TemporalCommit . {?this cd:previousCommit ?p; cd:recordedAt ?now; cd:commitSequence ?n; cd:tenant ?tenant; cd:snapshotScope ?scope. FILTER NOT EXISTS {?p cd:tenant ?tenant; cd:snapshotScope ?scope; cd:recordedAt ?before; cd:commitSequence ?old. FILTER(?now>?before && ?n=?old+1)}} UNION {?this cd:previousCommit+ ?this} UNION {?this cd:previousCommit ?p. ?other a cd:TemporalCommit; cd:previousCommit ?p. FILTER(?other!=?this)} UNION {?this cd:commitSequence ?n. FILTER NOT EXISTS {?this cd:previousCommit ?p} FILTER(?n!=1)} UNION {?this cd:tenant ?t; cd:snapshotScope ?scope. ?other a cd:TemporalCommit; cd:tenant ?t; cd:snapshotScope ?scope. FILTER(?other!=?this) FILTER NOT EXISTS {?this cd:previousCommit ?p} FILTER NOT EXISTS {?other cd:previousCommit ?q}} UNION {?this cd:tenant ?t; cd:snapshotScope ?scope; cd:recordedAt ?time. ?other a cd:TemporalCommit; cd:tenant ?t; cd:snapshotScope ?scope; cd:recordedAt ?time. FILTER(?other!=?this)} }
