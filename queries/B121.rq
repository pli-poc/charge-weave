PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?this WHERE { ?this rdf:type/rdfs:subClassOf* cd:CommercialOffer . {?this cd:currency ?a; cd:selectedTariff/cd:currency ?b. FILTER(?a!=?b)} UNION {?this cd:currency ?a; cd:priceDisplay/cd:displayCurrency ?b. FILTER(?a!=?b)} UNION {?this cd:issuedAt ?a; cd:expiresAt ?b. FILTER(?b<=?a)} }
