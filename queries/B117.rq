PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?this WHERE { ?this rdf:type/rdfs:subClassOf* cd:OperationalAcceptance . ?this cd:acceptanceState cd:acceptanceState_Accepted; cd:safetyAccepted ?s; cd:protocolAccepted ?p; cd:meteringAccepted ?m. FILTER(!?s || !?p || !?m || !EXISTS {?this cd:acceptedAt ?t} || !EXISTS {?this cd:acceptanceEvidence ?e}) }
