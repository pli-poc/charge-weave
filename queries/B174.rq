PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?this WHERE { ?this rdf:type/rdfs:subClassOf* cd:TariffSet . ?this (cd:defaultTariff|cd:tariffAssignment/cd:assignedTariff) ?x,?y. ?x cd:tariff ?t; cd:validFrom ?a. OPTIONAL {?x cd:validUntil ?b} ?y cd:tariff ?t; cd:validFrom ?c. OPTIONAL {?y cd:validUntil ?d} FILTER(?x!=?y && (!BOUND(?b)||?c<?b) && (!BOUND(?d)||?a<?d)) }
