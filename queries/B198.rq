PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?this WHERE { ?this rdf:type/rdfs:subClassOf* cd:EventProcessingOutcome . ?this cd:processingState ?state; cd:sourceEvent/cd:receivedAt ?received. FILTER(?state IN (cd:processingState_Applied,cd:processingState_Duplicate)) FILTER NOT EXISTS {?this cd:processedAt ?processed. FILTER(?processed>=?received)} }
