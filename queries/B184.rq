PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?this WHERE { ?this rdf:type/rdfs:subClassOf* cd:TemporalSnapshotSelection . { ?this cd:selectionState ?state. OPTIONAL {?this cd:selectedCommit ?c} OPTIONAL {?this cd:selectedSlice ?s} FILTER((?state=cd:selectionState_Unavailable && (BOUND(?c)||BOUND(?s))) || (?state!=cd:selectionState_Unavailable && (!BOUND(?c)||!BOUND(?s)))) } UNION { ?this cd:selectedCommit ?c; cd:selectedSlice ?s; cd:selectionState ?state; cd:validAt ?v; cd:knownAt ?k; cd:snapshotScope ?scope; cd:tenant ?tenant. FILTER NOT EXISTS {?c cd:temporalSlice ?s; cd:snapshotScope ?scope; cd:tenant ?tenant; cd:recordedAt ?r. ?s cd:validFrom ?a; cd:sliceState ?ss. OPTIONAL {?s cd:validUntil ?b} FILTER(?r<=?k && ?a<=?v && (!BOUND(?b)||?v<?b) && ((?state=cd:selectionState_Present && ?ss=cd:sliceState_Present)||(?state=cd:selectionState_Retracted && ?ss=cd:sliceState_Retracted))) FILTER NOT EXISTS {?new a cd:TemporalCommit; cd:tenant ?tenant; cd:snapshotScope ?scope; cd:recordedAt ?nr. FILTER(?r<?nr && ?nr<=?k)}} } UNION { ?this cd:selectionState cd:selectionState_Unavailable; cd:validAt ?v; cd:knownAt ?k; cd:snapshotScope ?scope; cd:tenant ?tenant. ?c a cd:TemporalCommit; cd:tenant ?tenant; cd:snapshotScope ?scope; cd:recordedAt ?r; cd:temporalSlice ?s. ?s cd:validFrom ?a. OPTIONAL {?s cd:validUntil ?b} FILTER(?r<=?k && ?a<=?v && (!BOUND(?b)||?v<?b)) FILTER NOT EXISTS {?new a cd:TemporalCommit; cd:tenant ?tenant; cd:snapshotScope ?scope; cd:recordedAt ?nr. FILTER(?r<?nr && ?nr<=?k)} } }
