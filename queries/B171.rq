PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?this WHERE { ?this rdf:type/rdfs:subClassOf* cd:AllowanceBalance . { ?this cd:allowance ?allowance; cd:billingPeriod ?period; cd:consumedValue ?c; cd:reservedValue ?r. {SELECT ?this (SUM(?used) AS ?totalUsed) WHERE {OPTIONAL {?x a cd:AllowanceConsumption; cd:allowanceBalance ?this; cd:consumedValue ?used}} GROUP BY ?this} {SELECT ?this (SUM(?held) AS ?totalHeld) WHERE {OPTIONAL {?x a cd:BenefitReservation; cd:allowanceBalance ?this; cd:reservationState cd:reservationState_Active; cd:reservedValue ?held}} GROUP BY ?this} FILTER(?c!=COALESCE(?totalUsed,0) || ?r!=COALESCE(?totalHeld,0) || EXISTS {?item cd:allowanceBalance ?this; cd:allowance ?other. FILTER(?other!=?allowance)} || EXISTS {?item cd:allowanceBalance ?this; cd:billingPeriod ?other. FILTER(?other!=?period)}) } UNION { ?this cd:customer ?owner. ?item cd:allowanceBalance ?this; cd:session ?session. FILTER NOT EXISTS {?session cd:customer ?owner} FILTER NOT EXISTS {?this cd:allowanceSponsorship ?sponsor. ?session cd:customer ?beneficiary; cd:startedAt ?at. ?sponsor cd:sponsoringCustomer ?owner; cd:beneficiaryCustomer ?beneficiary; cd:scopeRecord ?scope; cd:validFrom ?from; cd:validUntil ?until. FILTER(?at>=?from && ?at<?until && (?scope=?beneficiary || ?scope=?session))} } }
