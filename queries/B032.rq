PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?this WHERE { ?this rdf:type/rdfs:subClassOf* cd:ChargeDetailRecord . ?this cd:recordOrigin cd:recordOrigin_Local; cd:session ?s; cd:importedEnergyKWh ?a; cd:exportedEnergyKWh ?b. FILTER NOT EXISTS {?this cd:correctionOf ?old} ?s cd:importedEnergyKWh ?c; cd:exportedEnergyKWh ?d. FILTER(?a != ?c || ?b != ?d) }
