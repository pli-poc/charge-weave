PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?this WHERE { ?this rdf:type/rdfs:subClassOf* cd:Wallet . ?this cd:openingBalance ?opening; cd:balanceAmount ?balance; cd:balanceFrom ?start; cd:balanceAsOf ?end. {SELECT ?this (SUM(?amount) AS ?total) WHERE {?this cd:balanceFrom ?from; cd:balanceAsOf ?until. OPTIONAL {?entry a cd:WalletEntry; cd:wallet ?this; cd:signedAmount ?amount; cd:recordedAt ?time. FILTER(?time>=?from && ?time<=?until)}} GROUP BY ?this} FILTER(?end<?start || ?balance!=?opening+COALESCE(?total,0)) }
