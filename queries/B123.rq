PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?this WHERE { ?this rdf:type/rdfs:subClassOf* cd:OfferAcceptance . ?this cd:customer ?c; cd:session ?s; cd:commercialOffer/cd:selectedTariff ?t. FILTER NOT EXISTS {?s cd:customer ?c; cd:selectedTariff ?t} }
