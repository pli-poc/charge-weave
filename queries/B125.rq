PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?this WHERE { ?this rdf:type/rdfs:subClassOf* cd:OfflineAuthorizationAssessment . ?this cd:offlineDecision cd:offlineDecision_Allow; cd:credentialRevoked ?r; cd:cacheAgeSeconds ?a; cd:maximumCacheAgeSeconds ?m; cd:unknownCredential ?u; cd:permitUnknownCredential ?p; cd:exposureAmount ?e; cd:maximumExposureAmount ?l. FILTER(?r || ?a>?m || (?u && !?p) || ?e>?l || ?e<0 || ?l<0) }
