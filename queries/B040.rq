PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?this WHERE { ?this rdf:type/rdfs:subClassOf* cd:EnergyMix . {SELECT ?this (SUM(?x) AS ?sum) WHERE {?this cd:sourceShare/cd:shareFraction ?x} GROUP BY ?this} FILTER(ABS(?sum - 1) > 0.000001) }
