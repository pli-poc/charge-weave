PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?this WHERE { ?this rdf:type/rdfs:subClassOf* cd:ServiceLevelBreach . ?this cd:breachState cd:breachState_Closed. FILTER(!EXISTS {?this cd:workOrder/cd:workState cd:workState_Completed} && !EXISTS {?this cd:remedyRecord ?r}) }
