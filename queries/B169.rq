PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?this WHERE { ?this rdf:type/rdfs:subClassOf* cd:CreditNote . ?this cd:currency ?cur; cd:issuer ?issuer; cd:originalInvoice ?i. FILTER(!EXISTS {?i cd:currency ?cur; cd:issuer ?issuer} || EXISTS {?i cd:grossAmount ?limit. {SELECT ?i (SUM(?v) AS ?total) WHERE {?note a cd:CreditNote; cd:originalInvoice ?i; cd:creditAmount ?v} GROUP BY ?i} FILTER(?total>?limit)}) }
