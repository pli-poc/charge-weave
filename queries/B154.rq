PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?this WHERE { ?this rdf:type/rdfs:subClassOf* cd:DataDisposition . { ?this cd:dispositionState cd:dispositionState_Completed. FILTER(!EXISTS {?this cd:completedAt ?t} || !EXISTS {?this cd:dispositionEvidence ?e} || EXISTS {?this cd:legalHold/cd:holdState cd:holdState_Active}) } UNION { ?this cd:dispositionState cd:dispositionState_Completed; cd:subjectAccount ?account. ?hold a cd:LegalHold; cd:heldRecord ?account; cd:holdState cd:holdState_Active. } }
