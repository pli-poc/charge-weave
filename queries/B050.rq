PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?this WHERE { ?this rdf:type/rdfs:subClassOf* cd:Journal . ?this cd:journalState cd:journalState_Posted. {SELECT ?this ?currency (SUM(?amount) AS ?total) WHERE {?this cd:journalLine ?l. ?l cd:signedAmount ?amount; cd:currency ?currency} GROUP BY ?this ?currency} FILTER(?total != 0) }
