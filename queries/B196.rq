PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?this WHERE { ?this rdf:type/rdfs:subClassOf* cd:AssetLifecycleEvent . ?this cd:assetAction ?action; cd:station ?station. FILTER(?action IN (cd:assetAction_Replace,cd:assetAction_Decommission,cd:assetAction_Dispose)) ?session a cd:ChargingSession; cd:chargingUnit/cd:station ?station; cd:sessionState ?state. FILTER(?state NOT IN (cd:sessionState_Completed,cd:sessionState_Failed)) }
