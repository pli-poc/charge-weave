PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?this WHERE { ?this rdf:type/rdfs:subClassOf* cd:PeriodAdjustment . ?this cd:adjustmentState cd:adjustmentState_Posted; cd:originalPeriod ?old; cd:postingPeriod ?new; cd:sourceRecord ?source; cd:correctingRecord ?correction; cd:postedAt ?at; cd:effectiveUsageAt ?usage; cd:commercialResponsibility ?r. FILTER(?old=?new || ?source=?correction || !EXISTS {?this cd:correction ?case. ?case cd:originalRecord ?source; cd:correctingRecord ?correction} || !EXISTS {?old cd:periodState cd:periodState_Closed; cd:closedAt ?closed; cd:period/cd:startsAt ?oldStart; cd:period/cd:endsAt ?oldEnd. ?new cd:periodState ?postingState; cd:period/cd:startsAt ?start; cd:period/cd:endsAt ?end. OPTIONAL {?new cd:closedAt ?newClose} FILTER((?postingState=cd:periodState_Open || (?postingState=cd:periodState_Closed && BOUND(?newClose) && ?at<=?newClose)) && ?usage>=?oldStart && ?usage<?oldEnd && ?at>=?closed && ?at>=?start && ?at<?end)} || !EXISTS {?r cd:validFrom ?rstart; cd:serviceAgreement ?a. OPTIONAL {?r cd:validUntil ?rend} ?a cd:validFrom ?astart. OPTIONAL {?a cd:validUntil ?aend} FILTER(?usage>=?rstart && (!BOUND(?rend)||?usage<?rend) && ?usage>=?astart && (!BOUND(?aend)||?usage<?aend))}) }
