PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?this WHERE { ?this rdf:type/rdfs:subClassOf* cd:FinancialPosition . ?this cd:originalAmount ?o; cd:creditedAmount ?c; cd:collectedAmount ?p; cd:writtenOffAmount ?w; cd:outstandingAmount ?r. FILTER(?o<0 || ?c<0 || ?p<0 || ?w<0 || ?r<0 || ?r!=?o-?c-?p-?w) }
