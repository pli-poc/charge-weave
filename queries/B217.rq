PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?this WHERE { ?this rdf:type/rdfs:subClassOf* cd:BillingPeriod . ?this cd:billingPeriodState cd:billingPeriodState_Billed; cd:currency ?cur. FILTER NOT EXISTS {?this cd:invoice ?invoice. ?invoice cd:currency ?cur; cd:invoiceState ?state. FILTER(?state NOT IN (cd:invoiceState_Draft,cd:invoiceState_Voided))} }
