PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?this WHERE { ?this rdf:type/rdfs:subClassOf* cd:Journal . ?this cd:journalState ?state; cd:postedAt ?at; cd:accountingPeriod ?p. FILTER(?state IN (cd:journalState_Posted,cd:journalState_Reversed)) ?p cd:period/cd:startsAt ?start; cd:period/cd:endsAt ?end. FILTER(?at<?start || ?at>=?end || EXISTS {?p cd:closedAt ?close. FILTER(?at>?close)}) }
