PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?this WHERE { ?this rdf:type/rdfs:subClassOf* cd:MeterDelta . {?this cd:deltaBasis cd:deltaBasis_Measured; cd:resetDetected ?r; cd:deltaValue ?d; cd:startReading ?a; cd:endReading ?b; cd:registerEpoch/cd:multiplier ?m. ?a cd:numericValue ?x; cd:observedAt ?at. ?b cd:numericValue ?y; cd:observedAt ?bt. FILTER(?r || ?m<=0 || ?bt<=?at || ?d<0 || ?d!=(?y-?x)*?m)} UNION {?this cd:deltaBasis cd:deltaBasis_Estimated. FILTER NOT EXISTS {?this cd:deltaEvidence ?e}} }
