PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?this WHERE { ?this rdf:type/rdfs:subClassOf* cd:Invoice . ?this cd:invoiceState cd:invoiceState_Paid; cd:currency ?cur; cd:grossAmount ?gross. FILTER NOT EXISTS {?p a cd:FinancialPosition; cd:sourceRecord ?this; cd:currency ?cur; cd:positionState cd:positionState_Settled; cd:outstandingAmount ?outstanding; cd:originalAmount ?original; cd:collectedAmount ?collected; cd:creditedAmount ?credited; cd:writtenOffAmount ?written. FILTER(?outstanding=0 && ?original=?gross && ?collected+?credited=?gross && ?written=0)} }
