PREFIX cd: <https://example.org/charge-domain#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?this WHERE { ?this rdf:type/rdfs:subClassOf* cd:ChargingSession . ?this cd:sessionState ?state; cd:startedAt ?start; cd:authorizationDecision ?decision. FILTER(?state IN (cd:sessionState_Active,cd:sessionState_Suspended,cd:sessionState_Completed)) ?decision cd:decidedAt ?at. OPTIONAL {?decision cd:expiresAt ?expires} FILTER(?at>?start || (BOUND(?expires)&&?start>=?expires)) }
